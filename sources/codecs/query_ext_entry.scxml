<!-- The extension entry of a Query's chain: `ext_entry` with one change, that
     its ZBuf arm is the body that depends on the extension before it.

     A Query carries its value in a ZBuf extension (id 3) that upstream reads
     differently when a shared-memory marker (unit, id 4) came just before it
     (`query_value_zbuf.scxml`). Nothing inside one entry can know that, so the
     entry takes one flag-input, `after_shm`, and hands it to the ZBuf arm; the
     chain that reads the entries fills it, entry by entry
     (`query.scxml`, `<sce:entry-flag-bind>`).

     Only the Query's chain uses this entry. The generic `ext_entry` is the
     element of every other chain in the tree (Put, Push, Reply, Request,
     Declare and the rest) and stays as it is: the marker changes how a ZBuf is
     read only where upstream's `ValueType` is the extension, and the other ZBuf
     extensions, the attachment and the source info among them, are plain
     whatever precedes them. A flag-input on the generic entry would have to be
     bound by every one of those chains to a value that is always 0.

     The header packs the same four named bit-ranges as `ext_entry` (ext_id
     0..3, M 4, enc 5..6, Z 7), and the unit and z64 arms are the same codecs. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="query_ext_entry">
  <sce:import src="ext_unit.scxml" kind="codec" as="codec_zenoh_ext_unit"/>
  <sce:import src="ext_zint.scxml" kind="codec" as="codec_zenoh_ext_zint"/>
  <sce:import src="query_value_zbuf.scxml" kind="codec" as="codec_zenoh_query_value_zbuf">
    <sce:flag-bind input="after_shm" source="after_shm"/>
  </sce:import>
  <sce:flag-inputs>
    <sce:flag-input name="after_shm" width="1"/>
  </sce:flag-inputs>
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="ext_id" bit="0" width="4"/>
      <sce:flag name="M"      bit="4"/>
      <sce:flag name="enc"    bit="5" width="2"/>
      <sce:flag name="Z"      bit="7"/>
    </sce:flags>
    <sce:variant tag="header.enc">
      <sce:arm value="0x00" type="codec_zenoh_ext_unit" default="true"/>
      <sce:arm value="0x01" type="codec_zenoh_ext_zint"/>
      <sce:arm value="0x02" type="codec_zenoh_query_value_zbuf"/>
      <sce:default type="codec_zenoh_ext_unit"/>
    </sce:variant>
  </datamodel>
</scxml>
