<!-- The whole transport KeepAlive message: the header byte and the
     extension chain. The body is empty (`keep_alive.scxml`), so nothing is
     embedded.

     Upstream writes the header alone
     (`commons/zenoh-codec/src/transport/keepalive.rs` @
     `impl<W> WCodec<&KeepAlive, &mut W> for Zenoh080`) and reads a chain
     after it when Z is set, with the flags of
     `commons/zenoh-protocol/src/transport/keepalive.rs` @ `pub mod flag {`:

       bit 0..4 : mid  0x04
       bit 5, 6 : reserved
       bit 7    : Z    an extension chain follows

     The chain is the generic transport chain; see `transport_init.scxml`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="transport_keep_alive">
  <sce:import src="ext_entry.scxml" kind="codec" as="codec_zenoh_ext_entry"/>
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="mid" bit="0" width="5" value="0x04"/>
      <sce:flag name="Z"   bit="7"/>
    </sce:flags>
    <sce:tlv-chain id="extensions" type="codec_zenoh_ext_entry" sce:byte="1"
                   sce:present-if="header.Z"
                   terminate-on="entry-flag" entry-flag-name="Z"/>
  </datamodel>
</scxml>
