<!-- SCE Forge conformance: Zenoh linkstate-peer routing — a single
     LinkState entry (one node's view of the peer topology graph).

     P4 routing track, linkstate port step (b): the wire codec for the
     topology-exchange message that linkstate-peer routing floods so
     every peer learns the full mesh graph (the input to the
     spanning-tree / shortest-path forwarding computed in step (c)/(d)).

     Mirrors zenoh `zenoh/src/net/protocol/linkstate.rs:43..52` (the
     `LinkState` struct) + `zenoh/src/net/codec/linkstate.rs:33..143`
     (the `Zenoh080Routing` WCodec/RCodec). zenoh options byte bits
     (LSB first), then the field order:

         7 6 5 4 3 2 1 0
        +-+-+-+-+-+-+-+-+
         X X X X H L W P
        +-+-+-+-+-+-+-+-+

         options   flag byte (VLE u64; only bits 0..3 ever set)
         psid      VLE u64                              (always)
         sn        VLE u64                              (always)
         zid       if P : VLE zid_len + zid_len bytes
         whatami   if W : u8
         locators  if L : VLE count + count locators
         links     VLE count + count VLE u64            (always)
         weights   if H : count u16, no own length      (DEFERRED below)

     Field-by-field vs net/codec/linkstate.rs:39..79:
       options (line 55)  : zenoh writes the flag word as a VLE u64.
                            Only PID|WAI|LOC|WGT = 0x0F is ever set, and a
                            VLE u64 in 0..=0x7F is a single byte equal to
                            its value, so an 8-bit `<sce:flags>` byte is
                            byte-identical for every representable
                            LinkState (same VLE-u64 superset rationale as
                            oam.scxml's zint16-subset note). Bit values
                            are linkstate.rs:20..23: P=PID=0x01 (zid),
                            W=WAI=0x02 (whatami), L=LOC=0x04 (locators),
                            H=WGT=0x08 (link_weights).
       psid / sn (58, 59) : VLE u64, always present.
       zid (60..62)       : `codec.write(zid)` resolves to the STANDALONE
                            `WCodec<&ZenohIdProto>` (commons/zenoh-codec/
                            src/core/zenohid.rs:36) = a self-describing
                            VLE length prefix (`zid_len`, the byte count,
                            1..=16) followed by that many raw zid bytes.
                            DISTINCT from the join/hello/init body shape
                            where the zid length is packed into a `cbyte`
                            nibble (`zid_len_m1`); here the length is its
                            own VLE field, like locator_len / cookie_len.
       whatami (63..66)   : standalone u8 (`wai.into()`), NOT the 2-bit
                            cbyte packing used by hello/join/init. Host
                            maps the byte to WhatAmI (1=router / 2=peer /
                            4=client); the codec carries the raw byte.
       locators (67..69)  : `codec.write(locators.as_slice())` resolves to
                            `WCodec<&[Locator]>` (core/locator.rs:57..65) =
                            VLE count + count * locator (each locator =
                            VLE length + UTF-8 bytes, per locator.scxml).
       links (70..73)     : VLE count + count * VLE u64 (no wrapper). The
                            per-element codec is linkstate_link.scxml.

       weights (74..79) : `if H: count * VLE u16`, NO own length prefix —
                            the element count is BORROWED from
                            `links.len()` (codec comment "do not write len
                            since it is the same as that of links"). Each
                            weight is VLE, not a fixed 2-byte int
                            (`codec.write(&u16)` -> `write(x as u64)`,
                            zint.rs:212/181); element codec =
                            linkstate_weight.scxml. Modelled as an H-gated
                            `<sce:repeat>` whose `count="links_len"` (the
                            always-present links count). SCE accepts a
                            gated repeat with an unconditional borrowed
                            count as of vendor pin f91a37eba (the
                            wz-reported borrowed-count primitive — the
                            co-gating safety condition "count is read
                            before the gated repeat" holds because
                            links_len is unconditional). Weights are opt-in
                            `TransportWeight` config; a default-config peer
                            clears H and omits the block (LinkEdgeWeight
                            default 100).

     Field `sce:byte` numbers are monotonic field-order indices (each
     VLE / u8 / bytes / repeat = one slot), matching the hello/init_body
     convention, not literal wire offsets (the leading fields are
     variable-width).

     Composition: B5-alpha multi-bit flag word (options) + B1-alpha VLE
     (psid / sn / zid_len / num_locators / links count) + B2-beta
     present-if + length-ref (zid) + B5-gamma local-flag present-if
     (whatami / locators) + B5-mu repeat<codec> with co-gated count
     (locators) + ungated repeat<codec> (links) + H-gated repeat<codec>
     with a borrowed unconditional count (weights, vendor pin f91a37eba).
     No new primitive surface. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="linkstate">
  <sce:import src="linkstate_link.scxml" kind="codec" as="codec_zenoh_linkstate_link"/>
  <sce:import src="linkstate_weight.scxml" kind="codec" as="codec_zenoh_linkstate_weight"/>
  <sce:import src="locator.scxml" kind="codec" as="codec_zenoh_locator"/>
  <datamodel>
    <sce:flags id="options" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="P" bit="0"/>
      <sce:flag name="W" bit="1"/>
      <sce:flag name="L" bit="2"/>
      <sce:flag name="H" bit="3"/>
    </sce:flags>
    <sce:field id="psid" sce:type="uint64" sce:byte="1" sce:bit-size="vle"/>
    <sce:field id="sn"   sce:type="uint64" sce:byte="2" sce:bit-size="vle"/>
    <sce:field id="zid_len" sce:type="uint64" sce:byte="3" sce:bit-size="vle"
               sce:present-if="options.P"/>
    <sce:field id="zid" sce:type="bytes" sce:byte="4" sce:bit-size="length-ref"
               sce:length-field="zid_len" sce:max-size="16"
               sce:present-if="options.P"/>
    <sce:field id="whatami" sce:type="uint8" sce:byte="5" sce:bit-size="8"
               sce:present-if="options.W"/>
    <sce:field id="num_locators" sce:type="uint64" sce:byte="6" sce:bit-size="vle"
               sce:present-if="options.L"/>
    <sce:repeat id="locators" type="codec_zenoh_locator" sce:byte="7"
                count="num_locators" max-count="64"
                sce:present-if="options.L"/>
    <sce:field id="links_len" sce:type="uint64" sce:byte="8" sce:bit-size="vle"/>
    <sce:repeat id="links" type="codec_zenoh_linkstate_link" sce:byte="9"
                count="links_len" max-count="64"/>
    <sce:repeat id="weights" type="codec_zenoh_linkstate_weight" sce:byte="10"
                count="links_len" max-count="64"
                sce:present-if="options.H"/>
  </datamodel>
</scxml>
