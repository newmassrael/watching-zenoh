<!-- SCE Forge conformance: zenoh-pico SERIAL-link COBS decode.

     The inverse of cobs_encode: a runtime, data-dependent bytes ->
     bytes transform that destuffs a COBS frame back to the original
     bytes (which may contain 0x00). Uses SCE's byte-buffer-build
     primitives (bounded output, forward-only append, fallible bytes
     return); requires SCE 9c0356a41.

     Mirrors zenoh-pico _z_cobs_decode
     (vendor/zenoh-pico/src/utils/encoding.c:49-76), INCLUDING its
     bounds: pico's loop condition `byte < input_end_ptr` is tested
     before EVERY byte it reads (the code byte and each data byte
     alike), so a group whose code byte promises more bytes than the
     input holds simply ends decoding at the end of the input and
     yields the output produced so far. It never reads past the input.
     This decoder reproduces that: the inner copy loop is bounded by
     `i < n` as well as by the group length, so the function is total
     over every input (any length, any bytes) and cannot index past
     `data`; the only error is the output-capacity one below, and
     only on the fixed-capacity (no-alloc) SceBytes profile; the
     alloc profile grows its buffer and never fails.
     Input may or may
     not include the trailing 0x00 EOP delimiter: a 0x00 code byte
     terminates decoding (serial.c reads up to the EOP and pico's
     decoder breaks on a 0x00 code), and end-of-input terminates it
     otherwise; both yield identical output.

     Append-only formulation (pico decrements its write pointer to
     drop a just-emitted implicit zero when it discovers the EOP;
     SCE byte-buffer-build is forward-only with no index writes, so
     instead the implicit zero is emitted lazily — only AFTER the next
     group's code byte is read and confirmed non-zero — which never
     emits a spurious trailing zero):

       prev = 0xFF                 # sentinel: no previous group
       i = 0
       while i < n and not done:
         code = data[i]; i += 1
         if code == 0: done = true            # EOP: stop, emit nothing
         else:
           if prev != 0xFF: append 0          # zero terminating the
                                              # previous group
           copy (code - 1) bytes verbatim
           prev = code

     `prev == 0xFF` suppresses the implicit zero in two cases that
     coincide correctly: the very first group (no predecessor) and a
     full 254-byte group (code 0xFF carries no implicit trailing zero).

     Truncated groups (the code byte promises more than is left):
     the available bytes are copied and decoding ends, as in pico.
     Before the inner loop was bounded it indexed `data[i]` with no
     check against `n` and panicked (index out of bounds) on any
     such input, e.g. line noise on a serial link.

     One deliberate difference from pico, on input that is not COBS:
     a 0x00 CODE byte that follows a full 0xFF group. pico's
     `pos = pos - 1` on a 0x00 code removes the byte it believes is
     the implicit zero it just wrote, but after a 0xFF group it wrote
     none, so it drops a real data byte (and on a 0x00 FIRST byte it
     moves before the output start and returns SIZE_MAX). This
     decoder emits nothing for a 0x00 code, as its append-only
     formulation implies. A valid encoder never produces either shape
     (cobs_encode ends a 0xFF group with a 0x01 group, encoding.c:
     33-44), and in both cases the frame is rejected by its length /
     CRC check downstream, in pico and in wz alike.

     Index width: `n` and `i` are uint32 so that `len(data)` is never
     truncated; a uint16 `n` silently clipped an input of 65536 or
     more bytes to its length modulo 65536.

     Output bound: the destuffed frame is at most pico
     _Z_SERIAL_MFS_SIZE = 1507 (serial_protocol.h:32).

     Reference vectors (inverse of cobs_encode; verified round-trip):
       01            -> (empty)
       01 01         -> 00
       03 11 22 02 33 -> 11 22 00 33
       02 11 01 01   -> 11 00 00
       04 11 22 33   -> 11 22 33
     Truncated groups (pico parity, differential-tested):
       03 11         -> 11          (promised 2, 1 left)
       05            -> (empty)     (promised 4, none left)
       02 11 03      -> 11 00       (the zero closing the first group
                                     is emitted once the next code is
                                     read; the second group is empty)
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm" name="cobs_decode"
       version="1.0">
  <sce:signature>
    <sce:param name="data" type="bytes"/>
    <sce:return type="bytes" returns-max-size="1507"/>
  </sce:signature>
  <sce:body>
    <sce:var name="n" type="uint32" init="len(data)"/>
    <sce:var name="out" type="bytes" capacity="1507"/>
    <sce:var name="i" type="uint32" init="0"/>
    <sce:var name="prev" type="uint16" init="255"/>
    <sce:var name="done" type="bool" init="false"/>
    <sce:while cond="(i &lt; n) &amp;&amp; (done === false)">
      <sce:var name="code" type="uint16" init="data[i]"/>
      <sce:assign target="i" expr="i + 1"/>
      <sce:if cond="code === 0">
        <sce:assign target="done" expr="true"/>
        <sce:else>
          <sce:if cond="prev !== 255">
            <sce:var name="z" type="uint8" init="0"/>
            <sce:append target="out" expr="z"/>
          </sce:if>
          <sce:var name="j" type="uint16" init="1"/>
          <!-- Bounded by the input as well as by the group length: pico
               tests `byte < input_end_ptr` before every byte. -->
          <sce:while cond="(j &lt; code) &amp;&amp; (i &lt; n)">
            <sce:append target="out" expr="data[i]"/>
            <sce:assign target="i" expr="i + 1"/>
            <sce:assign target="j" expr="j + 1"/>
          </sce:while>
          <sce:assign target="prev" expr="code"/>
        </sce:else>
      </sce:if>
    </sce:while>
    <sce:return expr="out"/>
  </sce:body>
</scxml>
