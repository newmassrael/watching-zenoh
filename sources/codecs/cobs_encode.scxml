<!-- SCE Forge conformance: zenoh-pico SERIAL-link COBS encode.

     Consistent Overhead Byte Stuffing: a runtime, data-dependent
     bytes -> bytes transform that removes all 0x00 bytes from the
     serial frame so a single 0x00 can delimit frames on the wire. The
     output length and contents depend on where the input zero bytes
     fall, so it is not a fixed-shape codec; it uses SCE's byte-buffer-
     build primitives (bounded `<sce:var type="bytes" capacity>`,
     forward-only `<sce:append>`, fallible `bytes` return). Requires
     SCE 9c0356a41 ("Add byte-buffer-build to the algorithm kind").

     Mirrors zenoh-pico _z_cobs_encode
     (vendor/zenoh-pico/src/utils/encoding.c:19-47) byte-for-byte. The
     caller (serial link driver) appends the 0x00 EOP after this output
     (serial.c:65 dest[ret] = 0x00); EOP is a 1-byte framing concern,
     not part of COBS proper, so it is not emitted here.

     Algorithm (two forward scan pointers; single append-only output):
       - A group is a maximal run of up to 254 non-zero bytes,
         terminated by a zero byte, the 254-byte limit, or end-of-input.
       - Each group emits one code byte (run_length + 1) then the
         group's bytes. Code 0xFF (254 + 1) marks a full 254-byte group
         with no implicit trailing zero; the next group continues
         without consuming a byte.
       - A zero byte that terminates a group is implicit (consumed, not
         emitted). A trailing zero at end-of-input emits a final 0x01.

     Output bound: pico _Z_SERIAL_MAX_COBS_BUF_SIZE = 1516
     (serial_protocol.h:33-34) covers the worst-case stuffing of a
     1507-byte frame (_Z_SERIAL_MFS_SIZE) plus overhead.

     Reference vectors (canonical COBS; verified byte-equal to pico
     _z_cobs_encode and to SCE's algorithm_cobs_encode exemplar):
       []            -> 01
       00            -> 01 01
       11 22 00 33   -> 03 11 22 02 33
       11 00 00      -> 02 11 01 01
       11 22 33      -> 04 11 22 33
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm" name="cobs_encode"
       version="1.0">
  <sce:signature>
    <sce:param name="data" type="bytes"/>
    <sce:return type="bytes" returns-max-size="1516"/>
  </sce:signature>
  <sce:body>
    <sce:var name="n" type="uint16" init="len(data)"/>
    <sce:var name="out" type="bytes" capacity="1516"/>
    <sce:var name="p" type="uint16" init="0"/>
    <sce:var name="done" type="bool" init="false"/>
    <sce:while cond="done === false">
      <!-- Scan a group: q advances over up to 254 non-zero bytes from p. -->
      <sce:var name="q" type="uint16" init="p"/>
      <sce:while cond="(q &lt; n) &amp;&amp; ((q - p) &lt; 254) &amp;&amp; (data[q] !== 0)">
        <sce:assign target="q" expr="q + 1"/>
      </sce:while>
      <!-- Emit the code byte then the group's bytes. -->
      <sce:var name="run" type="uint16" init="q - p"/>
      <sce:var name="code" type="uint8" init="run + 1"/>
      <sce:append target="out" expr="code"/>
      <sce:var name="k" type="uint16" init="p"/>
      <sce:while cond="k &lt; q">
        <sce:append target="out" expr="data[k]"/>
        <sce:assign target="k" expr="k + 1"/>
      </sce:while>
      <!-- Advance past the group; consume a terminating zero; handle the
           254-overflow and trailing-zero edges. -->
      <sce:if cond="q &gt;= n">
        <sce:assign target="done" expr="true"/>
        <sce:else>
          <sce:if cond="run &lt; 254">
            <sce:assign target="p" expr="q + 1"/>
            <sce:if cond="p &gt;= n">
              <sce:var name="last" type="uint8" init="1"/>
              <sce:append target="out" expr="last"/>
              <sce:assign target="done" expr="true"/>
            </sce:if>
            <sce:else>
              <sce:assign target="p" expr="q"/>
            </sce:else>
          </sce:if>
        </sce:else>
      </sce:if>
    </sce:while>
    <sce:return expr="out"/>
  </sce:body>
</scxml>
