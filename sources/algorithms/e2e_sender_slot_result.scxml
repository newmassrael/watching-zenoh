<!--
  What e2e_sender_slot.scxml answers: slotted carries the slot the frame is judged in; not_listed,
  full and no_claim carry nothing.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="union"
       name="e2e_sender_slot_result">
  <sce:import kind="enum" src="e2e_sender_slot_kind.scxml" as="SlotKind"/>
  <sce:import kind="event-schema" src="e2e_sender_slot_held.scxml" as="Held"/>
  <datamodel>
    <data id="kind" sce:type="enum:SlotKind">
      <sce:case variant="slotted" record="Held"/>
      <sce:case variant="not_listed"/>
      <sce:case variant="full"/>
      <sce:case variant="no_claim"/>
    </data>
  </datamodel>
</scxml>
