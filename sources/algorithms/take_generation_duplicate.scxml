<!--
  The case of take_generation_result.scxml for a generation the table already held, or one older
  than it: the last generation the table holds for the peer. A record, as reset_peer_schema.scxml
  is.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="take_generation_duplicate"
       sce:event-name="reset.duplicate">
  <datamodel>
    <data id="last" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
