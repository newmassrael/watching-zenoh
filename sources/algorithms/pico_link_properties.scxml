<!--
  What zenoh-pico's link of a kind reports about itself (wz-capi-pico `link_properties`): its MTU,
  whether it is a stream and whether it is reliable, as the connectivity plane (`z_link_mtu`,
  `z_link_is_streamed`, `z_link_is_reliable`) and the admin space's link document answer.

  pico fixes all three per link TYPE, not per negotiated batch: its five links' MTU functions
  (`_z_get_link_mtu_tcp` and its siblings) and the flow and reliability of the link's
  capabilities beside them. `kind` names the pico link the host's link stands for:

    0  the driver cannot name the link's kind: pico's zeros, what it answers for a transport with
       no link object at all;
    1  tcp, and 2 tls over it: a reliable stream of 65535;
    3  udp: an unreliable datagram link of 1450;
    4  ws: a datagram link of 65535 that is RELIABLE, the one link where the two flags differ;
    5  serial: an unreliable datagram link of pico's serial MTU, 1500;
    any other number: a kind pico has no link for, which keeps what the host's registry reports
       of it (`reported_mtu`, `streamed`, `reliable`).

  The registry's three values are read only for a kind pico has no link for. The lookup cannot
  fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       name="pico_link_properties"
       version="1.0">
  <sce:import kind="event-schema" src="pico_link_reported.scxml" as="Reported"/>
  <sce:signature>
    <sce:param name="kind" type="uint8"/>
    <sce:param name="reported_mtu" type="uint16"/>
    <sce:param name="streamed" type="bool"/>
    <sce:param name="reliable" type="bool"/>
    <sce:return type="record:Reported"/>
  </sce:signature>
  <sce:body>
    <sce:if cond="kind === 0">
      <sce:var name="none" type="record:Reported">
        <sce:set name="mtu" expr="0"/>
        <sce:set name="streamed" expr="false"/>
        <sce:set name="reliable" expr="false"/>
      </sce:var>
      <sce:return expr="none"/>
    </sce:if>
    <sce:if cond="kind === 1 || kind === 2">
      <sce:var name="tcp" type="record:Reported">
        <sce:set name="mtu" expr="65535"/>
        <sce:set name="streamed" expr="true"/>
        <sce:set name="reliable" expr="true"/>
      </sce:var>
      <sce:return expr="tcp"/>
    </sce:if>
    <sce:if cond="kind === 3">
      <sce:var name="udp" type="record:Reported">
        <sce:set name="mtu" expr="1450"/>
        <sce:set name="streamed" expr="false"/>
        <sce:set name="reliable" expr="false"/>
      </sce:var>
      <sce:return expr="udp"/>
    </sce:if>
    <sce:if cond="kind === 4">
      <sce:var name="ws" type="record:Reported">
        <sce:set name="mtu" expr="65535"/>
        <sce:set name="streamed" expr="false"/>
        <sce:set name="reliable" expr="true"/>
      </sce:var>
      <sce:return expr="ws"/>
    </sce:if>
    <sce:if cond="kind === 5">
      <sce:var name="serial" type="record:Reported">
        <sce:set name="mtu" expr="1500"/>
        <sce:set name="streamed" expr="false"/>
        <sce:set name="reliable" expr="false"/>
      </sce:var>
      <sce:return expr="serial"/>
    </sce:if>
    <sce:var name="registry" type="record:Reported">
      <sce:set name="mtu" expr="reported_mtu"/>
      <sce:set name="streamed" expr="streamed"/>
      <sce:set name="reliable" expr="reliable"/>
    </sce:var>
    <sce:return expr="registry"/>
  </sce:body>
</scxml>
