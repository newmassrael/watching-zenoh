<!--
  Whether a node of a role timestamps the data messages that do not already carry a timestamp:
  zenoh's `timestamping/enabled` map resolved against the node's own role
  (`config.timestamping().enabled().get(whatami)`), the map given as its three entries.

  `role` is the role's API byte, as zenoh and zenoh-pico number it (wz-codecs `WhatAmI::to_api`):
  1 router, 2 peer, 4 client. A number that names no role stamps nothing, so a value outside the
  three can never turn a clock on. The predicate cannot fail.

  The map itself, its default (only a router stamps) and the replacement of one role's entry stay
  in wz-node-time `node_clock` as constant constructors: a const context evaluates them where a
  generated function would run at run time.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       name="timestamping_enabled_for"
       version="1.0">
  <sce:signature>
    <sce:param name="role" type="uint8"/>
    <sce:param name="router" type="bool"/>
    <sce:param name="peer" type="bool"/>
    <sce:param name="client" type="bool"/>
    <sce:return type="bool"/>
  </sce:signature>
  <sce:body>
    <sce:if cond="role === 1">
      <sce:return expr="router"/>
    </sce:if>
    <sce:if cond="role === 2">
      <sce:return expr="peer"/>
    </sce:if>
    <sce:if cond="role === 4">
      <sce:return expr="client"/>
    </sce:if>
    <sce:return expr="false"/>
  </sce:body>
</scxml>
