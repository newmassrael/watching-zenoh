<!--
  Whether the chunk k[s..e] holds the `$*` token (`$` then `*`). Offsets
  outside the text hold nothing.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       name="keyexpr_has_dsl"
       version="1.0">
  <sce:signature>
    <sce:param name="k" type="bytes"/>
    <sce:param name="s" type="uint32"/>
    <sce:param name="e" type="uint32"/>
    <sce:return type="bool"/>
  </sce:signature>
  <sce:body>
    <sce:if cond="e &gt; len(k)">
      <sce:return expr="false"/>
    </sce:if>
    <sce:var name="i" type="uint32" init="s"/>
    <sce:while cond="i &lt; e">
      <sce:if cond="k[i] === 36">
        <sce:var name="i1" type="uint32" init="i + 1"/>
        <sce:if cond="i1 &lt; e">
          <sce:if cond="k[i1] === 42">
            <sce:return expr="true"/>
          </sce:if>
        </sce:if>
      </sce:if>
      <sce:assign target="i" expr="i + 1"/>
    </sce:while>
    <sce:return expr="false"/>
  </sce:body>
</scxml>
