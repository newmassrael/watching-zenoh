<!--
  Where e2e_sender_slot.scxml judges a frame of a sender: in a slot, the one the sender holds or
  the one it takes; in none, because the bound list does not name the sender, or because every
  slot is held by another; or in none and not counted, because the frame is not intact and its
  sender holds no slot. The tag of e2e_sender_slot_result.scxml.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="enum"
       name="e2e_sender_slot_kind"
       sce:underlying-type="uint8">
  <datamodel>
    <data id="variants">
      <sce:variant name="slotted" value="0"/>
      <sce:variant name="not_listed" value="1"/>
      <sce:variant name="full" value="2"/>
      <sce:variant name="no_claim" value="3"/>
    </data>
  </datamodel>
</scxml>
