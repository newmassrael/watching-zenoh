<!--
  The case of e2e_sender_slot_result.scxml for a frame judged in a slot: the slot, numbered from 0
  in the order the senders were bound or first arrived. No machine sends it as an event; the
  event-schema kind is how SCE declares a record (SCE_FORGE.md, "Records").
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="e2e_sender_slot_held"
       sce:event-name="e2e.sender_slot">
  <datamodel>
    <data id="slot" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
