<!--
  What zenoh-pico's link of a kind reports about itself: its MTU, whether it is a stream, and
  whether it is reliable. The record pico_link_properties.scxml returns. No machine sends it as
  an event; the event-schema kind is how SCE declares a record (SCE_FORGE.md, "Records").
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="pico_link_reported"
       sce:event-name="pico.link_reported">
  <datamodel>
    <data id="mtu" sce:type="uint16" sce:direction="in"/>
    <data id="streamed" sce:type="bool" sce:direction="in"/>
    <data id="reliable" sce:type="bool" sce:direction="in"/>
  </datamodel>
</scxml>
