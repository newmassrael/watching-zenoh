<!--
  Whether the key expression a covers every key b covers: zenoh's `includes`,
  read over the two texts. It is not symmetric.

  * A text with an empty chunk covers and is covered by nothing, and on a build
    whose key buffer is fixed (`bounded`) neither is one of more than
    `chunk_bound` chunks.
  * Without `**` the chunks are covered one for one (keyexpr_chunk_includes).
  * A `**` of b with none in a: no; a chunk that is not `**` does not cover any
    number of chunks.
  * With `**` in a, keyexpr_includes_dp fills the table of their prefixes, its
    bits over b when b has at most 63 chunks and over a otherwise; two texts of
    more than 63 chunks each are refused, the bound of a uint64 row.

  `wild_single`, `wild_double` and `wild_dsl` are the build's wildcard switches
  (`keyexpr-wildcard-single`, `keyexpr-wildcard-double`, `keyexpr-dollar-star`):
  a wildcard whose switch is off is a literal chunk.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       name="keyexpr_includes"
       version="1.0">
  <sce:import kind="algorithm" src="keyexpr_chunk_count.scxml" as="keyexpr_chunk_count"/>
  <sce:import kind="algorithm" src="keyexpr_chunk_end.scxml" as="keyexpr_chunk_end"/>
  <sce:import kind="algorithm" src="keyexpr_has_double.scxml" as="keyexpr_has_double"/>
  <sce:import kind="algorithm" src="keyexpr_chunk_includes.scxml" as="keyexpr_chunk_includes"/>
  <sce:import kind="algorithm" src="keyexpr_includes_dp.scxml" as="keyexpr_includes_dp"/>
  <sce:signature>
    <sce:param name="a" type="bytes"/>
    <sce:param name="b" type="bytes"/>
    <sce:param name="wild_single" type="bool"/>
    <sce:param name="wild_double" type="bool"/>
    <sce:param name="wild_dsl" type="bool"/>
    <sce:param name="bounded" type="bool"/>
    <sce:param name="chunk_bound" type="uint32"/>
    <sce:return type="bool"/>
  </sce:signature>
  <sce:body>
    <sce:var name="na" type="uint32" init="keyexpr_chunk_count(a)"/>
    <sce:var name="nb" type="uint32" init="keyexpr_chunk_count(b)"/>
    <sce:if cond="na === 0 || nb === 0">
      <sce:return expr="false"/>
    </sce:if>
    <sce:if cond="bounded &amp;&amp; (na &gt; chunk_bound || nb &gt; chunk_bound)">
      <sce:return expr="false"/>
    </sce:if>
    <sce:var name="da" type="bool" init="wild_double &amp;&amp; keyexpr_has_double(a)"/>
    <sce:var name="db" type="bool" init="wild_double &amp;&amp; keyexpr_has_double(b)"/>
    <sce:if cond="da">
      <sce:if cond="nb &lt;= 63">
        <sce:return expr="keyexpr_includes_dp(a, b, false, wild_single, wild_dsl)"/>
      </sce:if>
      <sce:if cond="na &lt;= 63">
        <sce:return expr="keyexpr_includes_dp(a, b, true, wild_single, wild_dsl)"/>
      </sce:if>
      <sce:return expr="false"/>
    </sce:if>
    <sce:if cond="db">
      <sce:return expr="false"/>
    </sce:if>
    <!-- No `**`: the chunks are covered one for one. -->
    <sce:if cond="na !== nb">
      <sce:return expr="false"/>
    </sce:if>
    <sce:var name="an" type="uint32" init="len(a)"/>
    <sce:var name="bn" type="uint32" init="len(b)"/>
    <sce:var name="as_" type="uint32" init="0"/>
    <sce:var name="bs_" type="uint32" init="0"/>
    <sce:var name="more" type="bool" init="true"/>
    <sce:while cond="more">
      <sce:var name="ae_" type="uint32" init="keyexpr_chunk_end(a, as_)"/>
      <sce:var name="be_" type="uint32" init="keyexpr_chunk_end(b, bs_)"/>
      <sce:if cond="!keyexpr_chunk_includes(a, as_, ae_, b, bs_, be_, wild_single, wild_dsl)">
        <sce:return expr="false"/>
      </sce:if>
      <sce:if cond="ae_ &lt; an &amp;&amp; be_ &lt; bn">
        <sce:assign target="as_" expr="ae_ + 1"/>
        <sce:assign target="bs_" expr="be_ + 1"/>
        <sce:else>
          <sce:assign target="more" expr="false"/>
        </sce:else>
      </sce:if>
    </sce:while>
    <sce:return expr="true"/>
  </sce:body>
</scxml>
