<!--
  Whether the key expression a covers every key b covers: zenoh's `includes`,
  read over the two texts. It is not symmetric.

  * A text with an empty chunk covers and is covered by nothing, and on a build
    whose key buffer is fixed (`bounded`) neither is one of more than
    `chunk_bound` chunks.
  * A `**` of b with none in a: no; a chunk that is not `**` does not cover any
    number of chunks.
  * With `**` in a alone, or nowhere, keyexpr_walk walks b's chunks from a
    (relation 2, keyexpr_chunk_includes at each step).
  * With `**` on both sides, keyexpr_relation_dp fills the table of their
    prefixes, its bits over b when b has at most 63 chunks and over a
    otherwise; two such texts of more than 63 chunks each are refused, the
    bound of a uint64 row. Only a's `**` stretches there, so the side a is
    on (rows or bits) is the one whose `**` the table lets stretch.

  `wild_single`, `wild_double` and `wild_dsl` are the build's wildcard switches
  (`keyexpr-wildcard-single`, `keyexpr-wildcard-double`, `keyexpr-dollar-star`):
  a wildcard whose switch is off is a literal chunk.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       name="keyexpr_includes"
       version="1.0">
  <sce:import kind="algorithm" src="keyexpr_shape.scxml" as="keyexpr_shape"/>
  <sce:import kind="event-schema" src="keyexpr_shape_schema.scxml" as="Shape"/>
  <sce:import kind="algorithm" src="keyexpr_walk.scxml" as="keyexpr_walk"/>
  <sce:import kind="algorithm" src="keyexpr_relation_dp.scxml" as="keyexpr_relation_dp"/>
  <sce:signature>
    <sce:param name="a" type="bytes"/>
    <sce:param name="b" type="bytes"/>
    <sce:param name="wild_single" type="bool"/>
    <sce:param name="wild_double" type="bool"/>
    <sce:param name="wild_dsl" type="bool"/>
    <sce:param name="bounded" type="bool"/>
    <sce:param name="chunk_bound" type="uint32"/>
    <sce:return type="bool"/>
  </sce:signature>
  <sce:body>
    <!-- Where no chunk bound applies, the walk from a judges both texts as it
         goes and answers unless b holds a `**`; only then are the two shapes
         read. -->
    <sce:if cond="!bounded">
      <sce:var name="quick" type="uint8" init="keyexpr_walk(a, b, 2, wild_single, wild_double, wild_dsl)"/>
      <sce:if cond="quick !== 2">
        <sce:return expr="quick === 1"/>
      </sce:if>
    </sce:if>
    <sce:var name="sa" type="record:Shape" init="keyexpr_shape(a)"/>
    <sce:var name="sb" type="record:Shape" init="keyexpr_shape(b)"/>
    <!-- A `$*` chunk is spelled with a `$`: without one in either text the
         chunk steps need not look for it. -->
    <sce:var name="dsl" type="bool" init="wild_dsl &amp;&amp; (sa.dollar || sb.dollar)"/>
    <sce:if cond="sa.chunks === 0 || sb.chunks === 0">
      <sce:return expr="false"/>
    </sce:if>
    <sce:if cond="bounded &amp;&amp; (sa.chunks &gt; chunk_bound || sb.chunks &gt; chunk_bound)">
      <sce:return expr="false"/>
    </sce:if>
    <sce:var name="da" type="bool" init="wild_double &amp;&amp; sa.double_star"/>
    <sce:var name="db" type="bool" init="wild_double &amp;&amp; sb.double_star"/>
    <sce:if cond="db">
      <sce:if cond="!da">
        <sce:return expr="false"/>
      </sce:if>
      <sce:if cond="sb.chunks &lt;= 63">
        <sce:return expr="keyexpr_relation_dp(a, b, true, false, true, wild_single, dsl)"/>
      </sce:if>
      <sce:if cond="sa.chunks &lt;= 63">
        <sce:return expr="keyexpr_relation_dp(b, a, false, true, true, wild_single, dsl)"/>
      </sce:if>
      <sce:return expr="false"/>
    </sce:if>
    <sce:return expr="keyexpr_walk(a, b, 2, wild_single, wild_double, dsl) === 1"/>
  </sce:body>
</scxml>
