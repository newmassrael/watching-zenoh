// The conformance corpus of the fixed records of an end-to-end protected frame: the frame a layout
// builds from its values, the record a receiver opens from its bytes (`e2e_opened`), the values a
// layout refuses, and the policy a receiver judges by (`e2e_policy`). README.md beside this file
// states the format; src/fixed_records_tests.rs runs every vector through the hand-written builder
// and opener, and through a generated codec of the same layouts behind `sce-generated-codec`.
//
// Every layout, width, mask, constant and name is made up for the corpus and unlike any
// deployment's. The CRCs are published catalogue entries (CRC-8/DVB-S2, CRC-32/ISCSI, CRC-16/ARC).
{
  format: 'wz-fixed-records/1',
  layouts: {
    // One word with bits no part owns (28 to 31) under a mask that covers them, a one-byte CRC fed
    // the counter before the word that precedes it on the wire, and a length that counts the frame.
    'mask-word': {
      profile: {
        name: 'mask-word',
        fields: [
          {name: 'ident', bytes: 4, xor: '0xFF0F0F0F',
           split: [{name: 'domain', lsb: 24, width: 4},
                   {name: 'version', lsb: 16, width: 8},
                   {name: 'msg', lsb: 0, width: 16}]},
          {name: 'counter', bytes: 1},
          {name: 'length', bytes: 2},
          {name: 'crc', bytes: 1},
        ],
        crc: {field: 'crc', width: 8, poly: '0xD5', init: '0x00', refin: false, refout: false,
              xorout: '0x00', cover: ['counter', 'ident', '@payload', 'length']},
        length: {field: 'length', counts: 'frame'},
        counter: {field: 'counter', max_gap: 4, timeout_ms: 250},
        judge: {ident: 'ident', length: true},
      },
      expected: {ident: {domain: 3, version: 9, msg: '0x0A11'}},
    },
    // One value (`code`) over two runs of a three-byte word, with a part between the runs and bits
    // no part owns (16, 10 and 11) under the word's mask, a part derived from the node's address,
    // a plain field with a mask of its own, a 32-bit CRC fed the body second, and a length that
    // leaves the CRC and itself out.
    'multi-run': {
      profile: {
        name: 'multi-run',
        fields: [
          {name: 'counter', bytes: 2},
          {name: 'cell', bytes: 3, xor: '0x9E5A27',
           split: [{name: 'code.hi', lsb: 20, width: 4},
                   {name: 'kind', lsb: 17, width: 3},
                   {name: 'code.lo', lsb: 12, width: 4},
                   {name: 'sender', lsb: 0, width: 10,
                    derive: {from: 'address', mask: '0x2D7', xor: '0x0A5'}}]},
          {name: 'tag', bytes: 2, xor: '0x0FF0'},
          {name: 'length', bytes: 2},
          {name: 'crc', bytes: 4},
        ],
        crc: {field: 'crc', width: 32, poly: '0x1EDC6F41', init: '0xFFFFFFFF', refin: true,
              refout: true, xorout: '0xFFFFFFFF',
              cover: ['tag', '@payload', 'cell', 'counter', 'length']},
        length: {field: 'length', counts: 'frame_minus', fields: ['crc', 'length']},
        counter: {field: 'counter', max_gap: 9, timeout_ms: 0},
        judge: {counter_errors: 'joined'},
        cell: {field: 'cell', kind: 'kind', sender: 'sender'},
      },
      runs: {code: {field: 'cell', parts: ['code.hi', 'code.lo']}},
    },
    // The CRC first on the wire and fed the body first, a one-byte length that leaves the CRC and
    // itself out, a plain identifier under a mask, and a two-byte word whose parts own five bits.
    'minus-length': {
      profile: {
        name: 'minus-length',
        fields: [
          {name: 'crc', bytes: 2},
          {name: 'seq', bytes: 1},
          {name: 'ident', bytes: 2, xor: '0x6C93'},
          {name: 'length', bytes: 1},
          {name: 'mode', bytes: 2, xor: '0x5AA5',
           split: [{name: 'flag', lsb: 15, width: 1}, {name: 'level', lsb: 8, width: 4}]},
        ],
        crc: {field: 'crc', width: 16, poly: '0x8005', init: '0x0000', refin: true, refout: true,
              xorout: '0x0000', cover: ['@payload', 'length', 'ident', 'seq', 'mode']},
        length: {field: 'length', counts: 'frame_minus', fields: ['crc', 'length']},
        counter: {field: 'seq', max_gap: 2, timeout_ms: 1500, max_gap_ceiling: 3},
        judge: {ident: 'ident', out_of_range: 'keeps_baseline'},
        cell: {field: 'mode', kind: 'flag', result: 'level'},
      },
      expected: {ident: '0x04D2'},
    },
  },
  vectors: [
  {
    name: 'mask-word/the-word-sent-for-review',
    kind: 'frame', layout: 'mask-word',
    values: {ident: {domain: 3, version: 9, msg: '0x0A11'}, counter: '0x2C'},
