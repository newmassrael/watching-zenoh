               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           senders: [{node: 'a', id: 1}]}]}},
    {refusal: 'sender_not_publisher', at: '/messages/0/senders/0/node',
