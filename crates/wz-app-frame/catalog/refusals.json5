// The corpus both judges of a message catalog run: the reader's tests
// (crates/wz-app-frame/src/message_catalog_tests.rs) and the generator's selftest
// (scripts/lib/message_catalog.py). Each refused case has one defect, the refusal it is named by
// and the JSON pointer to the place; a case whose refusal the schema lists in x-wz-reader-only is
// judged by the reader alone, and the generator's selftest holds that it does not refuse it.
// Every catalog in `accepted` is accepted by both. `limits` are the bounds every case is read
// against unless the case states its own. All values are synthetic.
{
  limits: {messages: 4, replay_depth_max: 5, sender_slots: 2, key_fields: 2, instances: 6},
  accepted: [
    {nodes: [{name: 'a'}, {name: 'b'}],
     messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b']}]},
    {nodes: [{name: 'a', address: 256}, {name: 'b', address: '0x200'}, {name: 'c'}],
     e2e_profiles: {
       q: {name: 'q',
           fields: [{name: 'crc', bytes: 1}, {name: 'counter', bytes: 1},
                    {name: 'length', bytes: 1},
                    {name: 'cell', bytes: 2,
                     split: [{name: 'kind', lsb: 12, width: 4},
                             {name: 'sender', lsb: 0, width: 12,
                              derive: {from: 'address', mask: '0xF00', xor: '0x5'}}]}],
           crc: {field: 'crc', width: 8, poly: '0x1D', init: '0x00', refin: false,
                 refout: false, xorout: '0x00', cover: ['counter', 'length', 'cell', '@payload']},
           length: {field: 'length', counts: 'frame'},
           counter: {field: 'counter', max_gap: 2, timeout_ms: 100},
           cell: {field: 'cell', kind: 'kind', sender: 'sender'}},
     },
     supervision: {start_delay_ms: 0},
     messages: [{key_expr: 'k/two', id: '0x2', publishers: ['a', 'b'], subscribers: ['c'],
                 period_ms: 20, protection: {profile: 'q', values: {cell: {kind: 2}}},
                 senders: [{node: 'a', id: '0x105'}, {node: 'b', id: '0x205'}],
                 supervision: {factor: 3, awaited: false}, replay_depth: 5},
                {key_expr: 'k/three', id: 3, publishers: ['c'], subscribers: [],
                 instance_key: [{field: 'zone', values: [1, 2, 'far']}]}]},
    {nodes: [{name: 'a'}],
     messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: [],
                 instance_key: [{field: 'zone', values: [1, 2, 3]},
                                {field: 'side', values: ['l', 'r']}]}]},
  ],
  cases: [
    {refusal: 'syntax', at: '', text: '{nodes: ['},
    {refusal: 'syntax', at: '', text: '{nodes: [[[[[[[[[[0]]]]]]]]]], messages: []}'},
    {refusal: 'unknown_field', at: '/messages/0/colour',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           colour: 'red'}]}},
    {refusal: 'unknown_field', at: '/nodes/0/role',
     catalog: {nodes: [{name: 'a', role: 'x'}], messages: []}},
    {refusal: 'duplicate_field', at: '/messages/0/id',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, id: 2, publishers: ['a'],
                           subscribers: ['b']}]}},
    {refusal: 'missing_field', at: '/messages/0',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a']}]}},
    {refusal: 'missing_field', at: '',
     catalog: {nodes: [{name: 'a'}]}},
    {refusal: 'wrong_type', at: '/messages/0/id',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 'one', publishers: ['a'],
                           subscribers: ['b']}]}},
    {refusal: 'wrong_type', at: '/messages/0/id',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: -1, publishers: ['a'], subscribers: ['b']}]}},
    {refusal: 'wrong_type', at: '/messages/0/publishers',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: 'a', subscribers: ['b']}]}},
    {refusal: 'wrong_type', at: '/e2e_profiles/p',
     catalog: {nodes: [{name: 'a'}], e2e_profiles: {p: 5}, messages: []}},
    {refusal: 'value_out_of_range', at: '/messages/0/id',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 4294967296, publishers: ['a'],
                           subscribers: ['b']}]}},
    {refusal: 'value_out_of_range', at: '/nodes/0/address',
     catalog: {nodes: [{name: 'a', address: '0x10000000000000000'}], messages: []}},
    {refusal: 'value_out_of_range', at: '/messages/0/supervision/factor',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           period_ms: 10, supervision: {factor: 0}}]}},
    {refusal: 'invalid_name', at: '/nodes/1/name',
     catalog: {nodes: [{name: 'a'}, {name: 'b b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b']}]}},
    {refusal: 'invalid_name', at: '/e2e_profiles/bad name',
     catalog: {nodes: [{name: 'a'}], e2e_profiles: {'bad name': {}}, messages: []}},
    {refusal: 'empty', at: '/nodes',
     catalog: {nodes: [], messages: []}},
    {refusal: 'empty', at: '/messages/0/publishers',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: [], subscribers: ['b']}]}},
    {refusal: 'empty', at: '/messages/0/instance_key/0/field',
     catalog: {nodes: [{name: 'a'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: [],
                           instance_key: [{field: '', values: [1]}]}]}},
    {refusal: 'duplicate_node', at: '/nodes/1/name',
