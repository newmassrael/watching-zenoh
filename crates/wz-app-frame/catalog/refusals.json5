               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b']},
                          {key_expr: 'k/two', id: '0x1', publishers: ['a'], subscribers: ['b']}]}},
    {refusal: 'period_zero', at: '/messages/0/period_ms',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           period_ms: 0}]}},
    {refusal: 'deadline_out_of_range', at: '/messages/0/supervision/factor',
