               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           supervision: {factor: 3}}]}},
    {refusal: 'replay_depth_out_of_range', at: '/messages/0/replay_depth',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           replay_depth: 6}]}},
    {refusal: 'replay_depth_out_of_range', at: '/messages/0/replay_depth',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
                           replay_depth: 0}]}},
    {refusal: 'too_many_messages', at: '/messages', limits: {messages: 1},
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b']},
                          {key_expr: 'k/two', id: 2, publishers: ['a'], subscribers: ['b']}]}},
    {refusal: 'unknown_e2e_profile', at: '/messages/0/protection/profile',
     catalog: {nodes: [{name: 'a'}, {name: 'b'}],
               messages: [{key_expr: 'k/one', id: 1, publishers: ['a'], subscribers: ['b'],
