<!-- gc-3c/R311gv example application machine for the switchboard value path.

     Imports the temp_update EventSchema and reads a DIFFERENT typed field in
     each guarded state: `_event.data.celsius_centi` (uint16) in idle and
     `_event.data.sensor_id` (string) in hot. Two guards in two states, so the
     machine exercises SCE's per-source-state guard keying fixed in pin
     1474bd0a9 (R311gu) — before that fix both rendered idle's celsius guard.
     SCE lowers `temp_update` to native `_event.data` comparisons (no script
     engine) and emits the `SensorMonitorInject::raise_temp_update` seam +
     lists `temp_update` in `typed_inject_events`. The string guard observes
     the decoded `sensor_id` semantically. The third payload field `raw`
     (bytes) rides in the typed payload too — exercising the borrowed `&[u8]`
     -> owned `Vec<u8>` field-move via `.into()` — but is NOT guarded: SCE's
     Rust emitter lowers a `bytes === '<lit>'` cond to `ev.raw == "<lit>"`
     (a `&str` literal, no `Vec<u8>: PartialEq<&str>`), so a native bytes
     guard does not compile today (it would need to emit `b"<lit>"`). The
     switchboard binds the keyexpr `home/*/temp` to this event
     (value binding, codec=temp_payload), so an inbound zenoh sample drives the
     statechart with a typed payload — the MCU-clean value path end to end. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="sensor_monitor"
       version="1.0"
       initial="idle"
       datamodel="ecmascript">
  <sce:import src="temp_update_schema.scxml" kind="event-schema" as="TempUpdateSchema"/>
  <state id="idle">
    <!-- value event: 3000 centidegrees = 30.00 C native typed guard. -->
    <transition event="temp_update" cond="_event.data.celsius_centi &gt; 3000" target="hot"/>
  </state>
  <state id="hot">
    <!-- native string guard: only the kitchen sensor escalates to alarm.
         Reads `_event.data.sensor_id` (a non-enum string field is payload-
         eligible), so this lowers natively too — `temp_update` keeps its
         typed-inject seam. -->
    <transition event="temp_update" cond="_event.data.sensor_id === 'kitchen'" target="alarm"/>
    <!-- signal event: no _event.data guard, so `reset` is NOT a typed-inject
         seam — the switchboard binds it as a signal row. -->
    <transition event="reset" target="idle"/>
  </state>
  <state id="alarm">
    <transition event="reset" target="idle"/>
  </state>
</scxml>
