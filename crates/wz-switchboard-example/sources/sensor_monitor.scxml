<!-- gc-3c/R311gw example application machine for the switchboard value path.

     Imports the temp_update EventSchema and reads a DIFFERENT typed field in
     each guarded state: `_event.data.celsius_centi` (uint16) in idle,
     `_event.data.sensor_id` (string) in hot, and `_event.data.raw` (bytes) in
     alarm. Three guards in three states, so the machine exercises SCE's
     per-source-state guard keying fixed in pin 1474bd0a9 (R311gu) — before
     that fix all three rendered idle's celsius guard. SCE lowers `temp_update`
     to native `_event.data` comparisons (no script engine) and emits the
     `SensorMonitorInject::raise_temp_update` seam + lists `temp_update` in
     `typed_inject_events`. All three guards observe their decoded field
     semantically; the bytes guard (`raw === 'ack'`) lowers to a BytesLit
     comparison (`ev.raw == b"ack"`) since pin d665780d9 (R311gw) — earlier
     pins mis-emitted a `&str` literal that did not compile against `Vec<u8>`.
     The string + bytes guards prove the borrowed-view (`&str` / `&[u8]`) ->
     owned (`String` / `Vec<u8>`) field-moves delivered the right values. The
     switchboard binds the keyexpr `home/*/temp` to this event
     (value binding, codec=temp_payload), so an inbound zenoh sample drives the
     statechart with a typed payload — the MCU-clean value path end to end. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="sensor_monitor"
       version="1.0"
       initial="idle"
       datamodel="ecmascript">
  <sce:import src="temp_update_schema.scxml" kind="event-schema" as="TempUpdateSchema"/>
  <state id="idle">
    <!-- value event: 3000 centidegrees = 30.00 C native typed guard. -->
    <transition event="temp_update" cond="_event.data.celsius_centi &gt; 3000" target="hot"/>
  </state>
  <state id="hot">
    <!-- native string guard: only the kitchen sensor escalates to alarm.
         Reads `_event.data.sensor_id` (a non-enum string field is payload-
         eligible), so this lowers natively too — `temp_update` keeps its
         typed-inject seam. -->
    <transition event="temp_update" cond="_event.data.sensor_id === 'kitchen'" target="alarm"/>
    <!-- signal event: no _event.data guard, so `reset` is NOT a typed-inject
         seam — the switchboard binds it as a signal row. -->
    <transition event="reset" target="idle"/>
  </state>
  <state id="alarm">
    <!-- native bytes guard: only a payload whose `raw` blob equals the ASCII
         literal "ack" acknowledges the alarm back to idle; any other
         temp_update stays in alarm. Reads `_event.data.raw` (a non-enum bytes
         field is payload-eligible) and lowers to a BytesLit comparison
         (`ev.raw == b"ack"`) on pin d665780d9+. -->
    <transition event="temp_update" cond="_event.data.raw === 'ack'" target="idle"/>
    <transition event="reset" target="idle"/>
  </state>
</scxml>
