<!-- gc-3c example application machine for the switchboard value path.

     Imports the temp_update EventSchema and reads
     `_event.data.celsius_centi` in a transition guard, so SCE lowers
     `temp_update` to a native typed `_event.data` comparison (no script
     engine) and emits the `SensorMonitorInject::raise_temp_update` seam +
     lists `temp_update` in `typed_inject_events`. The switchboard binds the
     keyexpr `home/*/temp` to this event (value binding, codec=temp_payload),
     so an inbound zenoh sample drives the statechart with a typed payload —
     the MCU-clean value path end to end. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="sensor_monitor"
       version="1.0"
       initial="idle"
       datamodel="ecmascript">
  <sce:import src="temp_update_schema.scxml" kind="event-schema" as="TempUpdateSchema"/>
  <state id="idle">
    <!-- value event: 3000 centidegrees = 30.00 C native typed guard. -->
    <transition event="temp_update" cond="_event.data.celsius_centi &gt; 3000" target="hot"/>
  </state>
  <state id="hot">
    <!-- signal event: no _event.data guard, so `reset` is NOT a typed-inject
         seam — the switchboard binds it as a signal row. -->
    <transition event="reset" target="idle"/>
  </state>
</scxml>
