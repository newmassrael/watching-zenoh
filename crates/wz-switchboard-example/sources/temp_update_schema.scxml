<!-- gc-3c/R311gt example EventSchema: the typed `_event.data` contract for
     the `temp_update` event. A primitive field (`celsius_centi`, uint16
     centidegrees) PLUS a scalar `string` field (`sensor_id`). Imported by
     sensor_monitor.scxml; the statechart's native typed guard reads
     `_event.data.celsius_centi`, so the event is native-lowered and SCE emits
     the `SensorMonitorTempUpdatePayload { celsius_centi: u16, sensor_id: String
     }` struct (a non-enum schema is payload-eligible — string/bytes included)
     and the `raise_temp_update` inject seam. `sensor_id` rides in the payload
     even though the *first* guard only reads `celsius_centi`: it exercises the
     borrowed-view (`&str`) -> owned (`String`) field-move the switchboard
     generator emits. The wire decode of those bytes is a separate concern
     (temp_payload.scxml, a forge codec) — wz owns the codec<->schema field
     pairing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="temp_update_schema"
       sce:kind="event-schema"
       sce:event-name="temp_update">
  <datamodel>
    <data id="celsius_centi" sce:type="uint16" sce:direction="in"/>
    <data id="sensor_id" sce:type="string" sce:direction="in"/>
  </datamodel>
</scxml>
