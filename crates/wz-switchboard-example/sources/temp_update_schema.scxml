<!-- gc-3c/R311gt example EventSchema: the typed `_event.data` contract for
     the `temp_update` event. A primitive field (`celsius_centi`, uint16
     centidegrees) PLUS a scalar `string` field (`sensor_id`) PLUS a scalar
     `bytes` field (`raw`). Imported by sensor_monitor.scxml, whose native
     typed guards read `celsius_centi` (idle) and `sensor_id` (hot), so the
     event is native-lowered and SCE emits the `SensorMonitorTempUpdatePayload
     { celsius_centi: u16, sensor_id: String, raw: Vec<u8> }` struct (a
     non-enum schema is payload-eligible — string/bytes included) and the
     `raise_temp_update` inject seam. `sensor_id` / `raw` exercise the
     borrowed-view (`&str` / `&[u8]`) -> owned (`String` / `Vec<u8>`)
     field-moves the switchboard generator emits via `.into()` (the `raw`
     field rides in the payload but is unguarded — see sensor_monitor.scxml
     for the SCE bytes-literal-guard gap). The wire decode of those bytes is a separate concern
     (temp_payload.scxml, a forge codec) — wz owns the codec<->schema field
     pairing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="temp_update_schema"
       sce:kind="event-schema"
       sce:event-name="temp_update">
  <datamodel>
    <data id="celsius_centi" sce:type="uint16" sce:direction="in"/>
    <data id="sensor_id" sce:type="string" sce:direction="in"/>
    <data id="raw" sce:type="bytes" sce:direction="in"/>
  </datamodel>
</scxml>
