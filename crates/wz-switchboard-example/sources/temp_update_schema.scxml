<!-- gc-3c example EventSchema: the typed `_event.data` contract for the
     `temp_update` event. One primitive field (`celsius_centi`, uint16
     centidegrees). Imported by sensor_monitor.scxml; the statechart's
     native typed guard reads `_event.data.celsius_centi`, so SCE emits the
     `SensorMonitorTempUpdatePayload { celsius_centi: u16 }` struct and the
     `raise_temp_update` inject seam. The wire decode of those bytes is a
     separate concern (temp_payload.scxml, a forge codec) — wz owns the
     codec<->schema field pairing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="temp_update_schema"
       sce:kind="event-schema"
       sce:event-name="temp_update">
  <datamodel>
    <data id="celsius_centi" sce:type="uint16" sce:direction="in"/>
  </datamodel>
</scxml>
