<!-- gc-3 carry #2 — the demo's wire codec: a published temperature sample's
     payload is a single big-endian uint16 centidegrees at byte 0. The
     smallest possible value-path wire shape, so an external peer can publish
     it with a two-byte payload. `celsius_centi` matches the temp_update
     EventSchema field by id + type, so the switchboard generator emits
     `SensorMonitorTempUpdatePayload { celsius_centi: decoded.celsius_centi }`
     (a primitive Copy move, no `.into()`). This is the wire-format SSOT (a
     publisher encodes the same codec); the EventSchema is the datamodel-view
     SSOT. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec"
       sce:default-endian="big"
       name="temp_payload">
  <datamodel>
    <sce:field id="celsius_centi" sce:type="uint16" sce:byte="0" sce:bit-size="16"/>
  </datamodel>
</scxml>
