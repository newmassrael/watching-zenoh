#!/usr/bin/env bash
# pre-push hook — FAST local gate: SSOT integrity + changed-crate tests only.
#
# POLICY (R311y386): the local push gate is DELIBERATELY NOT a full CI mirror.
# Local push runs only:
#   1. mnemosyne-cli validate-workspace   — the SSOT integrity gate (seconds).
#   2. cargo test -p <crate>              — for ONLY the crates this push
#                                           changes (default features).
# The FULL validation surface — the feature-subset matrix, clippy, codegen
# (Layers B/B2), footprint (F), cross-compile (G), QEMU (Q), interop (Z),
# every non-default feature combo — is the HOSTED CI's job. It runs on every
# push to main and gates there. A red hosted run is the accepted cost of a
# fast local push.
#
# This REVERSES the R64..R311pt policy where this hook mirrored CI's whole
# gate-set locally (~50s host-only floor, several minutes with the ARM / qemu
# / zenohd toolchains present). That made every push slow and duplicated work
# the ephemeral hosted runners re-do anyway. The trade is explicit: local no
# longer "catches everything before push"; it catches SSOT drift + the changed
# crates' own default-feature tests, and hosted CI is the single full gate.
#
# Coverage the changed-crate test does NOT give (all covered by hosted CI):
#   - feature-gated lanes (a change behind a non-default cfg is not run here);
#   - changes outside crates/ (sources/, out/, runtime/, deploy/, ci.yml);
#   - clippy / fmt / footprint / cross-compile / interop.
# If you want the old full sweep locally, run `bash scripts/run-ci.sh` by hand.
#
# The empty-ref / delete-only short-circuit (R224a) is kept. The R224b flock
# and the R250 HEAD-re-source are gone: they existed for the multi-lane
# run-ci race (sce-codegen rebuild + crates/target thrash); a single
# `cargo test -p <crate>` is serialized by cargo's own target-dir lock.
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
# Bypass with `git push --no-verify` only for genuine hotfixes.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# ─── R224a guard — empty-ref / delete-only short-circuit ────────────
# Git protocol: pre-push receives one whitespace-separated tuple per ref on
# stdin as `<local_ref> <local_sha> <remote_ref> <remote_sha>`. A
# local_sha of 40*"0" is a delete-ref (no new commit to test); empty stdin
# is "nothing to push". Either has zero work, so fast-exit. We keep the last
# non-delete tuple's shas as the diff range for the changed-crate gate.
zero_sha="0000000000000000000000000000000000000000"
local_sha=""
remote_sha=""
has_work=0
while read -r _local_ref l_sha _remote_ref r_sha; do
    if [[ "$l_sha" != "$zero_sha" ]]; then
        has_work=1
        local_sha="$l_sha"
        remote_sha="$r_sha"
    fi
done
if [[ $has_work -eq 0 ]]; then
    echo "pre-push: nothing to push (no non-delete refs); skipping gate"
    exit 0
fi

# ─── gate 1 — SSOT integrity (validate-workspace, seconds) ──────────
# Fast and load-bearing: catches a bypassed typed-mutate primitive (raw
# Edit on the sidecar JSON, a frozen-ledger violation, a new T1 orphan)
# BEFORE it reaches origin. pre-commit runs this too, but pre-push re-runs
# it because amends / rebases / manual atomic.json edits change post-commit
# state the commit hook never saw. Advisory when the tool is absent.
if command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-push: mnemosyne-cli validate-workspace (SSOT gate) ..."
    if ! mnemosyne-cli validate-workspace; then
        echo "" >&2
        echo "pre-push: validate-workspace FAILED — fix before push." >&2
        echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
        exit 1
    fi
else
    echo "pre-push: mnemosyne-cli not on PATH; skipping SSOT gate (install to enable)."
fi

# ─── gate 2 — changed-crate tests (default features, fast) ──────────
# Diff range: <remote_sha>..<local_sha>. A zero/absent remote_sha (a new
# ref or first push) has no remote base — fall back to origin/main if it
# exists, else skip (nothing to diff against). Only crates/<name>/ changes
# map to a test target; everything else is hosted-CI-only.
diff_base=""
if [[ -n "$remote_sha" && "$remote_sha" != "$zero_sha" ]]; then
    diff_base="$remote_sha"
elif git rev-parse --verify --quiet origin/main >/dev/null; then
    diff_base="origin/main"
fi

if [[ -z "$diff_base" ]]; then
    echo "pre-push: no diff base (new ref, no origin/main); skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

mapfile -t changed_dirs < <(
    git diff --name-only "$diff_base..$local_sha" -- 'crates/' 2>/dev/null \
        | sed -nE 's#^crates/([^/]+)/.*#\1#p' \
        | sort -u
)

if [[ ${#changed_dirs[@]} -eq 0 ]]; then
    echo "pre-push: no crates/ changes in this push; skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

# Map each changed crate DIR to its cargo PACKAGE name (dir != package is
# rare but allowed). A dir whose Cargo.toml is gone (renamed/deleted in the
# diff) is skipped rather than failing the push.
pkgs=()
for d in "${changed_dirs[@]}"; do
    manifest="crates/$d/Cargo.toml"
    if [[ ! -f "$manifest" ]]; then
        echo "pre-push:   crates/$d — Cargo.toml gone (renamed/deleted), skipping"
        continue
    fi
    pkg="$(sed -nE 's/^name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$manifest" | head -1)"
    [[ -n "$pkg" ]] && pkgs+=("$pkg")
done

if [[ ${#pkgs[@]} -eq 0 ]]; then
    echo "pre-push: no live changed crates to test; full validation runs on hosted CI."
    exit 0
fi

echo "pre-push: testing changed crates only (default features): ${pkgs[*]}"
echo "          feature-matrix / clippy / footprint / cross-compile / interop -> hosted CI."
fail=0
for pkg in "${pkgs[@]}"; do
    echo "pre-push:   cargo test -p $pkg ..."
    if ! (cd crates && cargo test -p "$pkg" --quiet); then
        echo "pre-push:   $pkg tests FAILED" >&2
        fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "" >&2
    echo "pre-push: changed-crate tests failed — fix before push." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

echo "pre-push: changed-crate tests passed; full validation continues on hosted CI."
exit 0
