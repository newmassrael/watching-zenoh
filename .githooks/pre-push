#!/usr/bin/env bash
# pre-push hook — FAST local gate: SSOT integrity + changed-crate tests only.
#
# POLICY (R311y386): the local push gate is DELIBERATELY NOT a full CI mirror.
# Local push runs only:
#   1. schema pin vs the pushed commits   — R311y418; the one failure class
#                                           gate 2 structurally cannot see.
#   2. mnemosyne-cli validate-workspace   — the SSOT integrity gate (seconds).
#   3. cargo test -p <crate>              — for ONLY the crates this push
#                                           changes (default features).
#   4. Layer C1bz over those crates AND    — R311y792/y793; the doc-link
#      the crates whose docs link into       budget. A doc comment is the one
#      them                                  thing `cargo test` cannot fail on,
#                                            and the class cost two rounds.
#   5. Layer 0 when the push touches       — R311y793/y794; rustfmt +
#      .github/workflows, scripts/,          actionlint + shellcheck. Those
#      .githooks/ or deploy/                 paths had no local gate at all.
# The FULL validation surface — the feature-subset matrix, clippy, codegen
# (Layers B/B2), footprint (F), cross-compile (G), QEMU (Q), interop (Z),
# every non-default feature combo — is the HOSTED CI's job. It runs on every
# push to main and gates there. A red hosted run is the accepted cost of a
# fast local push.
#
# This REVERSES the R64..R311pt policy where this hook mirrored CI's whole
# gate-set locally (~50s host-only floor, several minutes with the ARM / qemu
# / zenohd toolchains present). That made every push slow and duplicated work
# the ephemeral hosted runners re-do anyway. The trade is explicit: local no
# longer "catches everything before push"; it catches SSOT drift + the changed
# crates' own default-feature tests, and hosted CI is the single full gate.
#
# Coverage the changed-crate test does NOT give (all covered by hosted CI):
#   - feature-gated lanes (a change behind a non-default cfg is not run here);
#   - changes outside crates/ (sources/, out/, runtime/, deploy/, ci.yml);
#   - clippy / fmt / footprint / cross-compile / interop.
# If you want the old full sweep locally, run `bash scripts/run-ci.sh` by hand.
#
# The empty-ref / delete-only short-circuit (R224a) is kept. The R224b flock
# and the R250 HEAD-re-source are gone: they existed for the multi-lane
# run-ci race (sce-codegen rebuild + crates/target thrash); a single
# `cargo test -p <crate>` is serialized by cargo's own target-dir lock.
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
# Bypass with `git push --no-verify` only for genuine hotfixes.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# ─── R224a guard — empty-ref / delete-only short-circuit ────────────
# Git protocol: pre-push receives one whitespace-separated tuple per ref on
# stdin as `<local_ref> <local_sha> <remote_ref> <remote_sha>`. A
# local_sha of 40*"0" is a delete-ref (no new commit to test); empty stdin
# is "nothing to push". Either has zero work, so fast-exit. We keep the last
# non-delete tuple's shas as the diff range for the changed-crate gate.
zero_sha="0000000000000000000000000000000000000000"
local_sha=""
remote_sha=""
has_work=0
push_shas=()          # every non-delete local sha, for the per-ref schema gate
while read -r _local_ref l_sha _remote_ref r_sha; do
    if [[ "$l_sha" != "$zero_sha" ]]; then
        has_work=1
        local_sha="$l_sha"
        remote_sha="$r_sha"
        push_shas+=("$l_sha")
    fi
done
if [[ $has_work -eq 0 ]]; then
    echo "pre-push: nothing to push (no non-delete refs); skipping gate"
    exit 0
fi

# ─── gate 0 — confidential vocabulary (R311y619) ────────────────────
# FIRST, because it is the only failure here that a revert does not undo:
# origin is public, so material that reaches it is published even if the commit
# is removed afterwards. This repo has leaked a client document once already and
# needed filter-repo plus a force push to clean up, after the fact.
#
# Placed ahead of the schema and SSOT gates deliberately — those protect a store
# that can be fixed in the next commit; this one protects something that cannot.
# It is also the cheapest gate in the file.
#
# The term list lives in .git/ and is therefore unpushable; an absent or empty
# list FAILS rather than skipping, on the same rule the schema pin follows.
# shellcheck disable=SC1091  # constant path, resolved at run time
if ! source scripts/lib/nda-scan.sh; then
    echo "pre-push: scripts/lib/nda-scan.sh missing or unreadable." >&2
    exit 1
fi
nda_base="${remote_sha:-}"
if [[ -z "$nda_base" || "$nda_base" == "$zero_sha" ]]; then
    if git rev-parse --verify --quiet origin/main >/dev/null; then
        nda_base="origin/main"
    fi
fi
if [[ -n "$nda_base" ]]; then
    if ! wz_nda_scan "$nda_base..$local_sha"; then
        echo "" >&2
        echo "pre-push: confidential-vocabulary gate FAILED — push refused." >&2
        exit 1
    fi
else
    # No base to diff against means the whole history is the range, and a
    # first push of an entire repo is not a case this gate can usefully
    # narrow. Say so rather than printing a green line for work not done.
    echo "pre-push: nda-scan has no diff base (new ref, no origin/main);" >&2
    echo "          the range is unbounded and this gate did NOT run." >&2
fi

# ─── gate 0b — home-directory paths (R2064) ─────────────────────────
# The sibling of gate 0 and the same argument one notch smaller: origin is
# PUBLIC, a push cannot be un-published, and CLAUDE.md's ban on machine-local
# absolute paths was until now enforced by an agent remembering it. Unlike
# gate 0 this scans the WHOLE tracked tree rather than a diff range, because
# the atomic store's ceiling is a property of the file and not of the push.
# shellcheck disable=SC1091  # constant path, resolved at run time
if ! source scripts/lib/home-path-scan.sh; then
    echo "pre-push: scripts/lib/home-path-scan.sh missing or unreadable." >&2
    exit 1
fi
if ! wz_home_path_scan "$(git rev-parse --show-toplevel)"; then
    echo "pre-push: a tracked file names this machine's home directory." >&2
    echo "          Origin is public and a push does not un-publish." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 0c — the identities being published (2026-08-25) ──────────
# Third in the gate-0 family and the same argument again: origin is PUBLIC
# and a push cannot be un-published. This one is here because that sentence
# stopped being a caution and became a bill. Eight commits authored with a
# work address reached this repository; the history rewrite that removed them
# from `main` left all eight reachable by SHA, GitHub kept serving them and
# kept listing the other account as a contributor, and the only thing that
# actually removed them was deleting and recreating the repository -- which
# cost 1146 runs of CI history.
#
# WHY THE PUSH AND NOT ONLY THE COMMIT. pre-commit carries the same gate, and
# it would not have caught this: those commits were made where the hooks were
# not installed. The push is the last moment before publication and the first
# one this tree controls, which is the identical argument gate 1 makes for
# the schema pin one gate down.
#
# The range is `<remote>..<local>` normally and a bare `<local>` when origin
# does not have the ref yet. That second case grades the WHOLE history, and
# it is deliberate rather than incidental: it is the state this repository
# was in immediately after the recreation, and it is exactly when a stray
# identity would otherwise be republished wholesale.
# shellcheck disable=SC1091  # constant path, resolved at run time
if ! source scripts/lib/ident-gate.sh; then
    echo "pre-push: scripts/lib/ident-gate.sh missing or unreadable." >&2
    exit 1
fi
for sha in "${push_shas[@]}"; do
    ident_range="$sha"
    if [[ -n "$remote_sha" && "$remote_sha" != "$zero_sha" ]]; then
        ident_range="${remote_sha}..${sha}"
    fi
    if ! wz_ident_gate_range 'pre-push' "$ident_range"; then
        echo "" >&2
        echo "pre-push: origin is public and a push does not un-publish." >&2
        echo "          Rewrite the offending commits before pushing:" >&2
        echo "            git rebase -r --exec 'git commit --amend --no-edit --reset-author' <base>" >&2
        echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
        exit 1
    fi
done

# ─── gate 1 — schema pin, on the COMMITS BEING PUSHED (R311y418) ────
# pre-commit grades the index, which covers `git commit` and nothing else:
# cherry-pick, rebase, merge and --no-verify all reach origin without ever
# running it (all three reproduced during the R311y418 review — a store
# migrated on a side branch landed on main via cherry-pick, unchecked).
# This is the same argument gate 2 already makes for validate-workspace,
# and it is STRONGER here, because gate 2 structurally cannot see this
# failure: it runs the LOCAL binary, which in every firing of this class
# was the binary that migrated the store, so it reads it fine and exits 0.
#
# Graded per pushed ref rather than only the last one — a multi-ref push
# must not smuggle a migrated store in on the ref that got overwritten.
# shellcheck disable=SC1091  # constant path, resolved at run time
if ! source scripts/lib/schema-pin-gate.sh; then
    echo "pre-push: scripts/lib/schema-pin-gate.sh missing or unreadable." >&2
    exit 1
fi
for sha in "${push_shas[@]}"; do
    if ! wz_schema_pin_gate "${sha}:" 'pre-push' "pushed commit ${sha:0:12}"; then
        echo "" >&2
        echo "pre-push: bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
        exit 1
    fi
done
# R311y420 — and grade the PATH binary itself against the pin, using the
# ceiling from the TIP being pushed (that is the pin origin will carry). The
# per-commit loop above only sees a migration that already happened; a CLI
# that disagrees with the pin is the condition that produces the next one,
# and it is the last moment before the push where saying so still helps.
# Index arithmetic rather than `${push_shas[-1]}`: negative subscripts are
# bash 4.3+, and this hook is being made bash 3.2-clean in the same commit.
if ! wz_local_cli_pin_gate 'pre-push' "${push_shas[$((${#push_shas[@]} - 1))]}:"; then
    echo "" >&2
    echo "pre-push: bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 2 — SSOT integrity (validate-workspace, seconds) ──────────
# Fast and load-bearing: catches a bypassed typed-mutate primitive (raw
# Edit on the sidecar JSON, a frozen-ledger violation, a new T1 orphan)
# BEFORE it reaches origin. pre-commit runs this too, but pre-push re-runs
# it because amends / rebases / manual atomic.json edits change post-commit
# state the commit hook never saw.
#
# R311y418: an absent mnemosyne-cli is now a hard FAIL, not the SKIP this
# was. The SKIP was unreachable in the flow it was written for — pre-commit
# hard-fails on the same condition, so a developer without the tool cannot
# produce a commit through the normal path anyway — and reachable only in
# the flows where the SSOT gate matters most (--no-verify, rebase,
# cherry-pick, hooks installed after the fact). It bought nothing and cost
# the gate; a SKIP is green.
if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-push: mnemosyne-cli not on PATH — install with" >&2
    echo "  cargo install --path /path/to/mnemosyne/crates/mnemosyne-cli" >&2
    echo "  Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi
echo "pre-push: mnemosyne-cli validate-workspace (SSOT gate) ..."
if ! mnemosyne-cli validate-workspace; then
    echo "" >&2
    echo "pre-push: validate-workspace FAILED — fix before push." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── the diff range, hoisted (used by gate 2b and gate 3) ───────────
# <remote_sha>..<local_sha>. A zero/absent remote_sha (a new ref or first push)
# has no remote base — fall back to origin/main if it exists, else empty, and
# each gate below decides what an unbounded range means for it.
diff_base=""
if [[ -n "$remote_sha" && "$remote_sha" != "$zero_sha" ]]; then
    diff_base="$remote_sha"
elif git rev-parse --verify --quiet origin/main >/dev/null; then
    diff_base="origin/main"
fi

# ─── gate 2b — cross-impl proof audit, WHEN A CLAIM MOVED (R311y764) ─
# The narrowest gate in this file, and it exists because of a measured
# three-round failure rather than a hypothetical one.
#
# Layer A4 counts foreign adjudications and refuses a count that moved without
# `FOREIGN_ADJUDICATOR_LINKS` moving with it, so that the diff carries the
# claim. Each of R311y759 / y760 / y762 added exactly one wire witness and none
# moved the constant, so hosted A4 went red on `1808ba7f`, `8f19661e` and
# `6f689628`. THE GATE WORKED; nothing local ran it, and each of the three
# rounds read the previous run, saw a red, and did not attribute it.
#
# Scoped to pushes that actually move a claim — a `wz-proves:` line in the diff,
# or the audit's own sources — so the ordinary push pays nothing. Measured at
# ~6s on this tree, which is the same order as gate 2. It is NOT a second A4:
# hosted CI still runs the full layer on every push, and this catches only the
# class that the last three rounds proved a human read will not.
if [[ -n "$diff_base" ]]; then
    a4_reason=""
    if git diff -U0 "$diff_base..$local_sha" -- 'crates/' 2>/dev/null \
        | grep -qE '^[-+].*wz-proves:'; then
        a4_reason="a wz-proves claim changed"
    elif ! git diff --quiet "$diff_base..$local_sha" -- \
        'scripts/lib/crossimpl_audit.py' 'scripts/lib/crossimpl_corpus.py' \
        'scripts/audit-crossimpl-proof.sh' 2>/dev/null; then
        a4_reason="the cross-impl audit itself changed"
    fi
    if [[ -n "$a4_reason" ]]; then
        echo "pre-push: cross-impl proof audit ($a4_reason) ..."
        if ! bash scripts/audit-crossimpl-proof.sh; then
            echo "" >&2
            echo "pre-push: cross-impl proof audit FAILED — this is hosted Layer A4," >&2
            echo "          run early because a claim moved in this push." >&2
            echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
            exit 1
        fi
    fi
fi

# ─── gate 2c — the PREVIOUS push's hosted verdict (R311y765) ────────
# Gate 2b above mechanises ONE lane. This is the lane-agnostic half, and it is
# the one carry N70 actually names: the feature-subset matrix, Layers F / G / Q
# / Z / B2 and every other hosted-only lane are deliberately not mirrored here
# (policy R311y386), so for them a human reading the run is the ONLY detector —
# and R311y764 measured that detector failing three pushes in a row.
#
# It does not wait, ever. A run still in progress is reported and passed; the
# verdict is read at the NEXT push, which is exactly where the standing
# round-start rule would have read it. See scripts/lib/previous-run-gate.sh for
# the classification (`cancelled` is neither red nor green) and for why the
# escape is an acknowledgement rather than a refusal — the fix for a red must
# always be pushable.
#
# Graded on the tip being REPLACED, not on what is being pushed: that commit is
# the one hosted CI has had time to judge.
# shellcheck disable=SC1091  # constant path, resolved at run time
if ! source scripts/lib/previous-run-gate.sh; then
    echo "pre-push: scripts/lib/previous-run-gate.sh missing or unreadable." >&2
    exit 1
fi
prev_sha=""
if [[ -n "$remote_sha" && "$remote_sha" != "$zero_sha" ]]; then
    prev_sha="$remote_sha"
elif git rev-parse --verify --quiet origin/main >/dev/null; then
    prev_sha="$(git rev-parse origin/main)"
fi
if ! wz_previous_run_gate "$prev_sha" 'pre-push'; then
    echo "pre-push: bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 2d — config key set vs its drop-in fixture (R2138) ────────
# Open-debt item 224, and the LOCAL half of the gate this hook exists to be.
# `HONOURED_CONFIG_KEYS` is in `wz-runtime-tokio`; the drop-in leg of
# `wz_reads_a_stock_zenohd_config.rs` carries a hand-written JSON5 config and
# asserts that it names EVERY honoured key. Honouring a key therefore edits a
# fixture in ANOTHER CRATE, and nothing local said so:
#
#   * that leg is `#[ignore]`d behind `target/zenohd/zenohd` and a
#     `--features zenoh-config` demo, so only hosted Layer Z ever runs it;
#   * gate 3 below runs the CHANGED crates' tests, and the two sides live in
#     different crates — so the crate that moved is never the crate that fails;
#   * the unit tests that DO run read the same key list and know nothing about
#     any fixture.
#
# R311y845 moved three keys and redded hosted Layer Z (run 32097227053); y846
# added a fourth and would have redded the same assertion for a second reason.
#
# UNCONDITIONAL, unlike gate 2b. That gate scopes itself because it costs ~6s;
# this one reads two files and costs ~1s, and a scope predicate is one more thing
# that can be silently wrong — a wrong "this push does not touch it" reads
# exactly like a pass. Cheap enough that the ordinary push pays nothing worth
# scoping for.
if ! python3 scripts/lib/config_key_fixture_gate.py; then
    echo "" >&2
    echo "pre-push: config-key/fixture gate FAILED — a honoured key and the" >&2
    echo "          drop-in JSON5 fixture that must name it have drifted." >&2
    echo "          Hosted Layer Z is the only other thing that checks this," >&2
    echo "          and it needs zenohd built." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 2e — the scouting socket's movable axes (R2142, item 225) ──
#
# Which axes of the scouting socket config can move, and which are witnessed
# BOTH-ENDED. Derived from the socket's own surface: the scalar parameters of
# `bind_multicast_v4` plus the `pub` fields of `McastSocketConfig`.
#
# Here for gate 2d's reasons exactly — it reads one file, costs milliseconds, and
# the thing it catches cannot be caught by the changed-crates tests: adding a
# field to that struct compiles everywhere and reds nothing, while silently
# widening the population this repository claims coverage over. UNCONDITIONAL for
# the same reason too: a scope predicate that is wrong reads exactly like a pass.
if ! python3 scripts/lib/scouting_socket_axis_census.py > /dev/null; then
    echo "" >&2
    echo "pre-push: scouting-socket axis census FAILED — a movable axis is" >&2
    echo "          unjudged, a witness it names no longer exists, or the" >&2
    echo "          derivation read an EMPTY population." >&2
    echo "          Run \`python3 scripts/lib/scouting_socket_axis_census.py\`" >&2
    echo "          to see the per-axis breakdown." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 2f — a flag's precondition SET, derived (R2144, item 218) ──
#
# R311y844 found this class by TRIPPING OVER IT: the expansion emitted
# `--scout-timeout-ms` unconditionally, `main` refuses that flag without
# `--scout`, and a valid stock config therefore expanded into a node that
# exits(2). R2140 built the dynamic half — expand each fixture row in three
# shapes, assert the argv carries the partner — and that gate is real.
#
# What it cannot do is judge a rule no shape stages. MEASURED: it stages 3 of
# 11, and the other 8 come back as `skip — no shape emits it`, a sentence that
# lumps "the expansion has no site for that flag" (7 of them, derivable) with
# "it has one and nothing triggered it" (the hole item 218 names).
#
# Here for gate 2d's reasons — both sides are on disk, it reads them in
# milliseconds, and the thing it catches cannot be caught by the changed-crates
# tests: `stock_config_tests` is `#[cfg(feature = "zenoh-config")]`, so gate 3's
# DEFAULT-feature run does not compile the dynamic gate at all. A 25th mapping
# added to `args.rs` reaches origin with no local signal otherwise.
if ! python3 scripts/lib/flag_precondition_gate.py > /dev/null; then
    echo "" >&2
    echo "pre-push: flag-precondition gate FAILED — the expansion emits a flag" >&2
    echo "          the binary refuses without a partner, and the emission site" >&2
    echo "          carries no guard; or an anchor this reader needs is gone." >&2
    echo "          Run \`python3 scripts/lib/flag_precondition_gate.py\` for the" >&2
    echo "          per-site breakdown (\`--verbose\` for every class)." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── housekeeping (NOT a gate) — toolchain-scoped target GC ─────────
#
# R311y445. Deliberately NOT a gate: it never fails the push, and an absent
# cargo-sweep is a silent skip. The `a skip is green` rule this repo enforces
# is about VERIFICATION — a check that cannot read its input must not report
# success — and garbage collection verifies nothing, so blocking a push on it
# would be the wrong trade.
#
# `--installed` is the only sweep form cheap and safe enough to run on every
# push: it keeps every artifact of every still-installed rustup toolchain, so
# the next build is a full cache hit. Measured 2026-07-29 on this repo's 63G
# target: 3.8s for the real sweep (1.1s for --dry-run — quote the real one).
# What it collects is the residue of a toolchain
# that has been REMOVED — which is nothing until you remove one, also measured
# the same day (six toolchains installed, "Would clean: nothing").
#
# It does NOT address feature-combination accumulation, which is what actually
# grows this target (debug/deps alone was 58G). That needs the BUILD mode of
# scripts/gc-build-artifacts.sh wrapped around a FULL run-ci, which is far too
# destructive to run from a hook: it keeps only what the wrapped build touched.
if command -v cargo-sweep >/dev/null 2>&1; then
    bash scripts/gc-build-artifacts.sh --installed || \
        echo "pre-push: target GC skipped (non-fatal)" >&2
fi

# ─── gate 3 — changed-crate tests (default features, fast) ──────────
# Diff range: `diff_base..<local_sha>`, computed above (gate 2b shares it). An
# empty diff_base is a new ref with no remote base — nothing to diff against, so
# skip. Only crates/<name>/ changes map to a test target; everything else is
# hosted-CI-only.
if [[ -z "$diff_base" ]]; then
    echo "pre-push: no diff base (new ref, no origin/main); skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

# ─── gate 5 — the lanes that own the paths OUTSIDE crates/ (R311y793) ──
#
# The rule this hook had only in prose: a round owes the lanes that own the
# FILES it touched. Gates 3 and 4 know `crates/` and nothing else, so a push
# consisting entirely of workflow, script and hook edits — which is what
# R311y791 and R311y792 both were — reached origin with NO local gate at all.
# Every check it could have failed (rustfmt, actionlint over ci.yml, shellcheck
# over scripts/ and .githooks/) lives in Layer 0, which is ~40s.
#
# Placed BEFORE gate 3 on purpose: gates 3 and 4 exit early when a push touches
# no crate, and that early exit is exactly the shape of push this gate exists
# for.
#
# THE MAPPING NAMES ONLY WHAT IS CHEAP, and every path outside it is a decision
# rather than an oversight:
#   - `deploy/**` IS here (R311y794). Layer 0's fmt half covers
#     deploy/zephyr-app/rust, which is a second cargo workspace this hook's
#     `cargo test -p` never reaches — and it has already redded on that path.
#     What it does NOT cover are the MCU demo builds under deploy/mcu-*, owned by
#     Layers G/Q; those need cross toolchains and QEMU and stay hosted-only.
#   - `sources/**` and `out/**` are owned by Layers B/B2 (codegen + regen-diff),
#     which need a built sce-codegen and are minutes, not seconds. Hosted-only.
#   - `runtime/**` appears in CLAUDE.md's SPDX policy and DOES NOT EXIST in this
#     tree (R311y794 checked). Nothing to map.
path_lanes=""
if git diff --name-only "$diff_base..$local_sha" 2>/dev/null |
    grep -qE '^(\.github/workflows/|scripts/|\.githooks/|deploy/)'; then
    path_lanes="0"
fi

if [[ -n "$path_lanes" ]]; then
    echo "pre-push: this push touches workflow / script / hook files — running Layer $path_lanes"
    echo "          (rustfmt + actionlint + shellcheck; the only local gate those paths have)."
    if ! bash scripts/run-ci.sh --layer "$path_lanes"; then
        echo "" >&2
        echo "pre-push: Layer $path_lanes failed — fix before push." >&2
        echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
        exit 1
    fi
fi

# R311y420 — a while-read loop rather than `mapfile`. mapfile is a bash 4.0
# builtin, and stock macOS ships bash 3.2, so this hook could not run there at
# all; scripts/lib/schema-pin-gate.sh already avoids it for the same reason.
# This is the last mapfile in .githooks/. NOT a claim of repo-wide bash 3.2
# support: scripts/verify-codegen.sh still uses six, including `mapfile -d ''`
# forms that are genuinely awkward to express portably, and rewriting a
# working script for a platform nobody has asked for would be the wrong trade.
# The hooks are the part a macOS clone must run before it can commit at all.
changed_dirs=()
while IFS= read -r _d; do
    [[ -n "$_d" ]] && changed_dirs+=("$_d")
done < <(
    git diff --name-only "$diff_base..$local_sha" -- 'crates/' 2>/dev/null \
        | sed -nE 's#^crates/([^/]+)/.*#\1#p' \
        | sort -u
)

if [[ ${#changed_dirs[@]} -eq 0 ]]; then
    echo "pre-push: no crates/ changes in this push; skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

# Map each changed crate DIR to its cargo PACKAGE name (dir != package is
# rare but allowed). A dir whose Cargo.toml is gone (renamed/deleted in the
# diff) is skipped rather than failing the push.
pkgs=()
for d in "${changed_dirs[@]}"; do
    manifest="crates/$d/Cargo.toml"
    if [[ ! -f "$manifest" ]]; then
        echo "pre-push:   crates/$d — Cargo.toml gone (renamed/deleted), skipping"
        continue
    fi
    pkg="$(sed -nE 's/^name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$manifest" | head -1)"
    [[ -n "$pkg" ]] && pkgs+=("$pkg")
done

if [[ ${#pkgs[@]} -eq 0 ]]; then
    echo "pre-push: no live changed crates to test; full validation runs on hosted CI."
    exit 0
fi

echo "pre-push: testing changed crates only (default features): ${pkgs[*]}"
echo "          feature-matrix / clippy / footprint / cross-compile / interop -> hosted CI."
# ROUTED THROUGH THE BUILD-MACHINE WRAPPER WHEN ONE IS CONFIGURED (`$BX`),
# because this loop is the heaviest thing this hook does to the machine it runs
# on: one full `cargo test` per changed crate, serially.
#
# MEASURED 2026-08-20, and the finding is about the FLEET rather than this gate.
# 81 build runs were placed across six repositories in thirty minutes, and not
# one process tree under a git hook reached the wrapper — every heavy command a
# hook launches, it launches itself. So this workstation sat at load 33 on 32
# cores with 11GB in swap while three build machines idled at 0.11, 1.00 and
# 0.00. One of the two things loading it at that moment was this very hook,
# mid-push. The wrapper cannot place work it is never handed.
#
# `$BX` IS AN OPT-IN AND ITS ABSENCE IS THE OLD BEHAVIOUR. No host, path or
# account is named in this tree — those belong to a machine, not to a public
# repository — so a checkout without it runs the loop here, exactly as before.
#
# ⚠ THE WRAPPER'S OWN VERDICT IS FINAL — no second fallback. It already fails
# open by itself: with no build machine available and room here, it runs the
# command here and says so. It refuses only when it cannot proceed safely (an
# untracked file it does not carry, a far side that does not match), and each of
# those is the author's to fix. A refusal is a verdict, not an outage; re-running
# the gate locally to paper over one is how a hook reports green about a tree
# nobody checked.
#
# ⚠ `cd crates` IS KEPT. This workspace's manifest is `crates/Cargo.toml`, and
# the wrapper resolves its run directory from the manifest at or above where it
# is invoked — so calling it from inside the subshell puts the remote run in the
# same directory the local one uses. The repository root is still what gets
# synced; only the run directory differs.
fail=0
for pkg in "${pkgs[@]}"; do
    echo "pre-push:   cargo test -p $pkg ..."
    if [[ -n "${BX:-}" && -x "${BX}" ]]; then
        pkg_run=("${BX}" --label "pre-push-$pkg" -- cargo test -p "$pkg" --quiet)
    else
        pkg_run=(cargo test -p "$pkg" --quiet)
    fi
    if ! (cd crates && "${pkg_run[@]}"); then
        echo "pre-push:   $pkg tests FAILED" >&2
        fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "" >&2
    echo "pre-push: changed-crate tests failed — fix before push." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

echo "pre-push: changed-crate tests passed."

# ─── gate 4 — changed-crate DOC LINKS (R311y792) ────────────────────
# The rule this encodes: a round that writes a doc comment owes Layer C1bz.
# Nothing said so, and the class has now been paid for TWICE — R311y787 fixed
# doc links it had just added, and R311y790 added two more (a link to a private
# helper and one to a cfg-gated method), which redded run 31732246052 and cost
# R311y791 a whole repayment round.
#
# It belongs HERE and not on the hosted side because the hosted gate already
# existed and already worked. What was missing is that nothing local ran it, and
# this hook had already computed the exact crate set it needs — the same `pkgs`
# gate 3 just tested. `WZ_C1BZ_ONLY` spends one `cargo doc -p` per changed crate
# (~6s for a small one) instead of the ~2min full sweep.
#
# It reuses the LANE rather than re-deriving the budget: the budget numbers are
# the lane's, and a second copy here would drift from them the first time one
# moved. That is the same reason gate 2 shells out to `mnemosyne-cli` instead of
# reading the store.
#
# R311y793/y794 — the set is EXPANDED to the crates whose docs link INTO a
# changed one, which is the half y792 left open and named. A public item renamed
# in wz-session-core breaks a doc link wherever it is written, and those files
# live in crates this push never touched — so measuring only the changed crate
# measures the one that is still fine.
#
# BOTH LINK SPELLINGS, and the second is the larger: `[wz_session_core::Foo]` is
# ~250 sites, while `[Foo]` resolved through a `use wz_session_core::Foo` is 304
# over 35 crate pairs. They disagree on the crate SET — wz-session-core is linked
# from 14 crates by the first and 18 by the union — so y793's qualified-only
# expander measured 14 of 18 and reported clean over the rest.
doc_pkgs=()
while IFS= read -r _p; do
    [[ -n "$_p" ]] && doc_pkgs+=("$_p")
done < <(python3 scripts/lib/doclink_dependents.py "${pkgs[@]}")
if [[ ${#doc_pkgs[@]} -eq 0 ]]; then
    echo "pre-push: doc-link expansion produced NO crate — refusing to report clean." >&2
    exit 1
fi

echo "pre-push: checking doc links (Layer C1bz, subset): ${doc_pkgs[*]}"
if ! WZ_C1BZ_ONLY="${doc_pkgs[*]}" bash scripts/run-ci.sh --layer C1bz; then
    echo "" >&2
    echo "pre-push: changed-crate doc links failed — fix before push." >&2
    echo "          A count ABOVE budget is a link this push added: fix the link," >&2
    echo "          do not raise the budget. A count BELOW it is a link this push" >&2
    echo "          removed: lower the budget in this same commit." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 6 — changed-crate REDUCED FEATURE COMBINATION (R311y821) ──
# The rule this encodes: a round that edits a crate owes the SHRUNKEN build of
# it, not only the default one. `cargo clippy --all-features` cannot see a
# cfg-gated import behind an ungated signature — the feature is on — and the
# crate's own default-feature test run cannot either.
#
# The class fired TWICE. R311y809 was caught only because gate 4 above happened
# to build a LINKING crate in a different combination, so detection existed as
# another gate's side effect; R311y811 had no such accident and reached origin,
# where a keyexpr lane (Layer C1o) turned out to be the only host lane that
# compiles that crate's lib tests bare.
#
# It reuses the SAME `pkgs` set gate 3 tested, and the same script Layer C1cf
# sweeps with — the tier lists live there, so a crate cannot be excluded here
# and included on the hosted side. R311y821 MEASURED the cost the debt recorded
# as unknown: 49 of 53 members are already clean bare, so this is seconds per
# changed crate rather than the sweep's ~2min.
echo "pre-push: reduced feature combination (Layer C1cf, subset): ${pkgs[*]}"
if ! bash scripts/lib/reduced-features-gate.sh "${pkgs[@]}"; then
    echo "" >&2
    echo "pre-push: a changed crate does not build with its default features" >&2
    echo "          off — fix the reduced combination, or place the crate in a" >&2
    echo "          named tier in scripts/lib/reduced-features-gate.sh." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 7 — changed-crate NON-DEFAULT FEATURE COMPILATION (R2133) ──
# The mirror of gate 6, and the one that closes unregistered item 176. Gate 6
# asks whether a changed crate survives its defaults being OFF; nothing asked
# whether the code behind a feature that is off BY DEFAULT reaches rustc at
# all. It does not: gate 3 above is `cargo test -p <pkg>` with default
# features, so a crate's non-default modules are never compiled locally.
#
# This gate belongs at PUSH time specifically, because that is where the class
# has landed every time. R2095 added a `PeerOpts` field and missed two
# `cfg(all(test, routing-peer, quic))` fixtures; R2112 added another field and
# missed the SAME two, and that break was still in the tree when R2133 wrote
# this — found by the sweep, not by a person. Both reached origin.
#
# Cost, measured rather than assumed: the full sweep is ~126s over 19 crates,
# so a push touching one is seconds. Crates with no non-default feature are
# skipped by the script's own derivation and cost nothing.
echo "pre-push: non-default feature compilation (Layer C1cn, subset): ${pkgs[*]}"
if ! bash scripts/lib/nondefault-features-gate.sh "${pkgs[@]}"; then
    echo "" >&2
    echo "pre-push: a changed crate does not COMPILE with its non-default" >&2
    echo "          features on — this is code no other local gate hands to" >&2
    echo "          rustc, so fix it, or place the crate in a named tier in" >&2
    echo "          scripts/lib/nondefault-features-gate.sh and say why." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 8 — the WORKSPACE still TYPE-CHECKS (R2134) ───────────────
# Unregistered item 475, and the one blind spot none of the gates above can
# cover by construction: every one of them is scoped to the crates the push
# CHANGED, and this class breaks a crate the push did not touch. Widen a public
# struct in a core crate and the initializer in a dependent stops compiling.
#
# Measured twice on the same struct: R311y857 added a field to
# `wz_analyze::Request` and left `wz-replay` behind, and R2001 did it again with
# `csv` — hosted Layer C1 died on `error[E0063]` both times. The second session
# was reading a paragraph inside that very initializer which explained the first
# occurrence. A comment is not a gate.
#
# `check`, not `test`: the failure shape is a COMPILE error, so the instrument
# measures the same thing that breaks — and this is why the gate does not
# contradict R311y386's ratification of pre-push as a fast gate rather than a CI
# mirror. That ratification is about not running the test suite.
#
# Cost, measured: 41s clean on the build machine. The four exclusions are READ
# out of Layer C1 rather than copied, so this cannot go stale when that list
# moves — item 475 itself cited a `run-ci.sh` line range that had already
# drifted to a different layer by the time it was repaid.
echo "pre-push: workspace type-check (open-debt item 475)"
if ! bash scripts/lib/workspace-check-gate.sh; then
    echo "" >&2
    echo "pre-push: the workspace no longer type-checks — a crate this push" >&2
    echo "          did NOT change has stopped compiling. Every other gate" >&2
    echo "          here is scoped to the changed crates and structurally" >&2
    echo "          cannot see this." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

echo "pre-push: changed-crate tests + doc links + reduced + non-default features + workspace check passed; full validation continues on hosted CI."
exit 0
