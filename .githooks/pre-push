# R311y445. Deliberately NOT a gate: it never fails the push, and an absent
# cargo-sweep is a silent skip. The `a skip is green` rule this repo enforces
# is about VERIFICATION — a check that cannot read its input must not report
# success — and garbage collection verifies nothing, so blocking a push on it
# would be the wrong trade.
#
# `--installed` is the only sweep form cheap and safe enough to run on every
# push: it keeps every artifact of every still-installed rustup toolchain, so
# the next build is a full cache hit. Measured 2026-07-29 on this repo's 63G
# target: 3.8s for the real sweep (1.1s for --dry-run — quote the real one).
# What it collects is the residue of a toolchain
# that has been REMOVED — which is nothing until you remove one, also measured
# the same day (six toolchains installed, "Would clean: nothing").
#
# It does NOT address feature-combination accumulation, which is what actually
# grows this target (debug/deps alone was 58G). That needs the BUILD mode of
# scripts/gc-build-artifacts.sh wrapped around a FULL run-ci, which is far too
# destructive to run from a hook: it keeps only what the wrapped build touched.
if command -v cargo-sweep >/dev/null 2>&1; then
    bash scripts/gc-build-artifacts.sh --installed || \
        echo "pre-push: target GC skipped (non-fatal)" >&2
fi

# ─── the diff-base precondition, hoisted (guards gates 5 and 3) ─────
#
# R2284 (open-debt item 622, condition 0) — LABEL ONLY, no behaviour changed.
# This block carried the `gate 3` header, and it is not gate 3: it is the
# precondition BOTH gate 5 and gate 3's body need, which is why it sits above
# gate 5 while gate 3's own code sits below it. The header made the section
# boundaries untrue — gate 3 appeared to own five lines and no refusal, and
# gate 5 appeared to own two gates' worth. `hook_gate_boundary_gate.py` refuses
# that arrangement now: a `gate N` section that owns no `exit 1` is a header
# whose gate lives somewhere else.
#
# Diff range: `diff_base..<local_sha>`, computed above (gate 2b shares it). An
# empty diff_base is a new ref with no remote base — nothing to diff against, so
# skip. Only crates/<name>/ changes map to a test target; everything else is
# hosted-CI-only.
if [[ -z "$diff_base" ]]; then
    echo "pre-push: no diff base (new ref, no origin/main); skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

# ─── gate 5 — the lanes that own the paths OUTSIDE crates/ (R311y793) ──
# grades: worktree
#
# The rule this hook had only in prose: a round owes the lanes that own the
# FILES it touched. Gates 3 and 4 know `crates/` and nothing else, so a push
# consisting entirely of workflow, script and hook edits — which is what
# R311y791 and R311y792 both were — reached origin with NO local gate at all.
# Every check it could have failed (rustfmt, actionlint over ci.yml, shellcheck
# over scripts/ and .githooks/) lives in Layer 0, which is ~40s.
#
# Placed BEFORE gate 3 on purpose: gates 3 and 4 exit early when a push touches
# no crate, and that early exit is exactly the shape of push this gate exists
# for.
#
# THE MAPPING NAMES ONLY WHAT IS CHEAP, and every path outside it is a decision
# rather than an oversight:
#   - `deploy/**` IS here (R311y794). Layer 0's fmt half covers
#     deploy/zephyr-app/rust, which is a second cargo workspace this hook's
#     `cargo test -p` never reaches — and it has already redded on that path.
#     What it does NOT cover are the MCU demo builds under deploy/mcu-*, owned by
#     Layers G/Q; those need cross toolchains and QEMU and stay hosted-only.
#   - `sources/**` and `out/**` are owned by Layers B/B2 (codegen + regen-diff),
#     which need a built sce-codegen and are minutes, not seconds. Hosted-only.
#   - `runtime/**` appears in CLAUDE.md's SPDX policy and DOES NOT EXIST in this
#     tree (R311y794 checked). Nothing to map.
path_lanes=""
if git diff --name-only "$diff_base..$local_sha" 2>/dev/null |
    grep -qE '^(\.github/workflows/|scripts/|\.githooks/|deploy/)'; then
    path_lanes="0"
fi

if [[ -n "$path_lanes" ]]; then
    echo "pre-push: this push touches workflow / script / hook files — running Layer $path_lanes"
    echo "          (rustfmt + actionlint + shellcheck; the only local gate those paths have)."
    if ! bash scripts/run-ci.sh --layer "$path_lanes"; then
        echo "" >&2
        echo "pre-push: [gate 5] Layer $path_lanes failed — fix before push." >&2
        echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
        exit 1
    fi
fi

# R311y420 — a while-read loop rather than `mapfile`. mapfile is a bash 4.0
# builtin, and stock macOS ships bash 3.2, so this hook could not run there at
# all; scripts/lib/schema-pin-gate.sh already avoids it for the same reason.
# This is the last mapfile in .githooks/. NOT a claim of repo-wide bash 3.2
# support: scripts/verify-codegen.sh still uses six, including `mapfile -d ''`
# forms that are genuinely awkward to express portably, and rewriting a
# working script for a platform nobody has asked for would be the wrong trade.
# The hooks are the part a macOS clone must run before it can commit at all.

# ─── gate 3 — changed-crate tests (default features, fast) ──────────
# grades: worktree
#
# R2284 moved this header DOWN to the code it names; the precondition it used
# to sit above is labelled as one. Gate 5 is deliberately between the two —
# "Placed BEFORE gate 3 on purpose", as its own header says, because the
# no-crates early exit below is exactly the push shape gate 5 exists for.
changed_dirs=()
while IFS= read -r _d; do
    [[ -n "$_d" ]] && changed_dirs+=("$_d")
done < <(
    git diff --name-only "$diff_base..$local_sha" -- 'crates/' 2>/dev/null \
        | sed -nE 's#^crates/([^/]+)/.*#\1#p' \
        | sort -u
)

if [[ ${#changed_dirs[@]} -eq 0 ]]; then
    echo "pre-push: no crates/ changes in this push; skipping changed-crate tests."
    echo "          full validation runs on hosted CI."
    exit 0
fi

# Map each changed crate DIR to its cargo PACKAGE name (dir != package is
# rare but allowed). A dir whose Cargo.toml is gone (renamed/deleted in the
# diff) is skipped rather than failing the push.
pkgs=()
for d in "${changed_dirs[@]}"; do
    manifest="crates/$d/Cargo.toml"
    if [[ ! -f "$manifest" ]]; then
        echo "pre-push:   crates/$d — Cargo.toml gone (renamed/deleted), skipping"
        continue
    fi
    pkg="$(sed -nE 's/^name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$manifest" | head -1)"
    [[ -n "$pkg" ]] && pkgs+=("$pkg")
done

if [[ ${#pkgs[@]} -eq 0 ]]; then
    echo "pre-push: no live changed crates to test; full validation runs on hosted CI."
    exit 0
fi

echo "pre-push: testing changed crates only (default features): ${pkgs[*]}"
echo "          feature-matrix / clippy / footprint / cross-compile / interop -> hosted CI."
# ROUTED THROUGH THE BUILD-MACHINE WRAPPER WHEN ONE IS CONFIGURED (`$BX`),
# because this loop is the heaviest thing this hook does to the machine it runs
# on: one full `cargo test` per changed crate, serially.
#
# MEASURED 2026-08-20, and the finding is about the FLEET rather than this gate.
# 81 build runs were placed across six repositories in thirty minutes, and not
# one process tree under a git hook reached the wrapper — every heavy command a
# hook launches, it launches itself. So this workstation sat at load 33 on 32
# cores with 11GB in swap while three build machines idled at 0.11, 1.00 and
# 0.00. One of the two things loading it at that moment was this very hook,
# mid-push. The wrapper cannot place work it is never handed.
#
# `$BX` IS AN OPT-IN AND ITS ABSENCE IS THE OLD BEHAVIOUR. No host, path or
# account is named in this tree — those belong to a machine, not to a public
# repository — so a checkout without it runs the loop here, exactly as before.
#
# ⚠ THE WRAPPER'S OWN VERDICT IS FINAL — no second fallback. It already fails
# open by itself: with no build machine available and room here, it runs the
# command here and says so. It refuses only when it cannot proceed safely (an
# untracked file it does not carry, a far side that does not match), and each of
# those is the author's to fix. A refusal is a verdict, not an outage; re-running
# the gate locally to paper over one is how a hook reports green about a tree
# nobody checked.
#
# ⚠ `cd crates` IS KEPT. This workspace's manifest is `crates/Cargo.toml`, and
# the wrapper resolves its run directory from the manifest at or above where it
# is invoked — so calling it from inside the subshell puts the remote run in the
# same directory the local one uses. The repository root is still what gets
# synced; only the run directory differs.
fail=0
for pkg in "${pkgs[@]}"; do
    echo "pre-push:   cargo test -p $pkg ..."
    if [[ -n "${BX:-}" && -x "${BX}" ]]; then
        pkg_run=("${BX}" --label "pre-push-$pkg" -- cargo test -p "$pkg" --quiet)
    else
        pkg_run=(cargo test -p "$pkg" --quiet)
    fi
    if ! (cd crates && "${pkg_run[@]}"); then
        echo "pre-push:   $pkg tests FAILED" >&2
        fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "" >&2
    echo "pre-push: [gate 3] changed-crate tests failed — fix before push." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

echo "pre-push: changed-crate tests passed."

# ─── gate 4 — changed-crate DOC LINKS (R311y792) ────────────────────
# grades: worktree
# The rule this encodes: a round that writes a doc comment owes Layer C1bz.
# Nothing said so, and the class has now been paid for TWICE — R311y787 fixed
# doc links it had just added, and R311y790 added two more (a link to a private
# helper and one to a cfg-gated method), which redded run 31732246052 and cost
# R311y791 a whole repayment round.
#
# It belongs HERE and not on the hosted side because the hosted gate already
# existed and already worked. What was missing is that nothing local ran it, and
# this hook had already computed the exact crate set it needs — the same `pkgs`
# gate 3 just tested. `WZ_C1BZ_ONLY` spends one `cargo doc -p` per changed crate
# (~6s for a small one) instead of the ~2min full sweep.
#
# It reuses the LANE rather than re-deriving the budget: the budget numbers are
# the lane's, and a second copy here would drift from them the first time one
# moved. That is the same reason gate 2 shells out to `mnemosyne-cli` instead of
# reading the store.
#
# R311y793/y794 — the set is EXPANDED to the crates whose docs link INTO a
# changed one, which is the half y792 left open and named. A public item renamed
# in wz-session-core breaks a doc link wherever it is written, and those files
# live in crates this push never touched — so measuring only the changed crate
# measures the one that is still fine.
#
# BOTH LINK SPELLINGS, and the second is the larger: `[wz_session_core::Foo]` is
# ~250 sites, while `[Foo]` resolved through a `use wz_session_core::Foo` is 304
# over 35 crate pairs. They disagree on the crate SET — wz-session-core is linked
# from 14 crates by the first and 18 by the union — so y793's qualified-only
# expander measured 14 of 18 and reported clean over the rest.
doc_pkgs=()
while IFS= read -r _p; do
    [[ -n "$_p" ]] && doc_pkgs+=("$_p")
done < <(python3 scripts/lib/doclink_dependents.py "${pkgs[@]}")
if [[ ${#doc_pkgs[@]} -eq 0 ]]; then
    echo "pre-push: [gate 4] doc-link expansion produced NO crate — refusing to report clean." >&2
    exit 1
fi

echo "pre-push: checking doc links (Layer C1bz, subset): ${doc_pkgs[*]}"
if ! WZ_C1BZ_ONLY="${doc_pkgs[*]}" bash scripts/run-ci.sh --layer C1bz; then
    echo "" >&2
    echo "pre-push: [gate 4] changed-crate doc links failed — fix before push." >&2
    echo "          A count ABOVE budget is a link this push added: fix the link," >&2
    echo "          do not raise the budget. A count BELOW it is a link this push" >&2
    echo "          removed: lower the budget in this same commit." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 4b — the COUNT GUARDS this push's test set moves (R2167) ───
# grades: worktree
# Gate 4's argument, applied to a different constant. `run-ci.sh` asserts an
# exact `test result: ok. N passed` for 291 commands, and the number is written
# by hand at the moment a test is added — the one moment nothing local reads it.
#
# `count_guard_lint.py` reads the derivable ones off disk and has since
# R311y569. It declares 189 of the 291 OUT OF SCOPE with a reason each, because
# a count that depends on `#[cfg]` is not derivable without a build. That list
# is honest and it is also the hole: `C1AY stock_config_tests` sits in it and
# has now leaked THREE TIMES — R2112 (red until R2117 found it doing something
# else), R2124 (cost R2129 a round), and R2166, which redded run 33132637389 on
# the same push and cost this one. Each round wrote the reason into a comment
# beside the guard; R2124's comment quotes R2117's. A memo is not a mechanism.
#
# So this RUNS them, and pays only when the push could have moved a count:
# the package must be one gate 3 already tested, the diff must add or remove an
# attribute or `mod` line that changes which tests EXIST (a body edit cannot),
# the guard's selection must reach a changed file, and its filter must occur in
# one. MEASURED on R2166's own commit: 3 of the 17 guards naming `wz-ap-demo`,
# where the whole C1ay lane is 175s.
#
# It reuses `count_guard_lint`'s parser rather than carrying a second one, for
# the reason gate 4 reuses the lane: two readings of one table drift the day
# either moves, which is this gate's own subject one level up.
echo "pre-push: checking the count guards this push's test set moves (gate 4b)"
if ! BX="${BX:-}" python3 scripts/lib/guarded_count_gate.py \
    --range "$diff_base..$local_sha"; then
    echo "" >&2
    echo "pre-push: [gate 4b] a run-ci count guard disagrees with the tests this push" >&2
    echo "          leaves behind. Move the constant IN THIS COMMIT, to what" >&2
    echo "          the command PRINTED — the module's other cases are" >&2
    echo "          \`#[cfg]\`-gated, so counting the diff has produced the" >&2
    echo "          wrong number before." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 6 — changed-crate REDUCED FEATURE COMBINATION (R311y821) ──
# grades: worktree
# The rule this encodes: a round that edits a crate owes the SHRUNKEN build of
# it, not only the default one. `cargo clippy --all-features` cannot see a
# cfg-gated import behind an ungated signature — the feature is on — and the
# crate's own default-feature test run cannot either.
#
# The class fired TWICE. R311y809 was caught only because gate 4 above happened
# to build a LINKING crate in a different combination, so detection existed as
# another gate's side effect; R311y811 had no such accident and reached origin,
# where a keyexpr lane (Layer C1o) turned out to be the only host lane that
# compiles that crate's lib tests bare.
#
# It reuses the SAME `pkgs` set gate 3 tested, and the same script Layer C1cf
# sweeps with — the tier lists live there, so a crate cannot be excluded here
# and included on the hosted side. R311y821 MEASURED the cost the debt recorded
# as unknown: 49 of 53 members are already clean bare, so this is seconds per
# changed crate rather than the sweep's ~2min.
echo "pre-push: reduced feature combination (Layer C1cf, subset): ${pkgs[*]}"
if ! bash scripts/lib/reduced-features-gate.sh "${pkgs[@]}"; then
    echo "" >&2
    echo "pre-push: [gate 6] a changed crate does not build with its default features" >&2
    echo "          off — fix the reduced combination, or place the crate in a" >&2
    echo "          named tier in scripts/lib/reduced-features-gate.sh." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 7 — changed-crate NON-DEFAULT FEATURE JUDGEMENT (R2133, ────
# grades: worktree
#              widened to clippy by R2243)
# The mirror of gate 6, and the one that closes unregistered item 176. Gate 6
# asks whether a changed crate survives its defaults being OFF; nothing asked
# whether the code behind a feature that is off BY DEFAULT reaches rustc at
# all. It does not: gate 3 above is `cargo test -p <pkg>` with default
# features, so a crate's non-default modules are never compiled locally.
#
# This gate belongs at PUSH time specifically, because that is where the class
# has landed every time. R2095 added a `PeerOpts` field and missed two
# `cfg(all(test, routing-peer, quic))` fixtures; R2112 added another field and
# missed the SAME two, and that break was still in the tree when R2133 wrote
# this — found by the sweep, not by a person. Both reached origin.
#
# ⚠ R2243 MOVED IT FROM `cargo check` TO `cargo clippy … -- -D warnings`, and
# the reason is a measurement, not a preference. Hosted run 33468082489 was red
# in EIGHT jobs and FIVE of them were TWO clippy lines in non-default code —
# one const in wz-session-core, one loop in wz-runtime-tokio. Every lane that
# lints such code is hosted, so both crates were pushed green by this hook and
# failed five jobs away. The blind spot was never "rustc has not seen it"; it
# is "nothing local has JUDGED it", and hosted judges with `-D warnings`.
# clippy is rustc plus lints, so R2133's compile-error class is unchanged.
#
# Cost, measured rather than assumed: the full sweep is 217s over 19 crates
# (126s when it was `check`), so a push touching one is seconds. Crates with no
# non-default feature are skipped by the script's own derivation and cost
# nothing.
echo "pre-push: non-default feature clippy (Layer C1cn, subset): ${pkgs[*]}"
if ! bash scripts/lib/nondefault-features-gate.sh "${pkgs[@]}"; then
    echo "" >&2
    echo "pre-push: [gate 7] a changed crate is not CLEAN with its non-default" >&2
    echo "          features on — this is code no other local gate judges" >&2
    echo "          (gate 3 is default features and runs no clippy), so fix" >&2
    echo "          it, or place the crate in a named tier in" >&2
    echo "          scripts/lib/nondefault-features-gate.sh and say why." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

# ─── gate 8 — the WORKSPACE still TYPE-CHECKS (R2134) ───────────────
# grades: worktree
# Unregistered item 475, and the one blind spot none of the gates above can
# cover by construction: every one of them is scoped to the crates the push
# CHANGED, and this class breaks a crate the push did not touch. Widen a public
# struct in a core crate and the initializer in a dependent stops compiling.
#
# Measured twice on the same struct: R311y857 added a field to
# `wz_analyze::Request` and left `wz-replay` behind, and R2001 did it again with
# `csv` — hosted Layer C1 died on `error[E0063]` both times. The second session
# was reading a paragraph inside that very initializer which explained the first
# occurrence. A comment is not a gate.
#
# `check`, not `test`: the failure shape is a COMPILE error, so the instrument
# measures the same thing that breaks — and this is why the gate does not
# contradict R311y386's ratification of pre-push as a fast gate rather than a CI
# mirror. That ratification is about not running the test suite.
#
# Cost, measured: 41s clean on the build machine. The four exclusions are READ
# out of Layer C1 rather than copied, so this cannot go stale when that list
# moves — item 475 itself cited a `run-ci.sh` line range that had already
# drifted to a different layer by the time it was repaid.
echo "pre-push: workspace type-check (open-debt item 475)"
if ! bash scripts/lib/workspace-check-gate.sh; then
    echo "" >&2
    echo "pre-push: [gate 8] the workspace no longer type-checks — a crate this push" >&2
    echo "          did NOT change has stopped compiling. Every other gate" >&2
    echo "          here is scoped to the changed crates and structurally" >&2
    echo "          cannot see this." >&2
    echo "          Bypass with \`git push --no-verify\` only for genuine hotfixes." >&2
    exit 1
fi

echo "pre-push: changed-crate tests + doc links + reduced + non-default features + workspace check passed; full validation continues on hosted CI."
exit 0
