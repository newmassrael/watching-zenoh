[submodule "vendor/sce"]
	path = vendor/sce
	url = https://github.com/newmassrael/scxml-core-engine.git
[submodule "vendor/zenoh-pico"]
	path = vendor/zenoh-pico
	url = https://github.com/eclipse-zenoh/zenoh-pico
[submodule "vendor/lwip"]
	path = vendor/lwip
	url = https://github.com/lwip-tcpip/lwip
[submodule "vendor/freertos-kernel"]
	path = vendor/freertos-kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel
[submodule "vendor/mbedtls"]
	path = vendor/mbedtls
	url = https://github.com/zephyrproject-rtos/mbedtls
[submodule "vendor/tf-psa-crypto"]
	path = vendor/tf-psa-crypto
	url = https://github.com/zephyrproject-rtos/tf-psa-crypto
