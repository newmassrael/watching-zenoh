# GENERATED from deploy/wz-config.toml by scripts/lib/wz_config.py --emit kconfig-policies.
# Do not edit: `wz_config.py --check` fails when this file is stale.

menu "wz policies"

comment "Each policy is behaviour beyond upstream; the default of every one is upstream's."

choice WZ_POLICY_MULTICAST_LOOPBACK
	prompt "multicast-loopback"
	default WZ_POLICY_MULTICAST_LOOPBACK_OS_DEFAULT
	help
	  Whether a datagram a node sends to a multicast group is also delivered to
	  members of that group on the same host. `os-default` leaves the operating
	  system's setting alone. `on` and `off` set it on every multicast socket the
	  node opens: `on` is for nodes that share a host and must hear one another,
	  `off` for a node that must not hear its own host's traffic.
	  Upstream: Never sets IP_MULTICAST_LOOP on a multicast socket, so each sending
	  socket keeps the operating system's setting.

config WZ_POLICY_MULTICAST_LOOPBACK_OS_DEFAULT
	bool "os-default"

config WZ_POLICY_MULTICAST_LOOPBACK_ON
	bool "on"

config WZ_POLICY_MULTICAST_LOOPBACK_OFF
	bool "off"

endchoice

config WZ_POLICY_TX_NO_PROGRESS_DEADLINE
	bool "tx-no-progress-deadline"
	default n
	help
	  Whether a blocking message gets a second bound beside its total wait: the
	  wait with no progress. Off, only the total wait bounds it. On, it is also
	  given up when TX_NO_PROGRESS_WINDOW_US passes with no fragment out, and the
	  total wait still ends it, whichever comes first. A fragment out is progress
	  and starts the window again, and the total wait is never made longer.
	  Upstream: Gives a blocking message one wait_before_close for the whole of it,
	  however many fragments go out: its deadline has no cap to extend by, so a
	  fragment out leaves the deadline where it is.

config WZ_POLICY_TX_EXPIRY_KEEPS_SESSION
	bool "tx-expiry-keeps-session"
	default n
	help
	  What happens when a blocking message finds no room within its deadline. Off,
	  the session is closed as unresponsive and the send reports success. On, the
	  message is dropped, the send reports that the transport was not available,
	  and the session stays open: a slow link costs the message and not the
	  session. A multicast group never closes either way.
	  Upstream: Closes the session as unresponsive when a blocking message found no
	  room in its deadline, and tells the sender nothing.

config WZ_POLICY_DECLARATION_SYNC_PACING
	bool "declaration-sync-pacing"
	default n
	help
	  How a node tells a peer its declarations again after a reconnect. Off, all of
	  them are sent at once. On, they are sent in turns of
	  DECLARATION_SYNC_BURST_MESSAGES with DECLARATION_SYNC_INTERVAL_MS between
	  turns, and the session is served during the waits, so a node with many
	  declarations does not hand its peer a burst or stop answering while it sends
	  them. A declaration made while the replay runs is sent in its turn, after
	  everything it depends on; the retraction of one the peer was never told of
	  sends nothing.
	  Upstream: Replays every declaration it holds to a new peer in one call, as
	  soon as the session is open again.

config WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN
	bool "entity-timestamp-opt-in"
	default n
	help
	  What an entity does with a timestamp when its declaration says nothing. Off,
	  a subscriber and a querier see the timestamp of what they receive, and any
	  publisher attaches the timestamp it is given. On, an entity takes part only
	  if it was declared to: a subscriber or a querier sees no timestamp unless it
	  asks to, and a publisher refuses a timestamped put unless it was declared to
	  stamp. Each declaration can still state its own choice either way; this sets
	  the default for the ones that do not. A publisher given a time supplies its
	  own node identity, so a caller cannot sign a sample as another node.
	  Upstream: Hands every received sample's timestamp to the subscriber and every
	  reply's to the querier, and lets any publisher attach the timestamp it is
	  given.

choice WZ_POLICY_SUBSCRIBER_OVERLOAD
	prompt "subscriber-overload"
	default WZ_POLICY_SUBSCRIBER_OVERLOAD_BLOCK
	help
	  What a subscriber whose callback runs off the receive path does when its
	  delivery lane is full and its declaration says nothing. `block` makes the
	  session wait for room, outside the lock the receive path holds, so the
	  transport's own backpressure is the flow control and no sample is lost.
	  `reject` refuses the sample at once: the receive path is never held, the sample
	  is lost, and it is counted by reason and by whether it was sent reliably. A
	  sample longer than the whole lane can never wait for room, so it is refused
	  either way. Each declaration can still state its own choice; this sets the
	  default for the ones that do not.
	  Upstream: Hands a sample to a channel handler that blocks its sender when the
	  handler is full, so a slow consumer applies backpressure into the session and
	  no sample is lost.

config WZ_POLICY_SUBSCRIBER_OVERLOAD_BLOCK
	bool "block"

config WZ_POLICY_SUBSCRIBER_OVERLOAD_REJECT
	bool "reject"

endchoice

endmenu
