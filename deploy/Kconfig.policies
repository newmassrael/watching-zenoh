menu "wz policies"

comment "Each policy is behaviour beyond upstream; the default of every one is upstream's."

choice WZ_POLICY_MULTICAST_LOOPBACK
	prompt "multicast-loopback"
	default WZ_POLICY_MULTICAST_LOOPBACK_OS_DEFAULT
	help
	  Whether a datagram a node sends to a multicast group is also delivered to
	  members of that group on the same host. `os-default` leaves the operating
	  system's setting alone. `on` and `off` set it on every multicast socket the
	  node opens: `on` is for nodes that share a host and must hear one another,
	  `off` for a node that must not hear its own host's traffic.
	  Upstream: Never sets IP_MULTICAST_LOOP on a multicast socket, so each sending
	  socket keeps the operating system's setting.

config WZ_POLICY_MULTICAST_LOOPBACK_OS_DEFAULT
	bool "os-default"

config WZ_POLICY_MULTICAST_LOOPBACK_ON
	bool "on"

config WZ_POLICY_MULTICAST_LOOPBACK_OFF
	bool "off"

endchoice

config WZ_POLICY_MULTICAST_LOOPBACK_ALLOWS_OS_DEFAULT
	bool "multicast-loopback allows os-default" if !WZ_POLICY_MULTICAST_LOOPBACK_OS_DEFAULT
	default y
	help
	  Whether `os-default` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTICAST_LOOPBACK_ALLOWS_ON
	bool "multicast-loopback allows on" if !WZ_POLICY_MULTICAST_LOOPBACK_ON
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTICAST_LOOPBACK_ALLOWS_OFF
	bool "multicast-loopback allows off" if !WZ_POLICY_MULTICAST_LOOPBACK_OFF
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TX_NO_PROGRESS_DEADLINE
	bool "tx-no-progress-deadline"
	default n
	help
	  Whether a blocking message gets a second bound beside its total wait: the
	  wait with no progress. Off, only the total wait bounds it. On, it is also
	  given up when TX_NO_PROGRESS_WINDOW_US passes with no fragment out, and the
	  total wait still ends it, whichever comes first. A fragment out is progress
	  and starts the window again, and the total wait is never made longer.
	  Upstream: Gives a blocking message one wait_before_close for the whole of it,
	  however many fragments go out: its deadline has no cap to extend by, so a
	  fragment out leaves the deadline where it is.

config WZ_POLICY_TX_NO_PROGRESS_DEADLINE_ALLOWS_OFF
	bool "tx-no-progress-deadline allows off" if WZ_POLICY_TX_NO_PROGRESS_DEADLINE
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TX_NO_PROGRESS_DEADLINE_ALLOWS_ON
	bool "tx-no-progress-deadline allows on" if !WZ_POLICY_TX_NO_PROGRESS_DEADLINE
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TX_EXPIRY_KEEPS_SESSION
	bool "tx-expiry-keeps-session"
	default n
	help
	  What happens when a blocking message finds no room within its deadline. Off,
	  the session is closed as unresponsive and the send reports success. On, the
	  message is dropped, the send reports that the transport was not available,
	  and the session stays open: a slow link costs the message and not the
	  session. A link that stays blocked is closed after TX_EXPIRY_CLOSE_AFTER such
	  messages in a row, when that limit is not 0. A multicast group never closes
	  either way.
	  Upstream: Closes the session as unresponsive when a blocking message found no
	  room in its deadline, and tells the sender nothing.

config WZ_POLICY_TX_EXPIRY_KEEPS_SESSION_ALLOWS_OFF
	bool "tx-expiry-keeps-session allows off" if WZ_POLICY_TX_EXPIRY_KEEPS_SESSION
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TX_EXPIRY_KEEPS_SESSION_ALLOWS_ON
	bool "tx-expiry-keeps-session allows on" if !WZ_POLICY_TX_EXPIRY_KEEPS_SESSION
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_DECLARATION_SYNC_PACING
	bool "declaration-sync-pacing"
	default n
	help
	  How a node tells a peer its declarations again after a reconnect. Off, all of
	  them are sent at once. On, they are sent in turns of
	  DECLARATION_SYNC_BURST_MESSAGES with DECLARATION_SYNC_INTERVAL_MS between
	  turns, and the session is served during the waits, so a node with many
	  declarations does not hand its peer a burst or stop answering while it sends
	  them. A declaration made while the replay runs is sent in its turn, after
	  everything it depends on; the retraction of one the peer was never told of
	  sends nothing.
	  Upstream: Replays every declaration it holds to a new peer in one call, as
	  soon as the session is open again.

config WZ_POLICY_DECLARATION_SYNC_PACING_ALLOWS_OFF
	bool "declaration-sync-pacing allows off" if WZ_POLICY_DECLARATION_SYNC_PACING
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_DECLARATION_SYNC_PACING_ALLOWS_ON
	bool "declaration-sync-pacing allows on" if !WZ_POLICY_DECLARATION_SYNC_PACING
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_DATAGRAM_FRAGMENT_PACING
	bool "datagram-fragment-pacing"
	default n
	help
	  How fast the fragments of one large message leave a UDP link, unicast or
	  multicast. Off, they are written back to back. On, at most
	  DATAGRAM_FRAGMENT_BURST fragments are written in a row, and the next waits
	  until DATAGRAM_FRAGMENT_GAP_US has passed since the last was written, so a
	  receiver with a small buffer is not handed the whole message in one burst. A
	  datagram that is not a fragment ends the run and is never delayed. The wait is
	  in the link's writer and not in the sender: a sender is held only as long as
	  the link's queue is full, as it is without the policy. QUIC datagrams and
	  WebSocket are not paced, since their transport paces itself or is a stream.
	  The tokio engine's timer has a resolution of one millisecond, so a gap is
	  rounded up to it. Only the tokio engine reads this policy.
	  Upstream: Writes the fragments of a large message to a datagram socket back to
	  back, as fast as the socket takes them, however small the receiver's buffer.

config WZ_POLICY_DATAGRAM_FRAGMENT_PACING_ALLOWS_OFF
	bool "datagram-fragment-pacing allows off" if WZ_POLICY_DATAGRAM_FRAGMENT_PACING
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_DATAGRAM_FRAGMENT_PACING_ALLOWS_ON
	bool "datagram-fragment-pacing allows on" if !WZ_POLICY_DATAGRAM_FRAGMENT_PACING
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTICAST_LINK_REQUIRES_IFACE
	bool "multicast-link-requires-iface"
	default n
	help
	  Whether a multicast link may be opened without an interface the locator
	  chose. Off, a link whose locator has no iface key is opened on the first
	  interface that can carry multicast. On, it is refused before any socket
	  exists, and so is a link whose iface key this build cannot honour, so a node
	  never joins a group or sends to it on an interface nobody named. The refusal
	  is an invalid-input error from the link's open. Scouting is not a link and is
	  not refused. Only the tokio engine reads this policy.
	  Upstream: Opens a multicast link whose locator names no interface on the first
	  interface that can carry multicast, or on the kernel's choice when the host
	  has none, so the link may sit on an interface nobody chose.

config WZ_POLICY_MULTICAST_LINK_REQUIRES_IFACE_ALLOWS_OFF
	bool "multicast-link-requires-iface allows off" if WZ_POLICY_MULTICAST_LINK_REQUIRES_IFACE
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTICAST_LINK_REQUIRES_IFACE_ALLOWS_ON
	bool "multicast-link-requires-iface allows on" if !WZ_POLICY_MULTICAST_LINK_REQUIRES_IFACE
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_RELIABLE_GAP_RECONNECT
	prompt "reliable-gap-reconnect"
	default WZ_POLICY_RELIABLE_GAP_RECONNECT_OFF
	help
	  What a node does when a frame on the reliable channel arrives with a sequence
	  number that jumped forward, which means frames were lost on the way. `off`
	  accepts the jump, which is upstream's behaviour. `until-declarations-synced`
	  treats the jump as a lost link only while the peer has not yet sent the end of
	  its initial declarations, so a session whose declaration sync was cut short is
	  reopened and the sync is redone, and a jump after that is accepted. `always`
	  treats every forward jump on the reliable channel as a lost link. The frame
	  that showed the jump is dropped, and the supervisor of a reconnecting session
	  opens the session again and redoes the declaration sync. A frame that does not
	  advance the number is dropped as before, and the best-effort channels are not
	  affected. Only the tokio engine reconnects, so another engine ends the link and
	  leaves it to the application, and only the tokio engine reports the end of the
	  peer's declarations, so for another engine `until-declarations-synced` is
	  `always`. `until-declarations-synced-when-begun` is `until-declarations-synced`
	  on a link this node dialled; on a link it accepted, a peer that lets
	  DECLARATION_SYNC_RX_NO_PROGRESS_MS pass without sending any declaration of its
	  initial interest is taken to have none to send, which settles the sync, while a
	  peer that began them is held to their end as under `until-declarations-synced`.
	  With that limit at 0 nothing settles an accepted link early.
	  Upstream: Accepts a forward jump of the reliable channel's sequence number
	  without a word: the frames in between are lost, the session stays open and
	  nothing is repaired, so a peer's declaration lost that way is never noticed.

config WZ_POLICY_RELIABLE_GAP_RECONNECT_OFF
	bool "off"

config WZ_POLICY_RELIABLE_GAP_RECONNECT_UNTIL_DECLARATIONS_SYNCED
	bool "until-declarations-synced"

config WZ_POLICY_RELIABLE_GAP_RECONNECT_ALWAYS
	bool "always"

config WZ_POLICY_RELIABLE_GAP_RECONNECT_UNTIL_DECLARATIONS_SYNCED_WHEN_BEGUN
	bool "until-declarations-synced-when-begun"

endchoice

config WZ_POLICY_RELIABLE_GAP_RECONNECT_ALLOWS_OFF
	bool "reliable-gap-reconnect allows off" if !WZ_POLICY_RELIABLE_GAP_RECONNECT_OFF
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_RELIABLE_GAP_RECONNECT_ALLOWS_UNTIL_DECLARATIONS_SYNCED
	bool "reliable-gap-reconnect allows until-declarations-synced" if !WZ_POLICY_RELIABLE_GAP_RECONNECT_UNTIL_DECLARATIONS_SYNCED
	default y
	help
	  Whether `until-declarations-synced` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_RELIABLE_GAP_RECONNECT_ALLOWS_ALWAYS
	bool "reliable-gap-reconnect allows always" if !WZ_POLICY_RELIABLE_GAP_RECONNECT_ALWAYS
	default y
	help
	  Whether `always` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_RELIABLE_GAP_RECONNECT_ALLOWS_UNTIL_DECLARATIONS_SYNCED_WHEN_BEGUN
	bool "reliable-gap-reconnect allows until-declarations-synced-when-begun" if !WZ_POLICY_RELIABLE_GAP_RECONNECT_UNTIL_DECLARATIONS_SYNCED_WHEN_BEGUN
	default y
	help
	  Whether `until-declarations-synced-when-begun` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ENTITY_LINK_RESTRICTION
	bool "entity-link-restriction"
	default n
	help
	  Whether an entity may be declared with a set of links it is limited to. Off, the
	  call that states a set is refused and every entity uses every link, which is
	  upstream's behaviour. On, a publisher sends only on the links of its set, a
	  subscriber and a queryable are declared to the nodes behind those links only
	  (so they hear and answer nothing that arrives over the others), and a query
	  goes out on those links only. A link is named by a slot the engine derives:
	  the dialling role is one and each listener is one, and the faces a listener
	  accepts share its slot. A set is never empty. A restricted entity does not use
	  a link that has no slot, and a link that comes up later is used if its slot
	  is named. Only the tokio engine reads this policy.
	  Upstream: Lets every entity use every link of the session: a put reaches every
	  link that wants it, a declaration is made to every link, a query goes to every
	  link.

config WZ_POLICY_ENTITY_LINK_RESTRICTION_ALLOWS_OFF
	bool "entity-link-restriction allows off" if WZ_POLICY_ENTITY_LINK_RESTRICTION
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ENTITY_LINK_RESTRICTION_ALLOWS_ON
	bool "entity-link-restriction allows on" if !WZ_POLICY_ENTITY_LINK_RESTRICTION
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TARGETED_QUERY
	bool "targeted-query"
	default n
	help
	  Whether a query may be addressed to one peer by its node identity. Off, the call
	  that names a peer is refused and a query goes out as upstream's does, to every
	  link that has a matching queryable. On, a query that names a peer goes out on
	  the one link that reaches that node and on no other, and its session-local leg
	  and any multicast group are left out; a peer that has no link is not asked and
	  the query is never widened to the others, so it ends with no replies from
	  anyone. The identity names a node, not a link or a queryable. Only the tokio
	  engine reads this policy.
	  Upstream: Sends a query to every link whose peers declared a queryable it
	  matches, and a caller cannot name the peer a query is for.

config WZ_POLICY_TARGETED_QUERY_ALLOWS_OFF
	bool "targeted-query allows off" if WZ_POLICY_TARGETED_QUERY
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_TARGETED_QUERY_ALLOWS_ON
	bool "targeted-query allows on" if !WZ_POLICY_TARGETED_QUERY
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_PUBLISHER_ADMISSION_RETRY
	bool "publisher-admission-retry"
	default n
	help
	  Whether a publish may state a bounded retry for the case where no link took
	  it. Off, the call that states a retry is refused and a put goes out as
	  upstream's does. On, a publish that states a retry (a number of further passes
	  and a delay between them) first offers the frame to every link it may use
	  without waiting for room. If at least one link queued it nothing is retried,
	  and a link that had no room is skipped as a congestion drop skips it. If no
	  link queued it and at least one had no room, the call waits the delay and
	  offers the frame again to those links only, up to the stated number of passes.
	  A publish that still found no room ends having delivered to no link: it does
	  not close the session, and it waits no longer than the passes and delays it
	  stated. A payload too long to be offered without waiting is sent as a
	  publish that states no retry sends it, and a publish from shared memory, which
	  is never offered without waiting, is refused when it states a retry. The number
	  of passes and the delay are never zero. Only the tokio engine reads this
	  policy; the others refuse a publish that states a retry.
	  Upstream: Sends a put to every link at once and waits on each link for room in
	  its queue; a put that finds none on a link is dropped there (or closes the
	  session) and still reports success, and a caller cannot ask for it to be tried
	  again.

config WZ_POLICY_PUBLISHER_ADMISSION_RETRY_ALLOWS_OFF
	bool "publisher-admission-retry allows off" if WZ_POLICY_PUBLISHER_ADMISSION_RETRY
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_PUBLISHER_ADMISSION_RETRY_ALLOWS_ON
	bool "publisher-admission-retry allows on" if !WZ_POLICY_PUBLISHER_ADMISSION_RETRY
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTI_ROUTE_ATOMIC_TX
	bool "multi-route-atomic-tx"
	default n
	help
	  Whether a publish may ask to be delivered to all of the links it reaches or to
	  none. Off, the call that asks is refused and a put goes out as upstream's does,
	  to each link on its own terms. On, a publish that asks first reserves room in
	  the outbound queue of every link it may use, without waiting. If every link
	  promised room, each is sent the frame under its reservation, so none of them
	  can find the room taken, and the session's own subscribers are then delivered
	  to. If any link had no room, nothing is sent to any link or to any subscriber of
	  the session, no sequence number is spent, every reservation is given back and the
	  publish ends having delivered to nobody; it does not close the session and it
	  counts no drop. A link that is down or was never told the key takes no part and
	  does not stop the others. A payload too long to be sent whole reserves the room
	  of every frame of its chain on every link before any frame is sent, links that
	  share a queue counted together, and no frame of the chain asks for room again,
	  so the chain reaches every link whole or no link at all. A multicast group
	  takes no reservation: it is sent the frame only once every link promised room,
	  and nothing when the publish delivered to nobody. A link whose frames are
	  written in slots of a pool may still wait for a slot. A publish from shared
	  memory reserves nothing and is refused when it asks. Only the tokio engine
	  reads this policy; the others refuse a publish that asks.
	  Upstream: Sends a put to each link on its own terms: a link whose queue is
	  full drops the frame or waits for room while the other links take it, so one
	  put can reach some links and not others.

config WZ_POLICY_MULTI_ROUTE_ATOMIC_TX_ALLOWS_OFF
	bool "multi-route-atomic-tx allows off" if WZ_POLICY_MULTI_ROUTE_ATOMIC_TX
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_MULTI_ROUTE_ATOMIC_TX_ALLOWS_ON
	bool "multi-route-atomic-tx allows on" if !WZ_POLICY_MULTI_ROUTE_ATOMIC_TX
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN
	bool "entity-timestamp-opt-in"
	default n
	help
	  What an entity does with a timestamp when its declaration says nothing. Off,
	  a subscriber and a querier see the timestamp of what they receive, and any
	  publisher attaches the timestamp it is given. On, an entity takes part only
	  if it was declared to: a subscriber or a querier sees no timestamp unless it
	  asks to, and a publisher refuses a timestamped put unless it was declared to
	  stamp. Each declaration can still state its own choice either way; this sets
	  the default for the ones that do not. A publisher given a time supplies its
	  own node identity, so a caller cannot sign a sample as another node.
	  Upstream: Hands every received sample's timestamp to the subscriber and every
	  reply's to the querier, and lets any publisher attach the timestamp it is
	  given.

config WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN_ALLOWS_OFF
	bool "entity-timestamp-opt-in allows off" if WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN_ALLOWS_ON
	bool "entity-timestamp-opt-in allows on" if !WZ_POLICY_ENTITY_TIMESTAMP_OPT_IN
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLY_AUTO_TIMESTAMP
	bool "reply-auto-timestamp"
	default n
	help
	  What a queryable's reply carries when its handler gave it no timestamp. Off, it
	  carries none. On, the node stamps it with the next time of its own clock and its
	  own identity as the reply is staged, so a querier that orders replies by time
	  can order those of a handler that never read a clock. A reply the handler
	  stamped keeps its stamp, an error reply carries none, and a queryable declared
	  not to stamp (see entity-timestamp-opt-in) sends none. A node with no clock, or
	  whose clock does not know the date or is not trusted to stamp, stamps nothing
	  and its replies go out as they would with this off.
	  Upstream: Sends a reply with the timestamp its handler gave it and with none
	  when the handler gave none.

config WZ_POLICY_REPLY_AUTO_TIMESTAMP_ALLOWS_OFF
	bool "reply-auto-timestamp allows off" if WZ_POLICY_REPLY_AUTO_TIMESTAMP
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLY_AUTO_TIMESTAMP_ALLOWS_ON
	bool "reply-auto-timestamp allows on" if !WZ_POLICY_REPLY_AUTO_TIMESTAMP
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_SUBSCRIBER_OVERLOAD
	prompt "subscriber-overload"
	default WZ_POLICY_SUBSCRIBER_OVERLOAD_BLOCK
	help
	  What a subscriber whose callback runs off the receive path does when its
	  delivery lane is full and its declaration says nothing. `block` makes the
	  session wait for room, outside the lock the receive path holds, so the
	  transport's own backpressure is the flow control and no sample is lost.
	  `reject` refuses the sample at once: the receive path is never held, the sample
	  is lost, and it is counted by reason and by whether it was sent reliably.
	  `keep-latest` admits the new sample and takes out the newest ones already
	  queued behind the one being delivered until it fits: the receive path is never
	  held, the newest sample is never the one lost, and each one taken out is
	  counted by how it was sent. It is for a stream whose last value is the one
	  that matters. A sample longer than the whole lane can never wait for room, so
	  it is refused under every choice. Each declaration can still state its own
	  choice; this sets the default for the ones that do not.
	  Upstream: Hands a sample to a channel handler that blocks its sender when the
	  handler is full, so a slow consumer applies backpressure into the session and
	  no sample is lost.

config WZ_POLICY_SUBSCRIBER_OVERLOAD_BLOCK
	bool "block"

config WZ_POLICY_SUBSCRIBER_OVERLOAD_REJECT
	bool "reject"

config WZ_POLICY_SUBSCRIBER_OVERLOAD_KEEP_LATEST
	bool "keep-latest"

endchoice

config WZ_POLICY_SUBSCRIBER_OVERLOAD_ALLOWS_BLOCK
	bool "subscriber-overload allows block" if !WZ_POLICY_SUBSCRIBER_OVERLOAD_BLOCK
	default y
	help
	  Whether `block` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SUBSCRIBER_OVERLOAD_ALLOWS_REJECT
	bool "subscriber-overload allows reject" if !WZ_POLICY_SUBSCRIBER_OVERLOAD_REJECT
	default y
	help
	  Whether `reject` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SUBSCRIBER_OVERLOAD_ALLOWS_KEEP_LATEST
	bool "subscriber-overload allows keep-latest" if !WZ_POLICY_SUBSCRIBER_OVERLOAD_KEEP_LATEST
	default y
	help
	  Whether `keep-latest` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_KEY_SET
	prompt "key-set"
	default WZ_POLICY_KEY_SET_OPEN
	help
	  Which keys the receive path takes a message on (the closed key set). `open` takes
	  any key a peer sends. `closed` takes only the keys the image declares as its key set,
	  which the build generates into a read-only table: a message on any other key is dropped
	  before a subscriber is looked up, and counted by reason. A closed build that is given
	  no table takes no key at all. The selectors a peer asks with, a query or an interest,
	  are patterns and not data keys, and are answered as in an open build. `closed` needs the
	  cargo feature `key-set-closed` of wz-session-core, which compiles the mode in; a build that
	  states it without the feature does not compile, and an open build has neither the code
	  nor its bytes.
	  Upstream: Takes a message on any key a peer sends, and finds the subscribers
	  it reaches by matching that key against each subscription's pattern as text.

config WZ_POLICY_KEY_SET_OPEN
	bool "open"

config WZ_POLICY_KEY_SET_CLOSED
	bool "closed"

endchoice

config WZ_POLICY_KEY_SET_ALLOWS_OPEN
	bool "key-set allows open" if !WZ_POLICY_KEY_SET_OPEN
	default y
	help
	  Whether `open` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_KEY_SET_ALLOWS_CLOSED
	bool "key-set allows closed" if !WZ_POLICY_KEY_SET_CLOSED
	default y
	help
	  Whether `closed` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_SN_RESOLUTION
	prompt "sn-resolution"
	default WZ_POLICY_SN_RESOLUTION_BITS_32
	help
	  The width of the sequence numbers the sessions of the C interfaces advertise
	  when their configuration states none: in the InitSyn of a unicast session,
	  where the two sides take the smaller of the two advertised widths, and in the
	  Join of a multicast group, where a member refuses a Join that states another
	  width than its own, so every member of a group states the same. `bits-32` is
	  what zenoh advertises by default and what zenoh-pico always advertises.
	  `bits-8`, `bits-16` and `bits-64` state that width instead, for a peer built
	  with a sequence-number width of its own. A configuration that states
	  `transport/link/tx/sequence_number_resolution` with a width other than 32 bits
	  is followed instead of this policy, as zenoh follows the key. A session that
	  negotiates a width below its peer's runs the narrower ring of the two; a ring
	  of 8 bits wraps after 128 frames in flight, so a narrow width asks a deployment
	  to know its traffic. The request-id resolution is not part of this policy.
	  Upstream: Advertises the 32-bit sequence-number resolution in its InitSyn and
	  in the Join of a group unless its configuration states another: zenoh reads
	  `transport/link/tx/sequence_number_resolution`, whose default is 32 bits, and
	  zenoh-pico builds in `Z_SN_RESOLUTION 0x02` with no setting for another.

config WZ_POLICY_SN_RESOLUTION_BITS_32
	bool "bits-32"

config WZ_POLICY_SN_RESOLUTION_BITS_8
	bool "bits-8"

config WZ_POLICY_SN_RESOLUTION_BITS_16
	bool "bits-16"

config WZ_POLICY_SN_RESOLUTION_BITS_64
	bool "bits-64"

endchoice

config WZ_POLICY_SN_RESOLUTION_ALLOWS_BITS_32
	bool "sn-resolution allows bits-32" if !WZ_POLICY_SN_RESOLUTION_BITS_32
	default y
	help
	  Whether `bits-32` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SN_RESOLUTION_ALLOWS_BITS_8
	bool "sn-resolution allows bits-8" if !WZ_POLICY_SN_RESOLUTION_BITS_8
	default y
	help
	  Whether `bits-8` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SN_RESOLUTION_ALLOWS_BITS_16
	bool "sn-resolution allows bits-16" if !WZ_POLICY_SN_RESOLUTION_BITS_16
	default y
	help
	  Whether `bits-16` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SN_RESOLUTION_ALLOWS_BITS_64
	bool "sn-resolution allows bits-64" if !WZ_POLICY_SN_RESOLUTION_BITS_64
	default y
	help
	  Whether `bits-64` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_SUPERVISION_AFTER_EXPIRY
	prompt "supervision-after-expiry"
	default WZ_POLICY_SUPERVISION_AFTER_EXPIRY_LATCH
	help
	  What a checkpoint does when it is fed after its deadline was missed. `latch`
	  leaves it expired: the missed deadline stays visible, the node stays unhealthy,
	  and the checkpoint is supervised again only when it is stopped and started,
	  which is what a watchdog does. `rearm` supervises it again on that feed, so a
	  checkpoint that recovers makes the node healthy again. The expiry hook runs once
	  per expiry either way.
	  Upstream: Supervises nothing: an application that stops making progress is not
	  noticed by the library, so there is no expiry and nothing for a later feed to
	  do.

config WZ_POLICY_SUPERVISION_AFTER_EXPIRY_LATCH
	bool "latch"

config WZ_POLICY_SUPERVISION_AFTER_EXPIRY_REARM
	bool "rearm"

endchoice

config WZ_POLICY_SUPERVISION_AFTER_EXPIRY_ALLOWS_LATCH
	bool "supervision-after-expiry allows latch" if !WZ_POLICY_SUPERVISION_AFTER_EXPIRY_LATCH
	default y
	help
	  Whether `latch` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_SUPERVISION_AFTER_EXPIRY_ALLOWS_REARM
	bool "supervision-after-expiry allows rearm" if !WZ_POLICY_SUPERVISION_AFTER_EXPIRY_REARM
	default y
	help
	  Whether `rearm` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_E2E_SUPERVISION_NOTIFY
	prompt "e2e-supervision-notify"
	default WZ_POLICY_E2E_SUPERVISION_NOTIFY_STATUS_ONLY
	help
	  What a reception supervisor tells the application when a stream stops
	  arriving. `status-only` tells the stream, its sender and the error counts, and
	  keeps no payload. `last-value` also hands back the payload the stream last
	  carried, which the supervisor keeps in a cell of the application's storage per
	  stream, for an application that delivers a value with every loss as it does
	  with every sample. Decided when the supervisor is made, and fixed for its life.
	  Upstream: Supervises no stream's reception: a periodic message that stops
	  arriving is not noticed by the library, so there is no loss to tell and no
	  value to tell it with.

config WZ_POLICY_E2E_SUPERVISION_NOTIFY_STATUS_ONLY
	bool "status-only"

config WZ_POLICY_E2E_SUPERVISION_NOTIFY_LAST_VALUE
	bool "last-value"

endchoice

config WZ_POLICY_E2E_SUPERVISION_NOTIFY_ALLOWS_STATUS_ONLY
	bool "e2e-supervision-notify allows status-only" if !WZ_POLICY_E2E_SUPERVISION_NOTIFY_STATUS_ONLY
	default y
	help
	  Whether `status-only` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_E2E_SUPERVISION_NOTIFY_ALLOWS_LAST_VALUE
	bool "e2e-supervision-notify allows last-value" if !WZ_POLICY_E2E_SUPERVISION_NOTIFY_LAST_VALUE
	default y
	help
	  Whether `last-value` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_REPLAY_REPLY_SHAPE
	prompt "replay-reply-shape"
	default WZ_POLICY_REPLAY_REPLY_SHAPE_FRAME_PER_SAMPLE
	help
	  How a publisher's replay cache answers a query. `frame-per-sample` answers one
	  reply per sample of the ring, each the frame exactly as it was sent, then the
	  final. `segmented` answers each sample as the pieces of the message's declared
	  segment profile, every sample under the next transfer number, for a message
	  whose frames are larger than a deployment puts in one sample; the cache's live
	  sends go out as pieces too, and a subscriber joins the pieces, live and
	  replied, before it judges a frame, giving up only a frame a piece of which
	  never came. Decided when the cache or the subscriber is made, and fixed for its
	  life.
	  Upstream: Keeps no ring of sent frames, so there is no replay to answer and no
	  shape to give it; a queryable the application declares answers whatever it
	  replies.

config WZ_POLICY_REPLAY_REPLY_SHAPE_FRAME_PER_SAMPLE
	bool "frame-per-sample"

config WZ_POLICY_REPLAY_REPLY_SHAPE_SEGMENTED
	bool "segmented"

endchoice

config WZ_POLICY_REPLAY_REPLY_SHAPE_ALLOWS_FRAME_PER_SAMPLE
	bool "replay-reply-shape allows frame-per-sample" if !WZ_POLICY_REPLAY_REPLY_SHAPE_FRAME_PER_SAMPLE
	default y
	help
	  Whether `frame-per-sample` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLAY_REPLY_SHAPE_ALLOWS_SEGMENTED
	bool "replay-reply-shape allows segmented" if !WZ_POLICY_REPLAY_REPLY_SHAPE_SEGMENTED
	default y
	help
	  Whether `segmented` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLAY_SERVE_HOLDS_SENDS
	bool "replay-serve-holds-sends"
	default n
	help
	  Whether a publisher's sends of a message wait while its replay cache answers a
	  query. Off, a send goes out at once, and a subscriber may see a newer frame
	  before the replay that precedes it. On, a periodic send is held and only the
	  latest of each instance goes out once the answer is over, and an event send is
	  deferred to a queue of max(1, depth/2) frames that gives up the oldest when it
	  is full; the held frames go out in the order they were sent, before any later
	  send. Decided when the cache is made, and fixed for its life.
	  Upstream: Keeps no ring of sent frames and answers no replay, so a send is
	  never held back for one.

config WZ_POLICY_REPLAY_SERVE_HOLDS_SENDS_ALLOWS_OFF
	bool "replay-serve-holds-sends allows off" if WZ_POLICY_REPLAY_SERVE_HOLDS_SENDS
	default y
	help
	  Whether `off` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLAY_SERVE_HOLDS_SENDS_ALLOWS_ON
	bool "replay-serve-holds-sends allows on" if !WZ_POLICY_REPLAY_SERVE_HOLDS_SENDS
	default y
	help
	  Whether `on` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER
	prompt "replay-live-before-answer"
	default WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_DELIVER
	help
	  How a subscriber that asks for a replay orders its live samples against it.
	  `deliver` hands each live sample on as it arrives, so live samples and replies
	  interleave and the receiving judge drops a reply that is behind what it has
	  seen. `hold-back` holds the live samples, in a store the application sizes,
	  until the first round of replies is over or abandoned by its deadline (or the
	  store is full), then hands them on after every reply of that round, so the
	  application never sees a newer sample before the replay that precedes it.
	  Decided when the subscriber is made, and fixed for its life.
	  Upstream: Asks no publisher for what it sent before, so a live sample is
	  delivered as it arrives and there is no replay to order it against.

config WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_DELIVER
	bool "deliver"

config WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_HOLD_BACK
	bool "hold-back"

endchoice

config WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_ALLOWS_DELIVER
	bool "replay-live-before-answer allows deliver" if !WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_DELIVER
	default y
	help
	  Whether `deliver` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_ALLOWS_HOLD_BACK
	bool "replay-live-before-answer allows hold-back" if !WZ_POLICY_REPLAY_LIVE_BEFORE_ANSWER_HOLD_BACK
	default y
	help
	  Whether `hold-back` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_EVENT_RING_FULL
	prompt "event-ring-full"
	default WZ_POLICY_EVENT_RING_FULL_OVERWRITE_OLDEST
	help
	  Which event a full event ring gives up. `overwrite-oldest` writes the new event
	  over the oldest, so the ring always holds the latest: it is what a post-mortem
	  wants, and needs no reader at all. `drop-newest` refuses the new event and
	  counts the refusals, so the ring holds the beginning until a reader frees it:
	  it is what a boot trace wants, and the events are lost whenever no reader is
	  reading.
	  Upstream: Keeps no record of the events a node has: a log call with no logger
	  installed is dropped, so neither the oldest nor the newest of them survives.

config WZ_POLICY_EVENT_RING_FULL_OVERWRITE_OLDEST
	bool "overwrite-oldest"

config WZ_POLICY_EVENT_RING_FULL_DROP_NEWEST
	bool "drop-newest"

endchoice

config WZ_POLICY_EVENT_RING_FULL_ALLOWS_OVERWRITE_OLDEST
	bool "event-ring-full allows overwrite-oldest" if !WZ_POLICY_EVENT_RING_FULL_OVERWRITE_OLDEST
	default y
	help
	  Whether `overwrite-oldest` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_EVENT_RING_FULL_ALLOWS_DROP_NEWEST
	bool "event-ring-full allows drop-newest" if !WZ_POLICY_EVENT_RING_FULL_DROP_NEWEST
	default y
	help
	  Whether `drop-newest` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_CLOCK_QUALITY_STAMPING
	prompt "clock-quality-stamping"
	default WZ_POLICY_CLOCK_QUALITY_STAMPING_ALWAYS
	help
	  Whether a node stamps data with a time it does not trust. `always` stamps with
	  the clock's reading whatever its standing. `trusted-only` stamps only while the
	  clock is synchronised to a reference, or held over from one within the bound
	  the host keeps: before the host first reports a reference, and once that bound
	  has passed, the node stamps no data it forwards, takes no timestamp into its
	  clock and counts the data it passed on as it came. A storage that needs a time
	  to order what it keeps still takes one from the system clock. The host reports
	  the clock's standing, because only the host knows it: a time daemon, a
	  satellite receiver, a fieldbus master.
	  Upstream: Stamps with whatever time the system clock reads, and has no notion
	  of whether that clock is set or follows a reference.

config WZ_POLICY_CLOCK_QUALITY_STAMPING_ALWAYS
	bool "always"

config WZ_POLICY_CLOCK_QUALITY_STAMPING_TRUSTED_ONLY
	bool "trusted-only"

endchoice

config WZ_POLICY_CLOCK_QUALITY_STAMPING_ALLOWS_ALWAYS
	bool "clock-quality-stamping allows always" if !WZ_POLICY_CLOCK_QUALITY_STAMPING_ALWAYS
	default y
	help
	  Whether `always` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_CLOCK_QUALITY_STAMPING_ALLOWS_TRUSTED_ONLY
	bool "clock-quality-stamping allows trusted-only" if !WZ_POLICY_CLOCK_QUALITY_STAMPING_TRUSTED_ONLY
	default y
	help
	  Whether `trusted-only` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_ROUTING_FACE_DRIVE
	prompt "routing-face-drive"
	default WZ_POLICY_ROUTING_FACE_DRIVE_TASK_PER_FACE
	help
	  How a node that routes for others serves its links. `task-per-face` gives each
	  link a task of its own on the node's worker threads: a node with many peers
	  uses more than one core, and a link that is slow to serve holds up only itself.
	  `one-task` serves every link from the node's one task, one message at a time,
	  on one core: the order in which the node handles what its links bring is then
	  the order the task polled them, which a run replayed for a test needs, and a
	  host with one core loses nothing by it. Neither changes what a peer is sent or
	  in what order one link's messages are routed.
	  Upstream: Reads each link of a node on a task of its own, spawned on the
	  node's receive runtime (two worker threads unless the runtime is configured
	  otherwise), and routes what that link brings on the same task under a read
	  lock of the routing tables, so the links of a node are served by several
	  threads at once.

config WZ_POLICY_ROUTING_FACE_DRIVE_TASK_PER_FACE
	bool "task-per-face"

config WZ_POLICY_ROUTING_FACE_DRIVE_ONE_TASK
	bool "one-task"

endchoice

config WZ_POLICY_ROUTING_FACE_DRIVE_ALLOWS_TASK_PER_FACE
	bool "routing-face-drive allows task-per-face" if !WZ_POLICY_ROUTING_FACE_DRIVE_TASK_PER_FACE
	default y
	help
	  Whether `task-per-face` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ROUTING_FACE_DRIVE_ALLOWS_ONE_TASK
	bool "routing-face-drive allows one-task" if !WZ_POLICY_ROUTING_FACE_DRIVE_ONE_TASK
	default y
	help
	  Whether `one-task` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_ROUTING_TABLE_SHARING
	prompt "routing-table-sharing"
	default WZ_POLICY_ROUTING_TABLE_SHARING_RWLOCK
	help
	  How a node that routes for others shares its routing tables between the links
	  that route by them and the changes made to them. `rwlock` is upstream's: one
	  reader-writer lock, so a declaration, a link coming up or one leaving waits for
	  the messages being routed, and they wait for it. `snapshot` publishes each
	  change of the tables as a new version that the links route by without waiting:
	  a change copies only the part of the tables it touches, and a link that leaves
	  is sent nothing after its leaving has returned. What `snapshot` does not keep
	  of `rwlock`: a message being routed by the version before a change may reach a
	  link after a declaration that change sends to the same link, an order no rule
	  of the protocol sets. `snapshot` is the value to choose for a router whose
	  sessions come and go while it routes: a change waits for no message being
	  routed, and a message costs what it costs under `rwlock`.
	  Upstream: Keeps a router's routing tables behind one reader-writer lock
	  (`RwLock<Tables>` in its `TablesLock`), so a declaration, a face coming up or
	  one leaving waits for the messages being routed, and they wait for it.

config WZ_POLICY_ROUTING_TABLE_SHARING_RWLOCK
	bool "rwlock"

config WZ_POLICY_ROUTING_TABLE_SHARING_SNAPSHOT
	bool "snapshot"

endchoice

config WZ_POLICY_ROUTING_TABLE_SHARING_ALLOWS_RWLOCK
	bool "routing-table-sharing allows rwlock" if !WZ_POLICY_ROUTING_TABLE_SHARING_RWLOCK
	default y
	help
	  Whether `rwlock` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ROUTING_TABLE_SHARING_ALLOWS_SNAPSHOT
	bool "routing-table-sharing allows snapshot" if !WZ_POLICY_ROUTING_TABLE_SHARING_SNAPSHOT
	default y
	help
	  Whether `snapshot` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_REASSEMBLY_POOL_OVERFLOW
	prompt "reassembly-pool-overflow"
	default WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_REJECT
	help
	  What a node does with the first fragment of a new fragmented message when every
	  slot of its reassembly pool holds a message still arriving. The pool is shared
	  by all the node's peers and bounded, where upstream gives each peer and channel
	  a buffer of its own; sizing the pool at twice the peer table keeps the moment
	  from arising. `reject` drops the new message's fragments and keeps the messages
	  already arriving, which is what wz did before this policy. `diagnostic-event`
	  does the same and logs a warning, reassembly/slot-pool-full, at each such drop.
	  `oldest-wins` ends the message whose first fragment came earliest, of whichever
	  peer, and gives its slot to the new one: the ended message is reported as
	  evicted and its later fragments are not joined to it, so the newest traffic is kept
	  and a peer that stalls mid-message loses that message before its deadline.
	  A peer already holding its quota of messages is refused before the pool is
	  looked at, whatever the value.
	  Upstream: Keeps one defragmentation buffer for each peer and channel, so a new
	  fragmented message never waits on another peer's and there is no shared pool
	  to fill. None of the three values is upstream's, since upstream has no such
	  moment; `reject` is what wz did before the policy existed.

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_REJECT
	bool "reject"

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_DIAGNOSTIC_EVENT
	bool "diagnostic-event"

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_OLDEST_WINS
	bool "oldest-wins"

endchoice

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_ALLOWS_REJECT
	bool "reassembly-pool-overflow allows reject" if !WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_REJECT
	default y
	help
	  Whether `reject` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_ALLOWS_DIAGNOSTIC_EVENT
	bool "reassembly-pool-overflow allows diagnostic-event" if !WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_DIAGNOSTIC_EVENT
	default y
	help
	  Whether `diagnostic-event` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_ALLOWS_OLDEST_WINS
	bool "reassembly-pool-overflow allows oldest-wins" if !WZ_POLICY_REASSEMBLY_POOL_OVERFLOW_OLDEST_WINS
	default y
	help
	  Whether `oldest-wins` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_LINK_TIE_ORDER
	prompt "link-tie-order"
	default WZ_POLICY_LINK_TIE_ORDER_ZID_NUMBER
	help
	  How a node orders two zids when it and a peer dialled each other at the same
	  moment and both ends must keep the same one of the two links: the link the node
	  with the lower zid dialled is kept, and this says which zid is lower. `zid-number`
	  reads each zid as the 128-bit number zenoh reads, its first wire byte the least
	  significant. `zid-bytes` compares the two ids byte by byte from the first wire
	  byte, as zenoh-pico compares ids. The two orders disagree on most pairs of zids,
	  so both ends of a link must state the same value: a peer that keeps one link by
	  the other order closes the link this node kept, and neither link survives.
	  Upstream: Two nodes that dial each other at once keep one transport; zenoh
	  orders the two zids as the 128-bit numbers they are, the wire carrying a zid's
	  little-endian bytes. zenoh-pico keeps no such rule, and compares two ids byte
	  by byte from the first wire byte (`_z_id_cmp`).

config WZ_POLICY_LINK_TIE_ORDER_ZID_NUMBER
	bool "zid-number"

config WZ_POLICY_LINK_TIE_ORDER_ZID_BYTES
	bool "zid-bytes"

endchoice

config WZ_POLICY_LINK_TIE_ORDER_ALLOWS_ZID_NUMBER
	bool "link-tie-order allows zid-number" if !WZ_POLICY_LINK_TIE_ORDER_ZID_NUMBER
	default y
	help
	  Whether `zid-number` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_LINK_TIE_ORDER_ALLOWS_ZID_BYTES
	bool "link-tie-order allows zid-bytes" if !WZ_POLICY_LINK_TIE_ORDER_ZID_BYTES
	default y
	help
	  Whether `zid-bytes` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_QUERY_UNANSWERABLE_FINAL
	prompt "query-unanswerable-final"
	default WZ_POLICY_QUERY_UNANSWERABLE_FINAL_NONE
	help
	  How a node answers a query from a peer that it cannot run at all because the
	  query's key names an id the peer never declared to this node. `none` sends
	  nothing, as upstream does, and the asker's query ends only at its own timeout.
	  `empty-final` answers it at once with a RESPONSE_FINAL and no reply, the answer
	  a query that matched no queryable gets, so the asker learns now that nothing
	  will come. A query whose parameters or attachment are longer than the build
	  allows is answered with that final under either value, and a query that
	  arrives while the node has no room left to hold another final is refused and
	  counted under either value, since the final it would owe has nowhere to wait.
	  Upstream: Drops a query from a peer whose key it cannot resolve (an id the
	  peer never declared to it) before the query reaches any queryable, and sends
	  nothing back, so the asker waits out its own timeout.

config WZ_POLICY_QUERY_UNANSWERABLE_FINAL_NONE
	bool "none"

config WZ_POLICY_QUERY_UNANSWERABLE_FINAL_EMPTY_FINAL
	bool "empty-final"

endchoice

config WZ_POLICY_QUERY_UNANSWERABLE_FINAL_ALLOWS_NONE
	bool "query-unanswerable-final allows none" if !WZ_POLICY_QUERY_UNANSWERABLE_FINAL_NONE
	default y
	help
	  Whether `none` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_QUERY_UNANSWERABLE_FINAL_ALLOWS_EMPTY_FINAL
	bool "query-unanswerable-final allows empty-final" if !WZ_POLICY_QUERY_UNANSWERABLE_FINAL_EMPTY_FINAL
	default y
	help
	  Whether `empty-final` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_ZID_DERIVATION
	prompt "zid-derivation"
	default WZ_POLICY_ZID_DERIVATION_RANDOM
	help
	  How a node makes its zid when the configuration states none. `random` draws all
	  sixteen bytes, as upstream does. `address-ports` derives the first eight from
	  where the node is reachable and draws the other eight: bytes 0 to 3 are the
	  IPv4 address of the first listen endpoint that binds an address of the node,
	  bytes 4 and 5 the lowest port of its tcp listeners and bytes 6 and 7 the lowest
	  port of its udp listeners, each little-endian and 0 for a node with no listener
	  of that protocol. A wildcard, multicast or broadcast address names no node, and
	  a node whose listeners name no address of its own is refused at open rather
	  than given a random zid. A zid the configuration states is used under either
	  value. Only the C ABIs' open reads this policy.
	  Upstream: Draws every byte of a zid the configuration does not state from its
	  random source.

config WZ_POLICY_ZID_DERIVATION_RANDOM
	bool "random"

config WZ_POLICY_ZID_DERIVATION_ADDRESS_PORTS
	bool "address-ports"

endchoice

config WZ_POLICY_ZID_DERIVATION_ALLOWS_RANDOM
	bool "zid-derivation allows random" if !WZ_POLICY_ZID_DERIVATION_RANDOM
	default y
	help
	  Whether `random` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_ZID_DERIVATION_ALLOWS_ADDRESS_PORTS
	bool "zid-derivation allows address-ports" if !WZ_POLICY_ZID_DERIVATION_ADDRESS_PORTS
	default y
	help
	  Whether `address-ports` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_HANDSHAKE_STRAY_MESSAGE
	prompt "handshake-stray-message"
	default WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_FAIL
	help
	  What a unicast establishment does with an Init or an Open that is not the
	  message its current step awaits: an InitAck repeated after the OpenSyn went out,
	  an InitSyn repeated after the InitAck went out, or any other out of its step.
	  `fail` ends the attempt and closes the link with INVALID, as upstream does.
	  `ignore` drops the message before anything is taken from it and the step goes
	  on waiting, under the deadline it already had: nothing a peer sends extends an
	  establishment. Under `ignore` an Init or Open that reaches an established
	  session is dropped as well, and is not counted as a sign of the peer's life for
	  the lease, nor does it change anything the session negotiated.
	  `ignore-and-replay` is `ignore`, and in addition a peer that repeats the step
	  this node last answered (an InitSyn after the InitAck went out, an InitAck
	  after the OpenSyn went out) is sent that answer again, the very bytes first
	  sent, so its cookie is the one already issued. A build whose domain allows this
	  value holds one answer per establishment in flight, released when the
	  establishment ends; an answer longer than the hold is not sent again.
	  Upstream: Ends a unicast establishment, closing the link with INVALID, on any
	  message but the one its current step reads next, and drops an Init or Open
	  that reaches an established session while counting it as traffic for the
	  lease.

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_FAIL
	bool "fail"

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_IGNORE
	bool "ignore"

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_IGNORE_AND_REPLAY
	bool "ignore-and-replay"

endchoice

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_ALLOWS_FAIL
	bool "handshake-stray-message allows fail" if !WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_FAIL
	default y
	help
	  Whether `fail` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_ALLOWS_IGNORE
	bool "handshake-stray-message allows ignore" if !WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_IGNORE
	default y
	help
	  Whether `ignore` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_ALLOWS_IGNORE_AND_REPLAY
	bool "handshake-stray-message allows ignore-and-replay" if !WZ_POLICY_HANDSHAKE_STRAY_MESSAGE_IGNORE_AND_REPLAY
	default y
	help
	  Whether `ignore-and-replay` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

choice WZ_POLICY_KEY_WIRE_FORM
	prompt "key-wire-form"
	default WZ_POLICY_KEY_WIRE_FORM_DECLARED
	help
	  How a node names a key on the wire to the peer of a link. `declared` is
	  upstream's: the id of a key expression the node declared to that peer, or the
	  whole key. `literal` sends the whole key every time and declares nothing for
	  it. `shared` uses the key-id dictionary every node of the deployment holds
	  (the shared-key-ids capability): the key's own id when the dictionary holds
	  it, the id of the longest entry that ends at one of its slashes followed by
	  the rest of the key, or the whole key, whichever takes the fewest bytes, with
	  no declaration first; a key with a wildcard goes by an id only when the
	  dictionary holds that exact pattern, a peer that announced itself a router is
	  sent the declared form, and a reply on the key of a query that came by an id
	  of the dictionary names it by that id and rest, its mapping bit turned. A peer
	  that does not hold the same dictionary cannot read what `shared` sends, so both
	  ends of the link must hold it. Every node that holds the dictionary reads an id
	  only the dictionary names, whatever its own value. The value is the session's,
	  and an endpoint the configuration dials or listens on may be stated a value of
	  its own (wz_ext_config_key_wire_form_for), which every link to or from that
	  endpoint takes. A session opened with `shared`, for itself or an endpoint, and
	  no dictionary is refused, and so is one whose value is not `declared` in a build
	  without the capability. Interests and liveliness interests name their keys as
	  under `declared`.
	  Upstream: Names a key on the wire by the id of a key expression it declared to
	  that peer first, or by the whole key; a peer reads an id only when it was
	  declared to it, and refuses one it never was.

config WZ_POLICY_KEY_WIRE_FORM_DECLARED
	bool "declared"

config WZ_POLICY_KEY_WIRE_FORM_SHARED
	bool "shared"

config WZ_POLICY_KEY_WIRE_FORM_LITERAL
	bool "literal"

endchoice

config WZ_POLICY_KEY_WIRE_FORM_ALLOWS_DECLARED
	bool "key-wire-form allows declared" if !WZ_POLICY_KEY_WIRE_FORM_DECLARED
	default y
	help
	  Whether `declared` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_KEY_WIRE_FORM_ALLOWS_SHARED
	bool "key-wire-form allows shared" if !WZ_POLICY_KEY_WIRE_FORM_SHARED
	default y
	help
	  Whether `shared` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

config WZ_POLICY_KEY_WIRE_FORM_ALLOWS_LITERAL
	bool "key-wire-form allows literal" if !WZ_POLICY_KEY_WIRE_FORM_LITERAL
	default y
	help
	  Whether `literal` stays selectable after the build; the chosen default always does.
	  A target with no operating system keeps only the default unless this is set here.

endmenu
