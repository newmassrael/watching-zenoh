{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from deploy/wz-config.toml by scripts/lib/wz_config.py --emit config-schema. Do not edit: `wz_config.py --check` fails when this file is stale.",
  "title": "wz run-time configuration",
  "description": "The policies and limits a document may state when a node opens or while it runs. A policy the build fixes, a limit only the build sizes, and a limit no machine of the build reads from a statement are not here.",
  "type": "object",
  "properties": {
    "wz": {
      "type": "object",
      "properties": {
        "profile": {
          "description": "The profile the document starts from: a named set of policy values the build declares, which the document's own policies override.",
          "enum": [
            "upstream"
          ]
        },
        "policies": {
          "type": "object",
          "properties": {
            "multicast-loopback": {
              "description": "Whether a datagram a node sends to a multicast group is also delivered to members of that group on the same host.",
              "enum": [
                "os-default",
                "on",
                "off"
              ],
              "default": "os-default",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "none"
            },
            "tx-no-progress-deadline": {
              "description": "Whether a blocking message gets a second bound beside its total wait: the wait with no progress.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "session",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "timing"
            },
            "tx-expiry-keeps-session": {
              "description": "What happens when a blocking message finds no room within its deadline.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "session",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "declaration-sync-pacing": {
              "description": "How a node tells a peer its declarations again after a reconnect.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "link",
              "x-wz-binding": "live",
              "x-wz-mutability": "quiescent",
              "x-wz-boundary": "the start of the next replay of declarations",
              "x-wz-wire": "timing"
            },
            "datagram-fragment-pacing": {
              "description": "How fast the fragments of one large message leave a UDP link, unicast or multicast.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "timing"
            },
            "multicast-link-requires-iface": {
              "description": "Whether a multicast link may be opened without an interface the locator chose.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "none"
            },
            "reliable-gap-reconnect": {
              "description": "What a node does when a frame on the reliable channel arrives with a sequence number that jumped forward, which means frames were lost on the way.",
              "enum": [
                "off",
                "until-declarations-synced",
                "always",
                "until-declarations-synced-when-begun"
              ],
              "default": "off",
              "x-wz-scope": "session",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "entity-link-restriction": {
              "description": "Whether an entity may be declared with a set of links it is limited to.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "entity",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "targeted-query": {
              "description": "Whether a query may be addressed to one peer by its node identity.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "message",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "publisher-admission-retry": {
              "description": "Whether a publish may state a bounded retry for the case where no link took it.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "message",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "multi-route-atomic-tx": {
              "description": "Whether a publish may ask to be delivered to all of the links it reaches or to none.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "message",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "entity-timestamp-opt-in": {
              "description": "What an entity does with a timestamp when its declaration says nothing.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "entity",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "reply-auto-timestamp": {
              "description": "What a queryable's reply carries when its handler gave it no timestamp.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "entity",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "subscriber-overload": {
              "description": "What a subscriber whose callback runs off the receive path does when its delivery lane is full and its declaration says nothing.",
              "enum": [
                "block",
                "reject",
                "keep-latest"
              ],
              "default": "block",
              "x-wz-scope": "entity",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "timing"
            },
            "key-set": {
              "description": "Which keys the receive path takes a message on (the closed key set).",
              "enum": [
                "open",
                "closed"
              ],
              "default": "open",
              "x-wz-scope": "session",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "none"
            },
            "sn-resolution": {
              "description": "The width of the sequence numbers the sessions of the C interfaces advertise when their configuration states none: in the InitSyn of a unicast session, where the two sides take the smaller of the two advertised widths, and in the Join of a multicast group, where a member refuses a Join that states another width than its own, so every member of a group states the same.",
              "enum": [
                "bits-32",
                "bits-8",
                "bits-16",
                "bits-64"
              ],
              "default": "bits-32",
              "x-wz-scope": "session",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "negotiated"
            },
            "supervision-after-expiry": {
              "description": "What a checkpoint does when it is fed after its deadline was missed.",
              "enum": [
                "latch",
                "rearm"
              ],
              "default": "latch",
              "x-wz-scope": "runtime",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "none"
            },
            "e2e-supervision-notify": {
              "description": "What a reception supervisor tells the application when a stream stops arriving.",
              "enum": [
                "status-only",
                "last-value"
              ],
              "default": "status-only",
              "x-wz-scope": "runtime",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "none"
            },
            "replay-reply-shape": {
              "description": "How a publisher's replay cache answers a query.",
              "enum": [
                "frame-per-sample",
                "segmented"
              ],
              "default": "frame-per-sample",
              "x-wz-scope": "message",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "replay-serve-holds-sends": {
              "description": "Whether a publisher's sends of a message wait while its replay cache answers a query.",
              "enum": [
                "off",
                "on"
              ],
              "default": "off",
              "x-wz-scope": "message",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "timing"
            },
            "replay-live-before-answer": {
              "description": "How a subscriber that asks for a replay orders its live samples against it.",
              "enum": [
                "deliver",
                "hold-back"
              ],
              "default": "deliver",
              "x-wz-scope": "message",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "none"
            },
            "event-ring-full": {
              "description": "Which event a full event ring gives up.",
              "enum": [
                "overwrite-oldest",
                "drop-newest"
              ],
              "default": "overwrite-oldest",
              "x-wz-scope": "runtime",
              "x-wz-binding": "live",
              "x-wz-mutability": "quiescent",
              "x-wz-boundary": "after the consumer has read every record",
              "x-wz-wire": "none"
            },
            "clock-quality-stamping": {
              "description": "Whether a node stamps data with a time it does not trust.",
              "enum": [
                "always",
                "trusted-only"
              ],
              "default": "always",
              "x-wz-scope": "runtime",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "visible"
            },
            "routing-face-drive": {
              "description": "How a node that routes for others serves its links.",
              "enum": [
                "task-per-face",
                "one-task"
              ],
              "default": "task-per-face",
              "x-wz-scope": "runtime",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "timing"
            },
            "routing-table-sharing": {
              "description": "How a node that routes for others shares its routing tables between the links that route by them and the changes made to them.",
              "enum": [
                "rwlock",
                "snapshot"
              ],
              "default": "rwlock",
              "x-wz-scope": "runtime",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "timing"
            },
            "reassembly-pool-overflow": {
              "description": "What a node does with the first fragment of a new fragmented message when every slot of its reassembly pool holds a message still arriving.",
              "enum": [
                "reject",
                "diagnostic-event",
                "oldest-wins"
              ],
              "default": "reject",
              "x-wz-scope": "session",
              "x-wz-binding": "live",
              "x-wz-mutability": "hot",
              "x-wz-wire": "none"
            },
            "link-tie-order": {
              "description": "How a node orders two zids when it and a peer dialled each other at the same moment and both ends must keep the same one of the two links: the link the node with the lower zid dialled is kept, and this says which zid is lower.",
              "enum": [
                "zid-number",
                "zid-bytes"
              ],
              "default": "zid-number",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "query-unanswerable-final": {
              "description": "How a node answers a query from a peer that it cannot run at all because the query's key names an id the peer never declared to this node.",
              "enum": [
                "none",
                "empty-final"
              ],
              "default": "none",
              "x-wz-scope": "session",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "zid-derivation": {
              "description": "How a node makes its zid when the configuration states none.",
              "enum": [
                "random",
                "address-ports"
              ],
              "default": "random",
              "x-wz-scope": "runtime",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "handshake-stray-message": {
              "description": "What a unicast establishment does with an Init or an Open that is not the message its current step awaits: an InitAck repeated after the OpenSyn went out, an InitSyn repeated after the InitAck went out, or any other out of its step.",
              "enum": [
                "fail",
                "ignore",
                "ignore-and-replay"
              ],
              "default": "fail",
              "x-wz-scope": "session",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "handshake-cookie": {
              "description": "What cookie a node puts in the InitAck of a link it accepts, and what it takes back.",
              "enum": [
                "stateless",
                "fixed"
              ],
              "default": "stateless",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            },
            "key-wire-form": {
              "description": "How a node names a key on the wire to the peer of a link.",
              "enum": [
                "declared",
                "shared",
                "literal"
              ],
              "default": "declared",
              "x-wz-scope": "link",
              "x-wz-binding": "open",
              "x-wz-mutability": "fixed",
              "x-wz-wire": "visible"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "MAX_SUBSCRIPTIONS": {
              "description": "The subscribers a session holds at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_QUERYABLES": {
              "description": "The queryables a session holds at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PENDING_QUERIES": {
              "description": "The queries (gets) a session has waiting for their replies at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_DECL_OBSERVERS": {
              "description": "The observers an application installs on the declarations of its peers (subscribers, queryables and liveliness tokens appearing or leaving), per kind and per direction.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_LIVELINESS_SUBSCRIPTIONS": {
              "description": "The liveliness subscribers a session holds at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_LOCAL_TOKENS": {
              "description": "The liveliness tokens a session itself declares and holds at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PENDING_LIVELINESS_GETS": {
              "description": "The liveliness gets (snapshots of the tokens alive) a session has waiting for their answer at once.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PENDING_DECLARES": {
              "description": "The declarations a session can have ready to send in answer to its peers' interests between two sends: each answer is the session's matching declarations and a final.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_INBOUND_SUB_INTERESTS": {
              "description": "The peers' interests in this session's subscribers that the session remembers, so that a subscriber declared later is announced to them: one per publisher a peer holds with a write filter.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PEER_KEYEXPR_ALIASES": {
              "description": "The key expressions one peer may have declared to this session at a time, to name them by a short id.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_REMOTE_DECLS": {
              "description": "The declarations of one kind (subscribers, queryables, liveliness tokens) one peer may hold open to this session at a time.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PENDING_REPLIES": {
              "description": "The replies a session's queryables may have ready to send between two sends.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "MAX_PENDING_FINALS": {
              "description": "The queries a session may owe the end of an answer between two sends.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "remote",
              "x-wz-storage": "both",
              "x-wz-scope": "session",
              "x-wz-binding-heap": "open",
              "x-wz-binding-fixed": "build",
              "x-wz-wire": "none"
            },
            "QUERIER_MAX_PENDING_QUERIES": {
              "description": "The queries one declared querier may have in flight at once; one more is refused until a pending one ends.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "unbounded"
                }
              ],
              "x-wz-kind": "bound",
              "x-wz-driven": "local",
              "x-wz-storage": "quota",
              "x-wz-scope": "entity",
              "x-wz-binding-heap": "live",
              "x-wz-binding-fixed": "none",
              "x-wz-wire": "none"
            }
          },
          "additionalProperties": false
        },
        "key-ids": {
          "description": "The key ids every node of a deployment shares (the shared-key-ids capability): a dictionary of key expressions by id, and the key-wire form of an endpoint stated apart from the session's.",
          "type": "object",
          "properties": {
            "dictionary": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "key"
                ],
                "additionalProperties": false
              }
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "form": {
                    "enum": [
                      "declared",
                      "shared",
                      "literal"
                    ]
                  }
                },
                "required": [
                  "locator",
                  "form"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
