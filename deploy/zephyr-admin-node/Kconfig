mainmenu "wz Zephyr admin node"

rsource "../zephyr-common/Kconfig.wz"

choice WZ_NET_BACKEND
	prompt "Network stack the admin node runs over"
	default WZ_NET_BACKEND_ZEPHYR_SOCKETS
	help
	  The node is the same on every board; what differs is the stack under it,
	  which the board's Ethernet driver decides.

config WZ_NET_BACKEND_ZEPHYR_SOCKETS
	bool "Zephyr's own network stack and BSD sockets"
	help
	  For a board whose Ethernet, Wi-Fi or modem Zephyr drives. The interface, its
	  address (DHCP or Kconfig) and its link-layer identity are Zephyr's.

config WZ_NET_BACKEND_LWIP_MAC
	bool "lwIP over an Ethernet MAC the wz crates drive"
	help
	  For a board whose Ethernet controller Zephyr has no driver for. Zephyr is the
	  kernel only (threads, clock, heap, console): the network is lwIP, polled from
	  the node's loop, over a wz `EthernetMac` crate for the chip. The interface
	  address and the MAC address are the board's Kconfig, since no Zephyr
	  interface exists to ask.

endchoice

# What the Zephyr-sockets backend needs of Zephyr is stated HERE, as defaults of
# the symbols it needs, rather than as lines in prj.conf: the other backend then
# does not inherit a network stack it does not use, and a board conf never has to
# turn a stack off to avoid one. Nothing here is a QEMU setting.
if WZ_NET_BACKEND_ZEPHYR_SOCKETS

config NETWORKING
	default y

config NET_IPV4
	default y

config NET_IPV6
	default n

config NET_UDP
	default y

config NET_TCP
	default n

config NET_L2_ETHERNET
	default y

config NET_MAX_CONTEXTS
	default 8

config POSIX_NETWORKING
	default y

config POSIX_DEVICE_IO
	default y

config NET_CONFIG_SETTINGS
	default y

config NET_CONFIG_NEED_IPV4
	default y

config NET_DHCPV4
	default y

endif # WZ_NET_BACKEND_ZEPHYR_SOCKETS

if WZ_NET_BACKEND_LWIP_MAC

choice WZ_MAC
	prompt "The Ethernet MAC"

config WZ_MAC_CYT4BF
	bool "Infineon CYT4BF (T2G) ETH0, RMII"
	depends on SOC_FAMILY_INFINEON_CAT1C
	select WZ_ENTROPY_BOARD_HOOK
	select WZ_CORE_CLOCK_BOARD_HOOK
	help
	  The MXETH block of the CYT4BF family (a Cadence GEM) through
	  `wz-eth-mac-cyt4bf`, with the PHY on its RMII port. The random source is the
	  chip's own TRNG in the CRYPTO block, through the board hook, and the core
	  clock the image checks at boot is read from the clock registers the same way.

endchoice

choice WZ_MAC_SOURCE
	prompt "Where the station address comes from"
	default WZ_MAC_SOURCE_RANDOM
	help
	  The MAC answers to this address and the node's zenoh id is derived from it.
	  The address is not read off the board: this chip has no MAC EEPROM, and the
	  HAL this tree carries has no per-unit identifier for it (the unique-id call
	  is the M4, M33 and M55 parts', and the CYT4BF's flash block names only its
	  silicon type). So there is no default VALUE, because a value every build
	  shares is one that two boards on a network would both answer to, as frames
	  and as zenoh ids.

config WZ_MAC_SOURCE_RANDOM
	bool "A random address, made at every boot"
	help
	  A locally administered unicast address drawn from the board's entropy source
	  each time the node starts. Two boards do not collide, to within the chance of
	  two 46-bit draws agreeing; neither the address nor the zenoh id derived from
	  it survives a reboot.

config WZ_MAC_SOURCE_EXPLICIT
	bool "The address in CONFIG_WZ_MAC_ADDRESS"
	help
	  A fixed address, which survives reboots. It has to be given, and it has to
	  differ per board. The MAC crate refuses a group or all-zero address when the
	  node starts, and the build refuses an empty one.

endchoice

config WZ_MAC_ADDRESS
	string "Station (MAC) address"
	depends on WZ_MAC_SOURCE_EXPLICIT
	help
	  Six hexadecimal bytes separated by colons, for example "02:00:5e:12:34:56". A
	  locally administered address has bit 1 of its first byte set; a group address
	  has bit 0 set and is refused.

config WZ_STATIC_IPV4
	string "IPv4 address"
	default "192.168.100.10"
	help
	  The address the node listens on and advertises. There is no DHCP client in
	  this backend.

config WZ_STATIC_NETMASK
	string "IPv4 netmask"
	default "255.255.255.0"

config WZ_STATIC_GATEWAY
	string "IPv4 gateway (0.0.0.0 for none)"
	default "0.0.0.0"

config WZ_LINK_WAIT_MS
	int "How long to wait for the link at boot, in milliseconds"
	default 5000
	help
	  The node starts without a link once this passes, and picks the link up when it
	  appears.

if WZ_MAC_CYT4BF

config WZ_CYT4BF_REF_CLOCK_INTERNAL
	bool "The MAC supplies the RMII reference clock (internal PLL)"
	help
	  Leave off when the PHY drives REF_CLK, as it does on a board whose PHY has its
	  own crystal and a 50 MHz output.

config WZ_CYT4BF_REF_CLOCK_DIVIDER
	int "Divider of the internal reference clock (1 to 256)"
	default 1
	depends on WZ_CYT4BF_REF_CLOCK_INTERNAL

config WZ_CYT4BF_TX_POOL
	bool "Send the node's datagrams from transmit pool slots the MAC reads in place"
	help
	  ARCHITECTURE section 9.1. A transmit pool of 8 slots of 1536 bytes
	  (sources/network/session_tx_pool_mcu.scxml) is placed in the
	  non-cacheable section beside the MAC's rings. The session encodes each
	  outbound datagram into a slot, lwIP writes its headers in front of it in
	  the same slot, and the MAC's transmit descriptor is written with the
	  slot's address, so the controller reads the frame where it was encoded.
	  A datagram the session hands over as bytes (a keep-alive, a close, a
	  handshake frame) is copied into a slot and read there as well. Every
	  other frame lwIP sends (ARP and ICMP, from its own heap, which is cached
	  memory this board does not clean) is copied into the ring, as without
	  this.

	  The console prints where the pool is, and every 10 seconds, when they
	  moved, the counts that tell a frame read out of a slot from a copy
	  (HARDWARE_VERDICT.md, steps HW.26 to HW.30). Off by default: nothing has
	  run on silicon with it.

config WZ_CYT4BF_RX_POOL
	bool "Receive the node's frames into pool slots and read them where they lie"
	help
	  ARCHITECTURE section 9.2. A receive pool of 16 slots of 1536 bytes
	  (sources/network/eth_rx_pool_mcu.scxml) is placed in the
	  non-cacheable section beside the MAC's rings, and the MAC's receive
	  descriptors are armed with its slots instead of buffers of the MAC's
	  own. A received frame is lent to lwIP in the slot the controller wrote
	  it into, the descriptor is armed again at once with another slot, and
	  the session socket keeps a lent datagram as it arrived, so the session
	  dispatches it from the slot (the session loop's in-place receive). A
	  datagram lwIP reassembles from fragments, and a frame past the eight
	  lwIP may hold lent, is copied as without this.

	  The console prints where the pool is, and every 10 seconds, when they
	  moved, the counts that tell a frame read in its slot from a copy
	  (HARDWARE_VERDICT.md, steps HW.31 to HW.35). Off by default: nothing
	  has run on silicon with it.

choice WZ_CYT4BF_PINS
	prompt "ETH0 pin routing"

config WZ_CYT4BF_PINS_T2G_LITE
	bool "KIT_T2G-B-H_LITE (176-pin package, DP83825I over RMII)"
	help
	  REF_CLK P18_0, TX_EN P18_1, TXD0/1 P18_4/P18_5, RXD0/1 P19_0/P19_1, CRS_DV
	  P21_5, MDIO P3_0, MDC P3_1: the 176-pin package's ETH0 functions, which the
	  PDL's pin table lists, on the pins that kit's schematic uses.

endchoice

config WZ_T2G_SPI_PROBE
	bool "Read the TC6 identity registers on the MikroBUS socket at boot"
	depends on WZ_CYT4BF_PINS_T2G_LITE
	select USE_INFINEON_SPI
	help
	  Opens SCB3 as an SPI master on the kit's MikroBUS socket, reads the two TC6
	  identity registers (OA_ID and OA_PHYID, at the same addresses on every TC6
	  device) and logs them, then carries on starting the network. It is how a lab
	  learns which chip an expansion board carries without a datasheet, and the
	  first thing that would show the SPI master working on silicon.

	  Nothing is written to the device and no frame is moved. SPI mode 0, eight-bit
	  elements, as Zephyr's TC6 chip driver opens its device.

config WZ_SPI_PROBE_HZ
	int "SPI rate of the probe, in hertz"
	depends on WZ_T2G_SPI_PROBE
	default 1000000
	help
	  The highest rate the probe asks for; the block gives the highest it can make
	  that does not exceed it, and the log line says what it gave. This is well
	  under any TC6 chip's limit on purpose: the probe reads an identity.

config WZ_SCB_SPI_TIMEOUT_MS
	int "How long one SPI exchange may take, in milliseconds"
	depends on WZ_T2G_SPI_PROBE || WZ_T1S
	default 100
	help
	  A bound on a wait for the block, so a block that never answers fails the
	  exchange instead of hanging the node. It is a safety net, not a protocol
	  timing: no exchange of at most 128 bytes at any rate this build asks for takes
	  a sizable fraction of it.

config WZ_T1S
	bool "A 10BASE-T1S LAN8650/1 on the MikroBUS socket, as a second interface"
	depends on WZ_CYT4BF_PINS_T2G_LITE
	select USE_INFINEON_SPI
	help
	  Adds the Microchip LAN8650/1 MAC-PHY of an expansion board in the kit's
	  MikroBUS socket to the one lwIP stack, beside the onboard RMII port: SCB3 as
	  its SPI master, the chip's bring-up (wz-eth-lan865x) and the interface's
	  address, below. The node then listens on both interfaces and advertises a
	  locator for each. The onboard port stays the first interface, so the node's
	  id is its address and the default route is the first interface that has a
	  gateway.

	  A board is not stated to be in the socket by the kit, which ships with none:
	  this is for a lab that has plugged one in, and an image built with it stops
	  with a FAIL line when the socket does not answer as a LAN8650/1.

	  It excludes the SPI probe, and the build refuses the two together: the probe
	  opens the same SCB, and the bring-up reads the identity register itself and
	  logs what it found. (A Kconfig dependency would only turn this symbol off
	  with a warning, and the build would go on without the interface.)

if WZ_T1S

config WZ_T1S_SPI_HZ
	int "SPI rate, in hertz"
	default 1000000
	help
	  The highest rate asked for; the block gives the highest it can make that does
	  not exceed it, and the log line says what it gave. The default is the SPI
	  probe's own default (CONFIG_WZ_SPI_PROBE_HZ), a starting value well under the
	  chip's limit of 25 MHz (DS60001734F, Table 9-9), not a limit of the node: at
	  it the SPI clock and not the segment's 10 Mbit/s bounds the throughput. Raise
	  it once the wiring of the expansion board has been shown to carry a faster
	  clock.

config WZ_T1S_SERVICE_MS
	int "How often the chip's housekeeping runs, in milliseconds"
	default 100
	help
	  The housekeeping is one footer exchange and, with PLCA, one register read. It
	  finds a chip that was reset (and configures it again) and keeps collision
	  detection in step with PLCA. This is how long a reset or a PLCA change can go
	  unnoticed; it is not a protocol timing.

config WZ_T1S_RESET_LINE
	bool "The expansion board wires the chip's RESET_N to the socket's RST pin"
	help
	  Only the lab knows what its expansion board connects. When on, the node holds
	  RST low for 10 microseconds (the data sheet asks for at least 5, DS60001734F
	  Table 9-8) before it talks to the chip. When off, the pin is not touched and
	  the chip is reset only by the soft reset the bring-up issues, which is enough
	  for a chip that reset itself when the board was powered.

config WZ_T1S_RESET_WAIT_MS
	int "How long to wait for the chip after releasing RST, in milliseconds"
	depends on WZ_T1S_RESET_LINE
	default 10
	help
	  After a reset the chip asserts IRQ_N to say it is ready (DS60001734F 4.1.2),
	  but the data sheet gives no time for it, and the one entry of its wake-up
	  table that would (Table 9-14, SPI valid after power) is empty. 10 ms is the
	  bound Zephyr's own driver for this chip waits for that signal, so it is a
	  figure that driver has run with, not the vendor's. With the interrupt line
	  wired the node waits for the signal and fails at this bound; without it the
	  node waits this long.

config WZ_T1S_IRQ_LINE
	bool "The expansion board wires the chip's IRQ_N to the socket's INT pin"
	help
	  Only the lab knows what its expansion board connects. When on, the node reads
	  the pin's level so that a receive costs no SPI exchange while the chip has
	  nothing to say. When off, every pass of the node's loop asks the chip.

config WZ_T1S_PLCA
	bool "Use PLCA (physical layer collision avoidance)"
	default y
	help
	  A segment with more than two nodes wants PLCA. Turn it off to run the chip as
	  it is after a reset, plain CSMA/CD. With it on, the node id and count below
	  are required and have no default: an id must differ per node, and a value
	  every build shares would give every node the same one.

config WZ_T1S_PLCA_NODE_ID
	int "PLCA node id (0 coordinator, 1 to 254 follower)"
	depends on WZ_T1S_PLCA
	help
	  Unique on the segment (DS60001734F 11.5.59). Id 0 is the coordinator, which
	  sends the periodic BEACON; exactly one node has it. No default: the build
	  refuses an empty or out-of-range value.

config WZ_T1S_PLCA_NODE_COUNT
	int "PLCA node count (1 to 255)"
	depends on WZ_T1S_PLCA
	help
	  The number of transmit opportunities in a bus cycle: the highest node id on
	  the segment plus one (AN1760, DS60001760G). The coordinator writes it to the
	  chip; a follower's chip ignores it, but it must exceed the follower's own id
	  for that follower to get a turn (DS60001734F 7.2), and the build checks that.
	  No default.

config WZ_T1S_ACCEPT_ALL_MULTICAST
	bool "Accept every multicast frame"
	default y
	help
	  The chip's filter is the same one the onboard MAC's default sets: on, the
	  node receives the groups zenoh scouting uses. A unicast-only node can turn it
	  off.

config WZ_T1S_MAC_ADDRESS
	string "Station (MAC) address of the 10BASE-T1S interface"
	depends on WZ_MAC_SOURCE_EXPLICIT
	help
	  As CONFIG_WZ_MAC_ADDRESS, for this interface: six hexadecimal bytes separated
	  by colons, unicast, not zero and different from the onboard port's. The
	  chip's MAC also seeds its CSMA/CD back-off from it, so it is to be unique on
	  the segment (DS60001734F 6.4.2). With the address drawn at boot (the default
	  source), a second address is drawn for this interface.

config WZ_T1S_IPV4
	string "IPv4 address of the 10BASE-T1S interface"
	help
	  No default: a segment has several nodes and an address every build shares is
	  one two of them would both answer to. It must be on a different network from
	  the onboard port's (the node would not know which interface to send by), and
	  the build refuses one that is not.

config WZ_T1S_NETMASK
	string "IPv4 netmask of the 10BASE-T1S interface"
	default "255.255.255.0"

config WZ_T1S_GATEWAY
	string "IPv4 gateway of the 10BASE-T1S interface (0.0.0.0 for none)"
	default "0.0.0.0"
	help
	  An interface with a gateway can be the node's default route; the first
	  interface added that has one is, and the onboard port is added first. With
	  none, this interface is on-link only and never takes the route.

config WZ_T1S_BUILD_VALUES_ONLY
	bool "The values of this build were made up for a build"
	help
	  Set by overlays/t2g_t1s_build_values.conf and by nothing else: the numbers Layer
	  Qzb builds with, which describe no segment. With it on, the 10BASE-T1S bring-up
	  prints a FAIL-style line naming the made-up values before it starts, so that an
	  image that reached a bench with them says so. The board table's gate keeps the
	  overlay off any row that claims hardware. Never set it in a lab's own settings:
	  a lab's values are its own, and leave it off.

endif # WZ_T1S

endif # WZ_MAC_CYT4BF

endif # WZ_NET_BACKEND_LWIP_MAC

source "Kconfig.zephyr"
