mainmenu "wz Zephyr admin node"

rsource "../zephyr-common/Kconfig.wz"

choice WZ_NET_BACKEND
	prompt "Network stack the admin node runs over"
	default WZ_NET_BACKEND_ZEPHYR_SOCKETS
	help
	  The node is the same on every board; what differs is the stack under it,
	  which the board's Ethernet driver decides.

config WZ_NET_BACKEND_ZEPHYR_SOCKETS
	bool "Zephyr's own network stack and BSD sockets"
	help
	  For a board whose Ethernet, Wi-Fi or modem Zephyr drives. The interface, its
	  address (DHCP or Kconfig) and its link-layer identity are Zephyr's.

config WZ_NET_BACKEND_LWIP_MAC
	bool "lwIP over an Ethernet MAC the wz crates drive"
	help
	  For a board whose Ethernet controller Zephyr has no driver for. Zephyr is the
	  kernel only (threads, clock, heap, console): the network is lwIP, polled from
	  the node's loop, over a wz `EthernetMac` crate for the chip. The interface
	  address and the MAC address are the board's Kconfig, since no Zephyr
	  interface exists to ask.

endchoice

# What the Zephyr-sockets backend needs of Zephyr is stated HERE, as defaults of
# the symbols it needs, rather than as lines in prj.conf: the other backend then
# does not inherit a network stack it does not use, and a board conf never has to
# turn a stack off to avoid one. Nothing here is a QEMU setting.
if WZ_NET_BACKEND_ZEPHYR_SOCKETS

config NETWORKING
	default y

config NET_IPV4
	default y

config NET_IPV6
	default n

config NET_UDP
	default y

config NET_TCP
	default n

config NET_L2_ETHERNET
	default y

config NET_MAX_CONTEXTS
	default 8

config POSIX_NETWORKING
	default y

config POSIX_DEVICE_IO
	default y

config NET_CONFIG_SETTINGS
	default y

config NET_CONFIG_NEED_IPV4
	default y

config NET_DHCPV4
	default y

endif # WZ_NET_BACKEND_ZEPHYR_SOCKETS

if WZ_NET_BACKEND_LWIP_MAC

choice WZ_MAC
	prompt "The Ethernet MAC"

config WZ_MAC_CYT4BF
	bool "Infineon CYT4BF (T2G) ETH0, RMII"
	depends on SOC_FAMILY_INFINEON_CAT1C
	select WZ_ENTROPY_BOARD_HOOK
	help
	  The MXETH block of the CYT4BF family (a Cadence GEM) through
	  `wz-eth-mac-cyt4bf`, with the PHY on its RMII port. The random source is the
	  chip's own TRNG in the CRYPTO block, through the board hook.

endchoice

choice WZ_MAC_SOURCE
	prompt "Where the station address comes from"
	default WZ_MAC_SOURCE_RANDOM
	help
	  The MAC answers to this address and the node's zenoh id is derived from it.
	  The address is not read off the board: this chip has no MAC EEPROM, and the
	  HAL this tree carries has no per-unit identifier for it (the unique-id call
	  is the M4, M33 and M55 parts', and the CYT4BF's flash block names only its
	  silicon type). So there is no default VALUE, because a value every build
	  shares is one that two boards on a network would both answer to, as frames
	  and as zenoh ids.

config WZ_MAC_SOURCE_RANDOM
	bool "A random address, made at every boot"
	help
	  A locally administered unicast address drawn from the board's entropy source
	  each time the node starts. Two boards do not collide, to within the chance of
	  two 46-bit draws agreeing; neither the address nor the zenoh id derived from
	  it survives a reboot.

config WZ_MAC_SOURCE_EXPLICIT
	bool "The address in CONFIG_WZ_MAC_ADDRESS"
	help
	  A fixed address, which survives reboots. It has to be given, and it has to
	  differ per board. The MAC crate refuses a group or all-zero address when the
	  node starts, and the build refuses an empty one.

endchoice

config WZ_MAC_ADDRESS
	string "Station (MAC) address"
	depends on WZ_MAC_SOURCE_EXPLICIT
	help
	  Six hexadecimal bytes separated by colons, for example "02:00:5e:12:34:56". A
	  locally administered address has bit 1 of its first byte set; a group address
	  has bit 0 set and is refused.

config WZ_STATIC_IPV4
	string "IPv4 address"
	default "192.168.100.10"
	help
	  The address the node listens on and advertises. There is no DHCP client in
	  this backend.

config WZ_STATIC_NETMASK
	string "IPv4 netmask"
	default "255.255.255.0"

config WZ_STATIC_GATEWAY
	string "IPv4 gateway (0.0.0.0 for none)"
	default "0.0.0.0"

config WZ_LINK_WAIT_MS
	int "How long to wait for the link at boot, in milliseconds"
	default 5000
	help
	  The node starts without a link once this passes, and picks the link up when it
	  appears.

if WZ_MAC_CYT4BF

config WZ_CYT4BF_REF_CLOCK_INTERNAL
	bool "The MAC supplies the RMII reference clock (internal PLL)"
	help
	  Leave off when the PHY drives REF_CLK, as it does on a board whose PHY has its
	  own crystal and a 50 MHz output.

config WZ_CYT4BF_REF_CLOCK_DIVIDER
	int "Divider of the internal reference clock (1 to 256)"
	default 1
	depends on WZ_CYT4BF_REF_CLOCK_INTERNAL

choice WZ_CYT4BF_PINS
	prompt "ETH0 pin routing"

config WZ_CYT4BF_PINS_T2G_LITE
	bool "KIT_T2G-B-H_LITE (176-pin package, DP83825I over RMII)"
	help
	  REF_CLK P18_0, TX_EN P18_1, TXD0/1 P18_4/P18_5, RXD0/1 P19_0/P19_1, CRS_DV
	  P21_5, MDIO P3_0, MDC P3_1: the 176-pin package's ETH0 functions, which the
	  PDL's pin table lists, on the pins that kit's schematic uses.

endchoice

config WZ_T2G_SPI_PROBE
	bool "Read the TC6 identity registers on the MikroBUS socket at boot"
	depends on WZ_CYT4BF_PINS_T2G_LITE
	select USE_INFINEON_SPI
	help
	  Opens SCB3 as an SPI master on the kit's MikroBUS socket, reads the two TC6
	  identity registers (OA_ID and OA_PHYID, at the same addresses on every TC6
	  device) and logs them, then carries on starting the network. It is how a lab
	  learns which chip an expansion board carries without a datasheet, and the
	  first thing that would show the SPI master working on silicon.

	  Nothing is written to the device and no frame is moved. SPI mode 0, eight-bit
	  elements, as Zephyr's TC6 chip driver opens its device.

config WZ_SPI_PROBE_HZ
	int "SPI rate of the probe, in hertz"
	depends on WZ_T2G_SPI_PROBE
	default 1000000
	help
	  The highest rate the probe asks for; the block gives the highest it can make
	  that does not exceed it, and the log line says what it gave. This is well
	  under any TC6 chip's limit on purpose: the probe reads an identity.

config WZ_SCB_SPI_TIMEOUT_MS
	int "How long one SPI exchange may take, in milliseconds"
	depends on WZ_T2G_SPI_PROBE
	default 100
	help
	  A bound on a wait for the block, so a block that never answers fails the
	  exchange instead of hanging the node. It is a safety net, not a protocol
	  timing: no exchange of at most 128 bytes at any rate this build asks for takes
	  a sizable fraction of it.

endif # WZ_MAC_CYT4BF

endif # WZ_NET_BACKEND_LWIP_MAC

source "Kconfig.zephyr"
