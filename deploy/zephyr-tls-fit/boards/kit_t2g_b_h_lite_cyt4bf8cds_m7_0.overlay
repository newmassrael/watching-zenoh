 *
 * The T2G kit's TRNG as the entropy device: the same node as the admin node's
 * overlays/t2g_zeth.overlay. No Ethernet node: the fit image has no network.
 */

/ {
	chosen {
		zephyr,entropy = &wz_trng;
	};

	wz_trng: wz-trng {
		compatible = "wz,cyt4bf-trng";
	};
};
