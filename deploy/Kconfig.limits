# GENERATED from deploy/wz-config.toml by scripts/lib/wz_config.py --emit kconfig-limits.
# Do not edit: `wz_config.py --check` fails when this file is stale.

menu "wz limits"

comment "Each limit sizes a table of every session of the image; a build states its own."

config WZ_LIMITS_ZENOH_PICO
	bool "The limits zenoh-pico bounds by no constant, at what its own build holds"
	help
	  Each limit zenoh-pico bounds by no constant of its own (its entity tables, the
	  gets and replies a session holds, the delivery lane) defaults to the value of
	  the pico preset instead of the one that sizes a host's session: what zenoh-pico's
	  own examples and its API tests hold at once. zenoh-pico's defconfig turns it on;
	  an image of the pico C ABI turns it on to be sized as zenoh-pico is. A limit the
	  image states is its own either way.

config WZ_LIMIT_MAX_KEYEXPR_BYTES
	int "MAX_KEYEXPR_BYTES"
	default 256
	help
	  The longest key expression, in bytes, a session stores: a subscription's
	  pattern, or a key a peer declared. A longer one is refused, never cut short.
	  Every table that stores keys sizes its rows by this.

config WZ_LIMIT_KEY_ARENA_BYTES
	int "KEY_ARENA_BYTES"
	range 1 4294967291
	default 4096 if WZ_LIMITS_ZENOH_PICO
	default 97152
	help
	  How many bytes of key text the rows of a session's tables hold at once, in one
	  arena each row keeps its key in: the session's own declarations, the
	  application's tables, its pending gets and what each peer declares to it. Each
	  key takes 8 bytes and its length, rounded up to 4. A declaration of the session
	  whose key finds no room is refused, as one that finds its table full is; one
	  a peer sends is dropped and counted. A key given back is taken again. It must
	  be at least 1.

config WZ_LIMIT_MAX_SUBSCRIPTIONS
	int "MAX_SUBSCRIPTIONS"
	default 100
	help
	  The subscribers a session holds at once. Declaring one more is refused
	  while the table is full.

config WZ_LIMIT_MATCH_MEMO_SLOTS
	int "MATCH_MEMO_SLOTS"
	range 0 4294967295
	default 8
	help
	  How many distinct keys the receive match cache remembers at once: the keys
	  whose matching subscriptions it can answer without matching again. It is a
	  direct-mapped table, so a key that maps to a used slot replaces what was
	  there. More slots keep more keys at the cost of memory. 0 leaves the cache
	  out: every message is matched against the subscriptions, which reaches the
	  same subscribers in the same order, as zenoh-pico does where its
	  Z_FEATURE_RX_CACHE is off (its default). A build whose tables are fixed in
	  size reads MATCH_MEMO_FIXED_SLOTS instead: its cache is paid for in RAM
	  whether used or not, a heap's only as it fills.

config WZ_LIMIT_MATCH_MEMO_FIXED_SLOTS
	int "MATCH_MEMO_FIXED_SLOTS"
	range 0 4294967295
	default 0
	help
	  MATCH_MEMO_SLOTS for a build whose tables are fixed in size (no allocator,
	  or the fixed storage policy): how many distinct keys the receive match cache
	  remembers, each held in RAM for good, a key's text of up to
	  MATCH_MEMO_KEY_BYTES bytes plus the subscriptions it matched. 0 (the
	  default) leaves the cache out, so a build that does not ask for it pays
	  nothing; every message is then matched against the subscriptions, which
	  reaches the same subscribers in the same order. A closed key set needs no
	  cache for the keys of its table.

config WZ_LIMIT_MATCH_MEMO_KEY_BYTES
	int "MATCH_MEMO_KEY_BYTES"
	range 0 4294967295
	default 64
	help
	  The longest key, in bytes, the receive match cache of a fixed-size build
	  remembers. A longer key is matched every time it arrives, never cut short.
	  Read only where MATCH_MEMO_FIXED_SLOTS is above 0.

config WZ_LIMIT_DELIVERY_LANE_EVENTS
	int "DELIVERY_LANE_EVENTS"
	default 64
	help
	  How many samples the delivery lane of an offloaded subscriber holds at once:
	  the samples the receive path has copied in and its callback has not yet run
	  on. A sample past this is refused and counted. It must be at least 1.

config WZ_LIMIT_DELIVERY_LANE_BYTES
	int "DELIVERY_LANE_BYTES"
	range 1 4294967295
	default 4768 if WZ_LIMITS_ZENOH_PICO
	default 65536
	help
	  How many bytes of copied samples a delivery lane holds at once: the key, the
	  payload, the attachment and the encoding schema of each waiting sample, the
	  ids of the subscribers a sample written once for several of them is for, and
	  the end of the byte area a sample skipped to stay in one piece. A sample that
	  does not fit is refused and counted. It must be at least 1.

config WZ_LIMIT_DELIVERY_LANE_CALLBACKS
	int "DELIVERY_LANE_CALLBACKS"
	default 64 if WZ_LIMITS_ZENOH_PICO
	default 256
	help
	  How many callback invocations a delivery lane owes at once. A host that admits
	  a sample once for each subscription it reaches owes one callback per sample, so
	  this binds only past the event limit and is left larger than it; a host that
	  admits a sample once for all its subscriptions owes several. It must be at
	  least 1.

config WZ_LIMIT_MAX_QUERYABLES
	int "MAX_QUERYABLES"
	default 100
	help
	  The queryables a session holds at once. Declaring one more is refused
	  while the table is full.

config WZ_LIMIT_MAX_PENDING_QUERIES
	int "MAX_PENDING_QUERIES"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The queries (gets) a session has waiting for their replies at once.
	  Issuing one more is refused while the table is full.

config WZ_LIMIT_LINK_NOTED_REQUESTS
	int "LINK_NOTED_REQUESTS"
	range 1 4294967295
	default 16
	help
	  How many queries a peer sent over one link the node remembers the key form of
	  at once, so that its replies name the key as the query did, when the link names
	  keys by the shared key ids. A query never ended gives way to the newest, so a
	  peer cannot grow the table. It sizes a memory, not a bound: a query past it is
	  still answered.

config WZ_LIMIT_MAX_DECL_OBSERVERS
	int "MAX_DECL_OBSERVERS"
	default 8
	help
	  The observers an application installs on the declarations of its peers
	  (subscribers, queryables and liveliness tokens appearing or leaving), per
	  kind and per direction. They are installed once at start, so few are
	  needed; one more is refused.

config WZ_LIMIT_MAX_LIVELINESS_SUBSCRIPTIONS
	int "MAX_LIVELINESS_SUBSCRIPTIONS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The liveliness subscribers a session holds at once. Declaring one more
	  is refused while the table is full.

config WZ_LIMIT_MAX_LOCAL_TOKENS
	int "MAX_LOCAL_TOKENS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The liveliness tokens a session itself declares and holds at once.
	  Declaring one more is refused while the table is full.

config WZ_LIMIT_MAX_PUBLISHERS
	int "MAX_PUBLISHERS"
	default 100
	help
	  The publishers a session holds at once, each with the write filter that
	  asks whether anything subscribes to its key. Declaring one more is
	  refused while the table is full.

config WZ_LIMIT_MAX_QUERIERS
	int "MAX_QUERIERS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The queriers a session holds at once, each with the write filter that
	  asks whether anything answers on its key. Declaring one more is refused
	  while the table is full.

config WZ_LIMIT_MAX_MATCHING_LISTENERS
	int "MAX_MATCHING_LISTENERS"
	default 1 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The matching listeners a session holds at once, over all its publishers
	  and queriers. Declaring one more is refused while the table is full.

config WZ_LIMIT_MAX_DECLARED_KEYEXPRS
	int "MAX_DECLARED_KEYEXPRS"
	default 306 if WZ_LIMITS_ZENOH_PICO
	default 332
	help
	  The key expressions a session declares to its peers at once, each held by
	  the entities that name it and by the program's declarations. Declaring
	  one more distinct key is refused while the table is full.

config WZ_LIMIT_HELD_SESSIONS
	int "HELD_SESSIONS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 4
	help
	  The sessions a program of the pico C ABI holds open at once: the slots of
	  the pool of sessions the library reserves at its first object when the
	  program reserved none (object-pool). One more is refused at its open.

config WZ_LIMIT_HELD_SAMPLES
	int "HELD_SAMPLES"
	default 5 if WZ_LIMITS_ZENOH_PICO
	default 18
	help
	  The owned samples a program of the pico C ABI holds at once (taken out of
	  a callback, cloned, or held in a channel): the slots of the pool of samples
	  the library reserves at its first object when the program reserved none
	  (object-pool). One more is refused, its source untouched.

config WZ_LIMIT_HELD_REPLIES
	int "HELD_REPLIES"
	default 3 if WZ_LIMITS_ZENOH_PICO
	default 18
	help
	  The owned replies and reply errors a program of the pico C ABI holds at
	  once: the slots of the pool of replies the library reserves at its first
	  object when the program reserved none (object-pool). One more is refused,
	  its source untouched.

config WZ_LIMIT_HELD_QUERIES
	int "HELD_QUERIES"
	default 3 if WZ_LIMITS_ZENOH_PICO
	default 18
	help
	  The owned queries a program of the pico C ABI holds at once, each keeping
	  its query's answer open: the slots of the pool of queries the library
	  reserves at its first object when the program reserved none (object-pool).
	  One more is refused, its source untouched.

config WZ_LIMIT_HELD_PAYLOADS
	int "HELD_PAYLOADS"
	default 3 if WZ_LIMITS_ZENOH_PICO
	default 32
	help
	  The owned payloads (z_owned_bytes_t) a program of the pico C ABI holds at
	  once: the slots of the pool of payloads the library reserves at its first
	  object when the program reserved none (object-pool). A constructor past it
	  answers out of memory and leaves its payload null.

config WZ_LIMIT_HELD_CONFIGS
	int "HELD_CONFIGS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The configs (z_owned_config_t) a program of the pico C ABI holds at once,
	  each from z_config_default or z_config_clone to its move into an open or a
	  scout, or its drop: the slots of the pool of configs the library reserves at
	  its first object, each the size of one config of the build. One more is
	  refused with _Z_ERR_SYSTEM_OUT_OF_MEMORY and left null.

config WZ_LIMIT_HELD_HELLOS
	int "HELD_HELLOS"
	default 1 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The hellos a program of the pico C ABI keeps at once (z_hello_clone), each
	  with as many locators as a scouting window keeps of one Hello: the slots of
	  the pool of kept hellos the library reserves at its first object. One more
	  is refused with _Z_ERR_SYSTEM_OUT_OF_MEMORY and left null.

config WZ_LIMIT_HELD_PAYLOAD_BYTES
	int "HELD_PAYLOAD_BYTES"
	default 32768 if WZ_LIMITS_ZENOH_PICO
	default 131072
	help
	  The bytes the owned payloads, strings and slices a program of the pico C ABI
	  holds carry at once: the payloads' area the library reserves at its first
	  object, in blocks of power-of-two sizes from 32 bytes, each payload taking the
	  smallest that holds its bytes and a 16-byte head. A payload no free block
	  holds is refused with _Z_ERR_SYSTEM_OUT_OF_MEMORY and left null. At most 1 GiB.

config WZ_LIMIT_HELD_ENCODINGS
	int "HELD_ENCODINGS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The encodings (z_owned_encoding_t) a program of the pico C ABI holds at once,
	  each with a schema of up to MAX_ENCODING_SCHEMA_BYTES bytes: the slots of the
	  pool of encodings the library reserves at its first object. An encoding takes
	  one from the constructor or clone that makes it until it is dropped or moved
	  into the call it describes, and a declared publisher's for as long as the
	  publisher stands. One more is refused with _Z_ERR_SYSTEM_OUT_OF_MEMORY and
	  left null.

config WZ_LIMIT_MAX_ENCODING_SCHEMA_BYTES
	int "MAX_ENCODING_SCHEMA_BYTES"
	range 0 65535
	default 32 if WZ_LIMITS_ZENOH_PICO
	default 256
	help
	  The longest schema, in bytes, an encoding a program of the pico C ABI builds
	  may carry, and the room each place that keeps an encoding to send it later
	  holds for one: a slot of the pool of encodings, and a publication handed on to
	  the next holder of a session. A longer schema is refused with
	  _Z_ERR_SYSTEM_OUT_OF_MEMORY, never cut short. A schema a peer sends is read
	  where it lies and is not bound by this. At most 65,535.

config WZ_LIMIT_CONFIG_ENTRIES
	int "CONFIG_ENTRIES"
	range 1 255
	default 8 if WZ_LIMITS_ZENOH_PICO
	default 32
	help
	  The numbered keys one config of the pico C ABI holds at once (z_config_default,
	  zp_config_insert): the rows of its table, part of the config object. A new key
	  past them is refused with _Z_ERR_CONFIG_FAILED_INSERT and the config keeps what
	  it held; a key it holds is still replaced. From 1 to 255.

config WZ_LIMIT_MAX_SCOUT_HELLOS
	int "MAX_SCOUT_HELLOS"
	default 1 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The Hellos one scouting window records: the rows of its table, each a node
	  that answered with its locators. A Hello past them is not recorded and the
	  window counts it; the window still runs its budget out. The open's lookup,
	  which ends at the first Hello, takes one.

config WZ_LIMIT_SCOUT_HELLO_LOCATORS
	int "SCOUT_HELLO_LOCATORS"
	default 8
	help
	  The locators a scouting window keeps of one Hello, each at most
	  MAX_LOCATOR_LEN bytes, in a text of the Hello's row. A locator past them, or
	  a longer one, is skipped, never cut short, and counted with the Hello.

config WZ_LIMIT_CONFIG_DOCUMENT_DEPTH
	int "CONFIG_DOCUMENT_DEPTH"
	range 3 64
	default 16
	help
	  How deep the zenoh JSON5 document a config of the pico C ABI is handed
	  (wz_ext_config_document) may nest, the outermost object being 1: the reader
	  walks the document keeping no tree, and this bounds the values it steps over.
	  A deeper document is refused with _Z_ERR_CONFIG_INVALID_VALUE and the config
	  keeps what it held. From 3, which the wz member's policies and limits take.

config WZ_LIMIT_CONFIG_TEXT_BYTES
	int "CONFIG_TEXT_BYTES"
	range 1 1048576
	default 256 if WZ_LIMITS_ZENOH_PICO
	default 16384
	help
	  The bytes of value text one config of the pico C ABI holds, each value with
	  its terminator, part of the config object. A key's new value is written over
	  its old place when it fits there, else after the last value. A value that
	  finds no room is refused with _Z_ERR_CONFIG_FAILED_INSERT and the config keeps
	  what it held. At least 1.

config WZ_LIMIT_MAX_PENDING_LIVELINESS_GETS
	int "MAX_PENDING_LIVELINESS_GETS"
	default 1 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The liveliness gets (snapshots of the tokens alive) a session has waiting
	  for their answer at once. A get ends as soon as its answer is complete, so
	  few are waiting together; one more is refused while the table is full.

config WZ_LIMIT_MAX_PENDING_DECLARES
	int "MAX_PENDING_DECLARES"
	default 101
	help
	  The declarations a session can have ready to send in answer to its peers'
	  interests between two sends: each answer is the session's matching
	  declarations and a final. An answer that does not fit whole is refused and
	  counted, never sent in part.

config WZ_LIMIT_MAX_INBOUND_SUB_INTERESTS
	int "MAX_INBOUND_SUB_INTERESTS"
	default 16
	help
	  The peers' interests in this session's subscribers that the session
	  remembers, so that a subscriber declared later is announced to them: one
	  per publisher a peer holds with a write filter. Past it a peer still gets
	  the subscribers of the moment, not the later ones.

config WZ_LIMIT_MAX_PEER_KEYEXPR_ALIASES
	int "MAX_PEER_KEYEXPR_ALIASES"
	default 16
	help
	  The key expressions one peer may have declared to this session at a time,
	  to name them by a short id. One more is refused and counted, and a message
	  that names it is dropped, as one naming an undeclared id is.

config WZ_LIMIT_MAX_SHARED_KEY_IDS
	int "MAX_SHARED_KEY_IDS"
	default 256
	help
	  The entries of the key-id dictionary every node of a deployment shares
	  (shared-key-ids) that one session may be given. A dictionary of more is
	  refused when it is handed over, and no session holds it.

config WZ_LIMIT_MAX_REMOTE_DECLS
	int "MAX_REMOTE_DECLS"
	default 16
	help
	  The declarations of one kind (subscribers, queryables, liveliness tokens)
	  one peer may hold open to this session at a time. One more is refused and
	  counted, and the application is not told of it.

config WZ_LIMIT_MAX_PENDING_REPLIES
	int "MAX_PENDING_REPLIES"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The replies a session's queryables may have ready to send between two
	  sends. One more is refused and counted, and the handler that made it is
	  told.

config WZ_LIMIT_MAX_PENDING_FINALS
	int "MAX_PENDING_FINALS"
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 8
	help
	  The queries a session may owe the end of an answer between two sends. A
	  query that would need one more is refused, and counted, before its
	  queryables run: an answer that could not be ended would leave the asker
	  waiting until its own timeout.

config WZ_LIMIT_MAX_REPLY_PAYLOAD_BYTES
	int "MAX_REPLY_PAYLOAD_BYTES"
	default 1024
	help
	  The largest payload of one reply, in bytes, and the largest attachment
	  beside it. A larger reply is refused, never cut short.

config WZ_LIMIT_MAX_ADMIN_REPLY_BYTES
	int "MAX_ADMIN_REPLY_BYTES"
	default 1024
	help
	  The largest admin space reply, in bytes. A larger one is refused, counted,
	  and answered to the asker as an error, never cut short. It cannot exceed
	  the largest reply payload (WZ_LIMIT_MAX_REPLY_PAYLOAD_BYTES).

config WZ_LIMIT_MAX_ADMIN_LOCATORS
	int "MAX_ADMIN_LOCATORS"
	default 4
	help
	  The listening locators a node without an allocator reports in its admin
	  space. One more is refused when the node starts, never dropped.

config WZ_LIMIT_MAX_ADMIN_SESSION_LINKS
	int "MAX_ADMIN_SESSION_LINKS"
	default 2
	help
	  The links one session's row lists in the admin space. A unicast session
	  has one; a row with more is refused and counted, not listed in part.

config WZ_LIMIT_MAX_MULTICAST_REPLIES
	int "MAX_MULTICAST_REPLIES"
	default 8
	help
	  The replies a node holds for a multicast group before it sends them, with or
	  without an allocator. One more is dropped and counted: a group is best
	  effort, and an asker whose reply was dropped asks again.

config WZ_LIMIT_MAX_TASKS
	int "MAX_TASKS"
	default 11 if WZ_LIMITS_ZENOH_PICO
	default 16
	help
	  The most tasks a runtime holds: a ceiling on the task table a fixed-memory
	  image declares, which the image is checked against when it compiles, and on
	  the task cells a session of the C ABI's cooperative engine reserves when it
	  opens, one for each face and group its configuration admits (the dial role's
	  and MAX_FACES besides). A face or a group past them is refused, at the open
	  as out of memory and after it as a link past the faces the session admits,
	  so a preset that admits faces admits a task for each.

config WZ_LIMIT_MAX_TIMERS
	int "MAX_TIMERS"
	default 16
	help
	  The most timers a runtime holds: a ceiling on the timer table a
	  fixed-memory image declares, checked as the task ceiling is, and the entries
	  of the timer table a session of the C ABI's cooperative engine reserves when
	  it opens. A sleep past them is refused an entry and counted, and ends by
	  polling.

config WZ_LIMIT_MAX_TICKERS
	int "MAX_TICKERS"
	default 16
	help
	  The periodic jobs a session of the C ABI's cooperative engine runs at once
	  (an advanced publisher's heartbeat is one): the rows of the table the
	  session reserves when it opens. Starting one more is refused, as an engine
	  with no periodic jobs refuses it.

config WZ_LIMIT_MAX_LOCATOR_LEN
	int "MAX_LOCATOR_LEN"
	default 64
	help
	  The longest locator, in bytes, a node stores: one it is told to connect
	  to, or one it listens on (for example udp/192.168.1.10:7447). A longer one
	  is skipped, never cut short. The default fits an IPv6 locator with its
	  scheme and port.

config WZ_LIMIT_MAX_STATIC_CONNECT
	int "MAX_STATIC_CONNECT"
	default 8
	help
	  The locators a node is told to connect to. A fixed image holds this many
	  rows and names a few peers; on the heap the list grows with no bound unless
	  one is stated, and an open whose list is longer is refused by name.

config WZ_LIMIT_MAX_PEER_NODES
	int "MAX_PEER_NODES"
	default 0
	help
	  The nodes a fixed-memory image may be asked to open a session with by their
	  zid, beside the locators it is told to connect to: one a session lifecycle
	  open names, whose locators the node learned from a Hello or was built with.
	  Each holds a connection machine of some 930 bytes and its share of the
	  peer tables, so the default is 0: a node that is never asked to open a peer
	  by its zid declares none of that, and refuses the open. One more than this
	  is refused.

config WZ_LIMIT_MAX_FACES
	int "MAX_FACES"
	default 10 if WZ_LIMITS_ZENOH_PICO
	default 1000
	help
	  The faces a session that listens holds besides the one it dials: the links it
	  accepts, those still in their handshake among them, and those it attaches. A
	  link that arrives past it is closed unread. The cooperative engine lends each
	  face its tables and each link its buffers from the session's memory when it
	  opens, so a session may lower this and never raise it. The zenoh-pico
	  interface holds no face besides its dial for a session that listens on
	  nothing.

config WZ_LIMIT_MAX_ACCEPT_PENDING
	int "MAX_ACCEPT_PENDING"
	default 1 if WZ_LIMITS_ZENOH_PICO
	default 100
	help
	  The inbound links a session that listens holds in their handshake at once. A
	  link that arrives past it is closed unread. Each is one of MAX_FACES; the
	  cooperative engine lends each the buffers of one more link from the session's
	  memory when it opens, so that a link past either bound can be taken off its
	  port and closed, and a session may lower this and never raise it.

config WZ_LIMIT_RX_POOL_BUFFERS
	int "RX_POOL_BUFFERS"
	range 1 4294967295
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 4
	help
	  How many receive buffers, each of the batch a session advertises, the links of a
	  session share when its engine lends their buffers from the session's memory at
	  open. A link holds one only while it holds part of a batch the stream has not
	  finished, or a batch or datagram it was asked to keep; it reads into a free one
	  otherwise. A link that finds none free reads nothing until one is: what its peer
	  sent waits in the network stack, and nothing is lost. A pool larger than the
	  links a session may hold is held to them. At least 1; a session may lower it and
	  never raise it.

config WZ_LIMIT_TX_POOL_SLOTS
	int "TX_POOL_SLOTS"
	range 1 4294967295
	default 2 if WZ_LIMITS_ZENOH_PICO
	default 4
	help
	  How many outbound slots, each of the batch a session advertises, the links of a
	  session share when its engine lends their buffers from the session's memory at
	  open. A link holds one from the moment it encodes a frame until the frame is
	  written; a frame the stream took in part keeps it until the link's later steps
	  have written the rest. A batch frame left open for later messages keeps one only
	  while the pool keeps another free, and is sent with the messages it holds
	  otherwise. A link that finds every slot held is congested, as one whose stream
	  takes nothing is: a droppable message is dropped. A pool as large as the links a
	  session may hold keeps every link's slot its own, and is held to them. At least
	  1; a session may lower it and never raise it.

config WZ_LIMIT_SESSION_MAX_PEER_KEYEXPR_ALIASES
	int "SESSION_MAX_PEER_KEYEXPR_ALIASES"
	default 32 if WZ_LIMITS_ZENOH_PICO
	default 16016
	help
	  The key expressions all the peers of a session may have declared to it at
	  a time, each peer also held to MAX_PEER_KEYEXPR_ALIASES. One more is
	  refused and counted as one past a peer's own bound is. The cooperative
	  engine keeps them in one pool its faces share, the fewer of this and as
	  many as its faces could hold, so a peer that declares few leaves its share
	  to the others. The default is MAX_PEER_KEYEXPR_ALIASES for each face of
	  the default MAX_FACES and the dial's, so it refuses nothing a face's bound
	  admits.

config WZ_LIMIT_SESSION_MAX_REMOTE_DECLS
	int "SESSION_MAX_REMOTE_DECLS"
	default 32 if WZ_LIMITS_ZENOH_PICO
	default 16016
	help
	  The declarations of one kind (subscribers, queryables, liveliness tokens)
	  all the peers of a session may hold open to it at a time, each peer also
	  held to MAX_REMOTE_DECLS. One more is refused and counted as one past a
	  peer's own bound is, and the application is not told of it. The
	  cooperative engine keeps them in one pool of each kind its faces share,
	  the fewer of this and as many as its faces could hold. The default is
	  MAX_REMOTE_DECLS for each face of the default MAX_FACES and the dial's, so
	  it refuses nothing a face's bound admits.

config WZ_LIMIT_SESSION_MAX_INBOUND_SUB_INTERESTS
	int "SESSION_MAX_INBOUND_SUB_INTERESTS"
	default 16 if WZ_LIMITS_ZENOH_PICO
	default 16016
	help
	  The interests in this session's subscribers that all its peers may have
	  it remember at a time, each peer also held to MAX_INBOUND_SUB_INTERESTS.
	  Past it a peer still gets the subscribers of the moment, not the later
	  ones, as past a peer's own bound. The cooperative engine keeps them in one
	  pool its faces share, the fewer of this and as many as its faces could
	  hold. The default is MAX_INBOUND_SUB_INTERESTS for each face of the
	  default MAX_FACES and the dial's, so it refuses nothing a face's bound
	  admits.

config WZ_LIMIT_QUERIER_MAX_PENDING_QUERIES
	int "QUERIER_MAX_PENDING_QUERIES"
	default 0
	help
	  The queries one declared querier may have in flight at once; one more is
	  refused until a pending one ends. A query ends when its final arrives, its
	  deadline passes, or its handle is unregistered. The bound is per querier,
	  not per session, so one busy querier cannot starve another. 0 is no bound,
	  which is upstream's behaviour. Unlike the other limits this one sizes no
	  table: it only refuses the one more. It binds the queriers of the Rust session
	  API and the replay subscriber of the zenoh-pico interface.

config WZ_LIMIT_TX_NO_PROGRESS_WINDOW_US
	int "TX_NO_PROGRESS_WINDOW_US"
	range 1 5000000
	default 1000000
	help
	  How long, in microseconds, a blocking message may wait with no progress
	  when the tx-no-progress-deadline policy is on: no fragment of it going out.
	  It is read only when that policy is on, and must be at least 1 and no more
	  than the total wait before the session is closed, which is set as before.

config WZ_LIMIT_TX_EXPIRY_CLOSE_AFTER
	int "TX_EXPIRY_CLOSE_AFTER"
	range 0 65535
	default 0
	help
	  How many blocking messages in a row may find no room within their deadline
	  before the session is closed as unresponsive, when the tx-expiry-keeps-session
	  policy is on. A blocking message that does find room ends the run. 0 never
	  closes the session, which is the policy as it was before this limit. At most
	  65535, the count a session holds: a build that states more does not compile.
	  It is read only when that policy is on.

config WZ_LIMIT_DATAGRAM_FRAGMENT_BURST
	int "DATAGRAM_FRAGMENT_BURST"
	range 1 4294967295
	default 8
	help
	  How many fragments of a message a UDP link's writer writes in a row when the
	  datagram-fragment-pacing policy is on, before the next one waits for
	  DATAGRAM_FRAGMENT_GAP_US. At least 1. It is read only when that policy is on.

config WZ_LIMIT_DATAGRAM_FRAGMENT_GAP_US
	int "DATAGRAM_FRAGMENT_GAP_US"
	range 1 1000000
	default 1000
	help
	  How long, in microseconds, must pass after the last fragment was written
	  before a UDP link's writer writes another one past the burst, when the
	  datagram-fragment-pacing policy is on. At least 1 and at most 1000000 (one
	  second): a longer wait would hold a message's fragments past the time a peer
	  keeps a partly received message. The tokio engine rounds it up to its timer's
	  millisecond. It is read only when that policy is on.

config WZ_LIMIT_QUERY_PARAMETERS_MAX_BYTES
	int "QUERY_PARAMETERS_MAX_BYTES"
	default 0
	help
	  The most bytes of selector parameters a query from a peer may carry for this
	  node to run it. A query whose parameters are longer reaches no queryable, is
	  counted as refused for its size, and is still owed its final, so the asker's
	  query ends with no reply and does not wait out its timeout. 0 sets no bound,
	  which is how a node behaved before this limit. A query of the node's own
	  session is not bounded: the caller already holds what it passed.

config WZ_LIMIT_QUERY_ATTACHMENT_MAX_BYTES
	int "QUERY_ATTACHMENT_MAX_BYTES"
	default 0
	help
	  The most bytes of attachment a query from a peer may carry for this node to
	  run it. It is applied as QUERY_PARAMETERS_MAX_BYTES is: a longer attachment
	  reaches no queryable, is counted as refused for its size, and the query is
	  still owed its final. 0 sets no bound, which is how a node behaved before this
	  limit.

config WZ_LIMIT_HANDSHAKE_COOKIE_BYTES
	int "HANDSHAKE_COOKIE_BYTES"
	default 176
	help
	  How many bytes of a peer's cookie a session keeps on a fixed-memory profile:
	  the cookie in the peer's INIT acknowledgement, which the node echoes in its
	  OPEN, and the cookie a peer echoes in its OPEN, which an accepting node checks
	  against the one it issued. A longer cookie is refused where the message is read. At most 65535, the INIT cookie field's capacity, and for a
	  node that accepts sessions at least the widest cookie it issues itself: a build
	  with a smaller value does not compile. Each session holds buffers of this size,
	  so the value is memory. The growable profile keeps a cookie of any length and
	  does not read it.

config WZ_LIMIT_PICO_TX_QUEUE_SIZE
	int "PICO_TX_QUEUE_SIZE"
	range 1 16
	default 8
	help
	  How many batches each priority's outbound queue holds for the pico C ABI, in
	  1 to 16 (upstream's range for a queue size; a value outside it counts as the
	  nearest end). zenoh-pico has no bounded queue: a put writes on the calling
	  thread. The queue of this runtime is written by a second thread, and a lane
	  of two batches (upstream's default) holds four frames of 1 KiB, so the sender
	  and the writer wait for each other after every four. On the bench host the
	  no-drop rate of 1 KiB puts to a pico peer was 300 k a second with 2, 520 k
	  with 4, 960 k with 8 and 920 k with 16. The queue is a bound and not an
	  allocation: a frame takes heap only while it is queued, so a larger value
	  costs memory only under a peer that does not drain.

config WZ_LIMIT_SNAPSHOT_PERIOD_MS
	int "SNAPSHOT_PERIOD_MS"
	range 1 2147483
	default 1000
	help
	  How often, in milliseconds, the node takes a snapshot of itself: what it spends
	  and how its messages are spaced. The node holds no timer for it: the program
	  asks for a sample on its own cadence, and one is taken when this much time has
	  passed since the last. At least 1 and at most 2147483 (about 35 minutes).

config WZ_LIMIT_SNAPSHOT_HISTOGRAM_BUCKETS
	int "SNAPSHOT_HISTOGRAM_BUCKETS"
	range 1 32
	default 24
	help
	  How many buckets the snapshot's message-interval histogram has, each 8 bytes.
	  Bucket 0 holds intervals of 0 and 1 microsecond, bucket b the intervals from
	  2^b to 2^(b+1) - 1 microseconds, and the last bucket everything above it, so 24
	  buckets tell intervals up to about 8 seconds apart and 32 cover the whole range.
	  More buckets spread the tail of the distribution further out and make the
	  snapshot longer. At least 1 and at most 32.

config WZ_LIMIT_SUPERVISION_CHECKPOINTS
	int "SUPERVISION_CHECKPOINTS"
	range 1 64
	default 4
	help
	  How many checkpoints the node's supervisor watches. Each is a deadline an
	  application feeds, and the node is healthy only while every checkpoint that is
	  supervised has been fed in time. At least 1 and at most 64. The build's value
	  sizes the supervisor; a run-time document may only lower it.

config WZ_LIMIT_E2E_SUPERVISED_STREAMS
	int "E2E_SUPERVISED_STREAMS"
	default 32
	help
	  How many periodic streams one reception supervisor holds. The table of streams
	  is storage the application gives the supervisor when it makes it, one fixed row
	  per stream, so this bounds how many rows of it are used and sizes nothing; a
	  stream added past it is refused. At least 1. A run-time document may only lower
	  the build's value.

config WZ_LIMIT_APP_LINK_QUEUE_BYTES
	int "APP_LINK_QUEUE_BYTES"
	default 2050 if WZ_LIMITS_ZENOH_PICO
	default 262144
	help
	  The most bytes one link of a transport the program supplies queues in either
	  direction: what the program handed in and the session has not read, and what a
	  session that cannot wait handed over and the program has not taken. Past it the
	  program's bytes are refused with nothing taken, and the program is told when the
	  session has read the queue down to half. The link takes storage of the bound
	  when it opens, and a call that hands in more than the bound at once is refused.
	  Read only by a build with the app-transport capability.

config WZ_LIMIT_EVENT_RING_SLOTS
	int "EVENT_RING_SLOTS"
	range 1 1073741823
	default 64
	help
	  How many event records the node's event ring holds. When the ring is full,
	  the event-ring-full policy decides which record is lost: the oldest or the
	  newest. Each record is a few words, a fixed size, so the ring's memory is this
	  number times that size. At least 1.

config WZ_LIMIT_EVENT_RECORD_ARGS
	int "EVENT_RECORD_ARGS"
	range 0 255
	default 4
	help
	  How many integer arguments one event record carries, each 8 bytes. A record
	  has no text: the format an event is read with is a constant the reader holds,
	  and the arguments fill it. An event with more arguments than this keeps the
	  first of them. At most 255.

config WZ_LIMIT_CLOCK_SOURCES
	int "CLOCK_SOURCES"
	default 1
	help
	  How many clock sources an application can register with the node at once, when
	  the clock-source capability is on. A node reads its time from the registered
	  sources in the order they were registered, and the first that can say what time
	  it is answers; with none registered it reads the system clock. 0 registers
	  none, which leaves the system clock as the only source.

config WZ_LIMIT_E2E_SENDER_SLOTS
	int "E2E_SENDER_SLOTS"
	default 8
	help
	  How many senders one receiving judge of end-to-end protected frames keeps a
	  counter for, when the e2e-sender-demux capability is on. Each slot is one
	  sender, bound by a list or taken by the first intact frame of a sender in
	  arrival order; a frame of a sender no slot holds is not judged and is counted.
	  At least 1.

config WZ_LIMIT_REPLAY_DEPTH_MAX
	int "REPLAY_DEPTH_MAX"
	default 32
	help
	  The deepest replay a message may keep: how many of the frames it last sent, as
	  they were sent, a publisher holds for a subscriber that arrives later and asks
	  for them. Each message states its own depth, from 1 to this; a depth above it
	  is refused when the message is declared. At least 1.

config WZ_LIMIT_MESSAGE_CATALOG_ENTRIES
	int "MESSAGE_CATALOG_ENTRIES"
	default 64
	help
	  How many messages one message catalog declares, when the message-catalog
	  capability is on. A catalog that declares more is refused when it is read, and
	  the generator of a fixed-memory image refuses to write its tables. At least 1.
	  A run-time document may only lower the build's value.

config WZ_LIMIT_INSTANCE_KEY_FIELDS
	int "INSTANCE_KEY_FIELDS"
	default 2
	help
	  How many fields of a payload one message's instance key names, when the
	  instance-key capability is on. Each is an integer, an enumeration or a string
	  field read through the message's schema; the instance is the position of their
	  values in the product of the lists of values each may take. A description that
	  names more fields is refused. At least 1.

config WZ_LIMIT_INSTANCES_PER_MESSAGE
	int "INSTANCES_PER_MESSAGE"
	default 32
	help
	  How many instances one message's instance key may tell apart, when the
	  instance-key capability is on: the product of the lengths of the lists of
	  values its key fields may take. Each instance is a stream of the end-to-end
	  doors and a last value, so this bounds the state kept per message. A
	  description whose lists make more is refused. At least 1.

config WZ_LIMIT_CLOCK_MAX_FORWARD_STEP_MS
	int "CLOCK_MAX_FORWARD_STEP_MS"
	range 0 4294967295
	default 500
	help
	  How far ahead of the node's clock, in milliseconds, a timestamp from another
	  node may be before the node's hybrid logical clock refuses it, as zenoh's
	  UHLC_MAX_DELTA_MS. A refused timestamp is not taken into the clock, and the
	  data carrying it is stamped afresh or dropped as the timestamping settings say.
	  A host that sets the environment variable UHLC_MAX_DELTA_MS to a whole number of
	  milliseconds overrides this at start, as it does zenoh's own bound. A value
	  that is not a whole number of milliseconds, or one the build does not allow, is
	  refused by name: the open fails with that reason, where zenoh panics. 0
	  refuses any timestamp ahead of the clock.

config WZ_LIMIT_DECLARATION_SYNC_BURST_MESSAGES
	int "DECLARATION_SYNC_BURST_MESSAGES"
	range 1 4294967295
	default 8
	help
	  How many declarations one turn of a paced declaration replay sends, when the
	  declaration-sync-pacing policy is on. It is read only when that policy is on.
	  It must be at least 1: a turn that sends nothing would never finish.

config WZ_LIMIT_DECLARATION_SYNC_FINAL_TIMEOUT_MS
	int "DECLARATION_SYNC_FINAL_TIMEOUT_MS"
	range 1 4294967295
	default 1000
	help
	  How long, in milliseconds, a node waits for the peer's answer to an interest it
	  sent before it counts the interest as unanswered and goes on. It bounds the
	  wait of declarations_synced and wait_declarations_stable: a peer that never
	  answers an interest does not hold a node unsynced for ever. It is read whether
	  or not the declaration-sync-pacing policy is on, and must be at least 1.

config WZ_LIMIT_DECLARATION_SYNC_INTERVAL_MS
	int "DECLARATION_SYNC_INTERVAL_MS"
	range 1 4294967295
	default 10
	help
	  How long, in milliseconds, a paced declaration replay waits between two of its
	  turns, when the declaration-sync-pacing policy is on. The session keeps being
	  served during the wait. Waiting for the declarations to be stable steps by it
	  whether or not that policy is on. Must be at least 1.

config WZ_LIMIT_DECLARATION_SYNC_RX_NO_PROGRESS_MS
	int "DECLARATION_SYNC_RX_NO_PROGRESS_MS"
	range 0 4294967295
	default 0
	help
	  How long, in milliseconds, a session waits for the next of its peer's initial
	  declarations before it takes the declaration sync as cut short, when the
	  reliable-gap-reconnect policy is not off. From the session's establishment
	  until the peer's end of its initial declarations, a stretch this long with no
	  declaration from the peer ends the link as lost, and a reconnecting session
	  opens again and redoes the sync, as for a gap on the reliable channel. Each
	  declaration the peer sends starts the stretch again. 0 keeps no such watch, as
	  upstream keeps none. Only the tokio engine reads it, since only it notes the
	  end of the peer's declarations.

config WZ_LIMIT_DECLARATION_SYNC_RETRY_INTERVAL_MS
	int "DECLARATION_SYNC_RETRY_INTERVAL_MS"
	range 0 4294967295
	default 0
	help
	  How long, in milliseconds, a paced declaration replay waits before it tries
	  again a turn the link did not take for want of room, when the
	  declaration-sync-pacing policy is on. The wait is its own and not
	  DECLARATION_SYNC_INTERVAL_MS, and the turn starts again at the declaration the
	  link refused. 0 tries nothing again: a refused turn ends the replay and the
	  link, and a reconnecting session replays again on the next one, as before this
	  limit. The tokio engine, the cooperative engine and the fixed-memory slot
	  client read it alike.

config WZ_LIMIT_DECLARATION_SYNC_TX_NO_PROGRESS_MS
	int "DECLARATION_SYNC_TX_NO_PROGRESS_MS"
	range 0 4294967295
	default 0
	help
	  How long, in milliseconds, a paced declaration replay that retries refused
	  turns (DECLARATION_SYNC_RETRY_INTERVAL_MS not 0) goes on with no declaration
	  sent before it gives up, which ends the link as a refused turn does without
	  retries. Each declaration sent starts the stretch again. 0 gives up only when
	  the link itself ends. The tokio engine, the cooperative engine and the
	  fixed-memory slot client read it alike.

config WZ_LIMIT_PICO_UNICAST_BATCH_BYTES
	int "PICO_UNICAST_BATCH_BYTES"
	range 1 65535
	default 2048
	help
	  The batch size, in bytes, a session of the zenoh-pico interface advertises when
	  it opens a unicast session, as zenoh-pico's BATCH_UNICAST_SIZE. The two sides
	  send frames no larger than the smaller of the two sizes. At least 1 and at most
	  65535: a batch of no byte carries no frame. A build's value is bounded by its
	  delivery lane: DELIVERY_LANE_BYTES holds the larger of this and
	  PICO_FRAG_MAX_BYTES, with MAX_KEYEXPR_BYTES, 16 bytes of a timestamp's clock id
	  and 4 bytes for each of the larger of MAX_SUBSCRIPTIONS and
	  MAX_LIVELINESS_SUBSCRIPTIONS, as the cooperative engine's build asserts; a build
	  that raises this raises DELIVERY_LANE_BYTES with it. A build whose engine lends
	  each link's buffers from the session's memory when it opens holds a stated value
	  to the build's own: a session may lower it, never raise it.

config WZ_LIMIT_PICO_MULTICAST_BATCH_BYTES
	int "PICO_MULTICAST_BATCH_BYTES"
	range 1 65535
	default 2048
	help
	  The batch size, in bytes, a session of the zenoh-pico interface advertises in
	  the Join of a multicast group, as zenoh-pico's BATCH_MULTICAST_SIZE. zenoh-pico
	  refuses a member whose Join states another size, so every member of a group
	  states the same. At least 1 and at most 65535.

config WZ_LIMIT_PICO_LEASE_MS
	int "PICO_LEASE_MS"
	range 1 4294967295
	default 10000
	help
	  The lease, in milliseconds, a session of the zenoh-pico interface advertises,
	  unicast and in a multicast group's Join, as zenoh-pico's Z_TRANSPORT_LEASE. A
	  peer that hears nothing from the session for this long closes it.

config WZ_LIMIT_PICO_SOCKET_TIMEOUT_MS
	int "PICO_SOCKET_TIMEOUT_MS"
	range 0 4294967295
	default 100
	help
	  How long, in milliseconds, one read step of the cooperative zenoh-pico session
	  waits on its link before it returns with nothing, as zenoh-pico's
	  Z_CONFIG_SOCKET_TIMEOUT. The tokio engine has no such wait: its read is woken
	  by what arrives.

config WZ_LIMIT_PICO_CONNECT_TIMEOUT_MS
	int "PICO_CONNECT_TIMEOUT_MS"
	range 1 4294967295
	default 10000
	help
	  How long, in milliseconds, each open of an endpoint by a zenoh-pico session
	  waits for the dial and the handshake before it fails, on either engine, as
	  zenoh-pico's Z_TRANSPORT_CONNECT_TIMEOUT.

config WZ_LIMIT_PICO_FRAG_MAX_BYTES
	int "PICO_FRAG_MAX_BYTES"
	default 4096
	help
	  The largest message, in bytes, a session of the zenoh-pico interface rejoins
	  from fragments, unicast and in a multicast group, as zenoh-pico's
	  FRAG_MAX_SIZE. A fragment that would take its message past it ends the chain
	  and the message is dropped; a message that arrives in one frame is never
	  measured against it.

config WZ_LIMIT_PICO_ACCEPT_TIMEOUT_MS
	int "PICO_ACCEPT_TIMEOUT_MS"
	range 1 4294967295
	default 1000
	help
	  How long, in milliseconds, a listening session of the zenoh-pico interface gives
	  an inbound link to complete its whole handshake, link handshake included,
	  before it drops the link without a word, as zenoh-pico's
	  Z_TRANSPORT_ACCEPT_TIMEOUT. zenoh's own bound is ten seconds; the zenoh-c
	  interface reads it from transport/unicast/accept_timeout.

config WZ_LIMIT_PICO_KEEPALIVES_PER_LEASE
	int "PICO_KEEPALIVES_PER_LEASE"
	range 1 4294967295
	default 3
	help
	  How many keepalives a session of the zenoh-pico interface sends in one lease,
	  as zenoh-pico's Z_TRANSPORT_LEASE_EXPIRE_FACTOR: whenever the line has been
	  idle for the adopted lease divided by this, the session sends one. At least 1.
	  The lease is the smaller of the two the peers advertised.

endmenu
